{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"كتاب الطهارة"}}},"hadiths":[{"hadithnumber":125,"arabicnumber":125,"text":"حَدَّثَنَا مَحْمُودُ بْنُ خَالِدٍ، حَدَّثَنَا الْوَلِيدُ، بِهَذَا الإِسْنَادِ قَالَ فَتَوَضَّأَ ثَلاَثًا ثَلاَثًا وَغَسَلَ رِجْلَيْهِ بِغَيْرِ عَدَدٍ ‏.‏","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":1,"hadith":125}}]}