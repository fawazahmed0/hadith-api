{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"كتاب الطهارة"}}},"hadiths":[{"hadithnumber":127,"arabicnumber":127,"text":"حَدَّثَنَا إِسْحَاقُ بْنُ إِسْمَاعِيلَ، حَدَّثَنَا سُفْيَانُ، عَنِ ابْنِ عَقِيلٍ، بِهَذَا الْحَدِيثِ يُغَيِّرُ بَعْضَ مَعَانِي بِشْرٍ قَالَ فِيهِ وَتَمَضْمَضَ وَاسْتَنْثَرَ ثَلاَثًا ‏.‏","grades":[{"name":"Al-Albani","grade":"Shadh"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Shadh"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":1,"hadith":127}}]}