{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"14":"Fasting (Kitab Al-Siyam)"},"section_detail":{"14":{"hadithnumber_first":2313,"hadithnumber_last":2476,"arabicnumber_first":2313,"arabicnumber_last":2476,"name_native":"كتاب الصيام"}}},"hadiths":[{"hadithnumber":2439,"arabicnumber":2439,"text":"حَدَّثَنَا مُسَدَّدٌ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنِ الأَعْمَشِ، عَنْ إِبْرَاهِيمَ، عَنِ الأَسْوَدِ، عَنْ عَائِشَةَ، قَالَتْ مَا رَأَيْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم صَائِمًا الْعَشْرَ قَطُّ ‏.‏","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1176)"}],"reference":{"book":14,"hadith":127}}]}