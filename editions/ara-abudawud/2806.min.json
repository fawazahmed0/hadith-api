{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"16":"Sacrifice (Kitab Al-Dahaya)"},"section_detail":{"16":{"hadithnumber_first":2788,"hadithnumber_last":2843,"arabicnumber_first":2788,"arabicnumber_last":2843,"name_native":"كتاب الأضاحي"}}},"hadiths":[{"hadithnumber":2806,"arabicnumber":2806,"text":"حَدَّثَنَا مُسَدَّدٌ، حَدَّثَنَا يَحْيَى، حَدَّثَنَا هِشَامٌ، عَنْ قَتَادَةَ، قَالَ قُلْتُ لِسَعِيدِ بْنِ الْمُسَيَّبِ مَا الأَعْضَبُ قَالَ النِّصْفُ فَمَا فَوْقَهُ ‏.‏","grades":[{"name":"Al-Albani","grade":"Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Maqtu"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":16,"hadith":19}}]}