{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"23":"Commercial Transactions (Kitab Al-Buyu)"},"section_detail":{"23":{"hadithnumber_first":3326,"hadithnumber_last":3415,"arabicnumber_first":3326,"arabicnumber_last":3415,"name_native":"كتاب البيو"}}},"hadiths":[{"hadithnumber":3380,"arabicnumber":3380,"text":"حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، عَنْ مَالِكٍ، عَنْ نَافِعٍ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم نَهَى عَنْ بَيْعِ حَبَلِ الْحَبَلَةِ ‏.‏","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (2143) Sahih Muslim (1514)"}],"reference":{"book":23,"hadith":55}}]}