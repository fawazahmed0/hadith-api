{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"27":"Drinks (Kitab Al-Ashribah)"},"section_detail":{"27":{"hadithnumber_first":3669,"hadithnumber_last":3735,"arabicnumber_first":3669,"arabicnumber_last":3735,"name_native":"كتاب الأشربة"}}},"hadiths":[{"hadithnumber":3701,"arabicnumber":3701,"text":"حَدَّثَنَا الْحَسَنُ، - يَعْنِي ابْنَ عَلِيٍّ - حَدَّثَنَا يَحْيَى بْنُ آدَمَ، حَدَّثَنَا شَرِيكٌ، بِإِسْنَادِهِ قَالَ ‏ \"‏ اجْتَنِبُوا مَا أَسْكَرَ ‏\"‏ ‏.‏","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":27,"hadith":33}}]}