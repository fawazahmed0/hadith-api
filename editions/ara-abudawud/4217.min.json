{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"36":"Signet-Rings (Kitab Al-Khatam)"},"section_detail":{"36":{"hadithnumber_first":4214,"hadithnumber_last":4239,"arabicnumber_first":4214,"arabicnumber_last":4239,"name_native":"كتاب الختم"}}},"hadiths":[{"hadithnumber":4217,"arabicnumber":4217,"text":"حَدَّثَنَا أَحْمَدُ بْنُ يُونُسَ، حَدَّثَنَا زُهَيْرٌ، حَدَّثَنَا حُمَيْدٌ الطَّوِيلُ، عَنْ أَنَسِ بْنِ مَالِكٍ، قَالَ كَانَ خَاتَمُ النَّبِيِّ صلى الله عليه وسلم مِنْ فِضَّةٍ كُلُّهُ فَصُّهُ مِنْهُ ‏.‏","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":36,"hadith":4}}]}