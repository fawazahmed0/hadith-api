{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"37":"Trials and Fierce Battles (Kitab Al-Fitan Wa Al-Malahim)"},"section_detail":{"37":{"hadithnumber_first":4240,"hadithnumber_last":4278,"arabicnumber_first":4240,"arabicnumber_last":4278,"name_native":"كتاب الفتن والملاحم"}}},"hadiths":[{"hadithnumber":4251,"arabicnumber":4251,"text":"حَدَّثَنَا أَحْمَدُ بْنُ صَالِحٍ، عَنْ عَنْبَسَةَ، عَنْ يُونُسَ، عَنِ الزُّهْرِيِّ، قَالَ وَسَلاَحُ قَرِيبٌ مِنْ خَيْبَرَ ‏.‏","grades":[{"name":"Al-Albani","grade":"Sahih Isnaad Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":37,"hadith":12}}]}