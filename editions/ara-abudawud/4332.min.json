{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"39":"Battles (Kitab Al-Malahim)"},"section_detail":{"39":{"hadithnumber_first":4291,"hadithnumber_last":4350,"arabicnumber_first":4291,"arabicnumber_last":4350,"name_native":"كتاب الملاحم"}}},"hadiths":[{"hadithnumber":4332,"arabicnumber":4332,"text":"حَدَّثَنَا أَحْمَدُ بْنُ إِبْرَاهِيمَ، حَدَّثَنَا عُبَيْدُ اللَّهِ، - يَعْنِي ابْنَ مُوسَى - حَدَّثَنَا شَيْبَانُ، عَنِ الأَعْمَشِ، عَنْ سَالِمٍ، عَنْ جَابِرٍ، قَالَ فَقَدْنَا ابْنَ صَيَّادٍ يَوْمَ الْحَرَّةِ ‏.‏","grades":[{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":39,"hadith":42}}]}