{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"كتاب الآداب"}}},"hadiths":[{"hadithnumber":5001,"arabicnumber":5001,"text":"حَدَّثَنَا صَفْوَانُ بْنُ صَالِحٍ، حَدَّثَنَا الْوَلِيدُ، حَدَّثَنَا عُثْمَانُ بْنُ أَبِي الْعَاتِكَةِ، قَالَ إِنَّمَا قَالَ أَدْخُلُ كُلِّي ‏.‏ مِنْ صِغَرِ الْقُبَّةِ ‏.‏","grades":[{"name":"Al-Albani","grade":"Daif Isnaad Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":43,"hadith":229}}]}