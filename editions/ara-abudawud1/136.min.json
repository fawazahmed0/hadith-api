{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"كتاب الطهارة"}}},"hadiths":[{"hadithnumber":136,"arabicnumber":136,"text":"حدثنا محمد بن العلاء، حدثنا زيد، - يعني ابن الحباب - حدثنا عبد الرحمن بن ثوبان، حدثنا عبد الله بن الفضل الهاشمي، عن الاعرج، عن ابي هريرة، ان النبي صلى الله عليه وسلم توضا مرتين مرتين","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":1,"hadith":136}}]}