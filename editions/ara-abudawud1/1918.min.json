{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"11":"The Rites of Hajj (Kitab Al-Manasik Wa'l-Hajj)"},"section_detail":{"11":{"hadithnumber_first":1721,"hadithnumber_last":2045,"arabicnumber_first":1721,"arabicnumber_last":2045,"name_native":"كتاب المناسك والحج"}}},"hadiths":[{"hadithnumber":1918,"arabicnumber":1918,"text":"حدثنا عباس بن عبد العظيم، حدثنا عثمان بن عمر، حدثنا عبد المجيد ابو عمرو، عن العداء، بمعناه","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":11,"hadith":198}}]}