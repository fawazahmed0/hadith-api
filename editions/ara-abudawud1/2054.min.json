{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"كتاب النكاح"}}},"hadiths":[{"hadithnumber":2054,"arabicnumber":2054,"text":"حدثنا عمرو بن عون، اخبرنا ابو عوانة، عن قتادة، وعبد العزيز بن صهيب، عن انس بن مالك، ان النبي صلى الله عليه وسلم اعتق صفية وجعل عتقها صداقها","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (947) Sahih Muslim (1365 After  1427)"}],"reference":{"book":12,"hadith":9}}]}