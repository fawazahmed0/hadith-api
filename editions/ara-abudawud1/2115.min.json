{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"كتاب النكاح"}}},"hadiths":[{"hadithnumber":2115,"arabicnumber":2115,"text":"حدثنا عثمان بن ابي شيبة، حدثنا يزيد بن هارون، وابن، مهدي عن سفيان، عن منصور، عن ابراهيم، عن علقمة، عن عبد الله، وساق، عثمان مثله","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":12,"hadith":70}}]}