{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"كتاب النكاح"}}},"hadiths":[{"hadithnumber":2148,"arabicnumber":2148,"text":"حدثنا محمد بن كثير، اخبرنا سفيان، حدثني يونس بن عبيد، عن عمرو بن سعيد، عن ابي زرعة، عن جرير، قال سالت رسول الله صلى الله عليه وسلم عن نظرة الفجاة فقال \" اصرف بصرك","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (2159)"}],"reference":{"book":12,"hadith":103}}]}