{"metadata":{"name":"Sunan Abu Dawud","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"كتاب الطلاق"}}},"hadiths":[{"hadithnumber":2224,"arabicnumber":2224,"text":"حدثنا ابو كامل، ان عبد العزيز بن المختار، حدثهم حدثنا خالد، حدثني محدث، عن عكرمة، عن النبي صلى الله عليه وسلم بنحو حديث سفيان","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":13,"hadith":50}}]}