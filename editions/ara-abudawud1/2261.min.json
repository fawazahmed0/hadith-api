{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"كتاب الطلاق"}}},"hadiths":[{"hadithnumber":2261,"arabicnumber":2261,"text":"حدثنا الحسن بن علي، حدثنا عبد الرزاق، اخبرنا معمر، عن الزهري، باسناده ومعناه قال وهو حينيذ يعرض بان ينفيه","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1500)"}],"reference":{"book":13,"hadith":87}}]}