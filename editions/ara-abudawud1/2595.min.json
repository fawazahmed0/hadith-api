{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"كتاب الجهاد"}}},"hadiths":[{"hadithnumber":2595,"arabicnumber":2595,"text":"حدثنا سعيد بن منصور، حدثنا يزيد بن هارون، عن الحجاج، عن قتادة، عن الحسن، عن سمرة بن جندب، قال كان شعار المهاجرين عبد الله وشعار الانصار عبد الرحمن","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":15,"hadith":119}}]}