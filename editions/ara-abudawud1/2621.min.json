{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"كتاب الجهاد"}}},"hadiths":[{"hadithnumber":2621,"arabicnumber":2621,"text":"حدثني محمد بن بشار، حدثنا محمد بن جعفر، عن شعبة، عن ابي بشر، قال سمعت عباد بن شرحبيل، - رجلا منا من بني غبر - بمعناه","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":15,"hadith":145}}]}