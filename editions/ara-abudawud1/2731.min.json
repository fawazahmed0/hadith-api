{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"كتاب الجهاد"}}},"hadiths":[{"hadithnumber":2731,"arabicnumber":2731,"text":"حدثنا سعيد بن منصور، حدثنا ابو معاوية، عن الاعمش، عن ابي سفيان، عن جابر، قال كنت اميح اصحابي الماء يوم بدر","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":15,"hadith":255}}]}