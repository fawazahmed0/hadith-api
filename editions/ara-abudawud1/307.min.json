{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"كتاب الطهارة"}}},"hadiths":[{"hadithnumber":307,"arabicnumber":307,"text":"حدثنا موسى بن اسماعيل، اخبرنا حماد، عن قتادة، عن ام الهذيل، عن ام عطية، وكانت، بايعت النبي صلى الله عليه وسلم قالت كنا لا نعد الكدرة والصفرة بعد الطهر شييا","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":1,"hadith":307}}]}