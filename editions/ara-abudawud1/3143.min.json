{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"كتاب الجنائز"}}},"hadiths":[{"hadithnumber":3143,"arabicnumber":3143,"text":"حدثنا احمد بن عبدة، وابو كامل - بمعنى الاسناد - ان يزيد بن زريع، حدثهم حدثنا ايوب، عن محمد بن سيرين، عن حفصة، اخته عن ام عطية، قالت مشطناها ثلاثة قرون","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (939)"}],"reference":{"book":21,"hadith":55}}]}