{"metadata":{"name":"Sunan Abu Dawud","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"كتاب الجنائز"}}},"hadiths":[{"hadithnumber":3217,"arabicnumber":3217,"text":"حدثنا موسى بن اسماعيل، حدثنا جرير، حدثنا حميد، - يعني ابن هلال - عن سعد بن هشام بن عامر، بهذا الحديث","grades":[{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":21,"hadith":129}}]}