{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"كتاب الإجارة"}}},"hadiths":[{"hadithnumber":3491,"arabicnumber":3491,"text":"حدثنا عثمان بن ابي شيبة، حدثنا ابو معاوية، عن الاعمش، باسناده ومعناه قال الايات الاواخر في الربا","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1580)"}],"reference":{"book":24,"hadith":76}}]}