{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"كتاب الإجارة"}}},"hadiths":[{"hadithnumber":3564,"arabicnumber":3564,"text":"حدثنا مسدد، حدثنا ابو الاحوص، حدثنا عبد العزيز بن رفيع، عن عطاء، عن ناس، من ال صفوان قال استعار النبي صلى الله عليه وسلم فذكر معناه","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":24,"hadith":149}}]}