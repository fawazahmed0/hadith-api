{"metadata":{"name":"Sunan Abu Dawud","section":{"34":"Clothing (Kitab Al-Libas)"},"section_detail":{"34":{"hadithnumber_first":4020,"hadithnumber_last":4158,"arabicnumber_first":4020,"arabicnumber_last":4158,"name_native":"كتاب اللباس"}}},"hadiths":[{"hadithnumber":4067,"arabicnumber":4067,"text":"حدثنا عمرو بن عثمان الحمصي، حدثنا الوليد، قال قال هشام - يعني ابن الغاز - المضرجة التي ليست بمشبعة ولا الموردة","grades":[{"name":"Al-Albani","grade":"Sahih Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Maqtu"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":34,"hadith":48}}]}