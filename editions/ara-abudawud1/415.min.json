{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن أبي داود","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"كتاب الصلاة"}}},"hadiths":[{"hadithnumber":415,"arabicnumber":415,"text":"حدثنا محمود بن خالد، حدثنا الوليد، قال قال ابو عمرو يعني الاوزاعي وذلك ان ترى، ما على الارض من الشمس صفراء","grades":[{"name":"Al-Albani","grade":"Daif Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Maqtu"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":2,"hadith":25}}]}