{"metadata":{"name":"Sunan Abu Dawud","section":{"40":"Prescribed Punishments (Kitab Al-Hudud)"},"section_detail":{"40":{"hadithnumber_first":4351,"hadithnumber_last":4493,"arabicnumber_first":4351,"arabicnumber_last":4493,"name_native":"كتاب الحدود"}}},"hadiths":[{"hadithnumber":4365,"arabicnumber":4365,"text":"حدثنا موسى بن اسماعيل، حدثنا وهيب، عن ايوب، باسناده بهذا الحديث قال فيه فامر بمسامير فاحميت فكحلهم وقطع ايديهم وارجلهم وما حسمهم","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":40,"hadith":15}}]}