{"metadata":{"name":"Sahih al Bukhari","name_native":"صحيح البخاري","section":{"30":"Fasting"},"section_detail":{"30":{"hadithnumber_first":1891,"hadithnumber_last":2007,"arabicnumber_first":1891,"arabicnumber_last":2007,"name_native":"كتاب الصيام"}}},"hadiths":[{"hadithnumber":1939,"arabicnumber":1939,"text":"حدثنا ابو معمر، حدثنا عبد الوارث، حدثنا ايوب، عن عكرمة، عن ابن عباس رضى الله عنهما قال احتجم النبي صلى الله عليه وسلم وهو صايم","grades":[],"reference":{"book":30,"hadith":46}}]}