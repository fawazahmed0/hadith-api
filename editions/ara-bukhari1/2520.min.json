{"metadata":{"name":"Sahih al Bukhari","name_native":"صحيح البخاري","section":{"49":"Manumission of Slaves"},"section_detail":{"49":{"hadithnumber_first":2517,"hadithnumber_last":2559,"arabicnumber_first":2517,"arabicnumber_last":2559,"name_native":"إعتاق العبيد"}}},"hadiths":[{"hadithnumber":2520,"arabicnumber":2520,"text":"حدثنا محمد بن ابي بكر، حدثنا عثام، حدثنا هشام، عن فاطمة بنت المنذر، عن اسماء بنت ابي بكر رضى الله عنهما قالت كنا نومر عند الخسوف بالعتاقة","grades":[],"reference":{"book":49,"hadith":4}}]}