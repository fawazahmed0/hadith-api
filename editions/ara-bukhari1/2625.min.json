{"metadata":{"name":"Sahih al Bukhari","name_native":"صحيح البخاري","section":{"51":"Gifts"},"section_detail":{"51":{"hadithnumber_first":2566,"hadithnumber_last":2636,"arabicnumber_first":2566,"arabicnumber_last":2636,"name_native":"الهدايا"}}},"hadiths":[{"hadithnumber":2625,"arabicnumber":2625,"text":"حدثنا ابو نعيم، حدثنا شيبان، عن يحيى، عن ابي سلمة، عن جابر رضى الله عنه قال قضى النبي صلى الله عليه وسلم بالعمرى انها لمن وهبت له","grades":[],"reference":{"book":51,"hadith":57}}]}