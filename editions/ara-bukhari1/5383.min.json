{"metadata":{"name":"Sahih al Bukhari","name_native":"صحيح البخاري","section":{"70":"Food, Meals"},"section_detail":{"70":{"hadithnumber_first":5373,"hadithnumber_last":5466,"arabicnumber_first":5373,"arabicnumber_last":5466,"name_native":"الغذاء، الوجبات"}}},"hadiths":[{"hadithnumber":5383,"arabicnumber":5383,"text":"حدثنا مسلم، حدثنا وهيب، حدثنا منصور، عن امه، عن عايشة رضى الله عنها توفي النبي صلى الله عليه وسلم حين شبعنا من الاسودين التمر والماء","grades":[],"reference":{"book":70,"hadith":11}}]}