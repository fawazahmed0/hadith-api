{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجه","section":{"10":"The Chapters on Divorce"},"section_detail":{"10":{"hadithnumber_first":2016,"hadithnumber_last":2477,"arabicnumber_first":2016,"arabicnumber_last":2477,"name_native":"كتاب الطلاق"}}},"hadiths":[{"hadithnumber":2077,"arabicnumber":2077,"text":"حَدَّثَنَا عَلِيُّ بْنُ مُحَمَّدٍ، حَدَّثَنَا وَكِيعٌ، عَنْ سُفْيَانَ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاهِيمَ، عَنِ الأَسْوَدِ، عَنْ عَائِشَةَ، قَالَتْ أُمِرَتْ بَرِيرَةُ أَنْ تَعْتَدَّ، بِثَلاَثِ حِيَضٍ ‏.‏","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":10,"hadith":62}}]}