{"metadata":{"name":"Sunan Ibn Majah","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"أبواب المعاملات التجارية"}}},"hadiths":[{"hadithnumber":2192,"arabicnumber":2192,"text":"حَدَّثَنَا هِشَامُ بْنُ عَمَّارٍ، حَدَّثَنَا مَالِكُ بْنُ أَنَسٍ، قَالَ بَلَغَنِي عَنْ عَمْرِو بْنِ شُعَيْبٍ، عَنْ أَبِيهِ، عَنْ جَدِّهِ، أَنَّ النَّبِيَّ ـ صلى الله عليه وسلم ـ نَهَى عَنْ بَيْعِ الْعُرْبَانِ ‏.‏","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":12,"hadith":56}}]}