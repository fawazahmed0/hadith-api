{"metadata":{"name":"Sunan Ibn Majah","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":"فصول في الغذاء"}}},"hadiths":[{"hadithnumber":3302,"arabicnumber":3302,"text":"حَدَّثَنَا أَحْمَدُ بْنُ مَنِيعٍ، أَنْبَأَنَا عَبِيدَةُ بْنُ حُمَيْدٍ، عَنْ حُمَيْدٍ، عَنْ أَنَسٍ، قَالَ كَانَ النَّبِيُّ ـ صلى الله عليه وسلم ـ يُحِبُّ الْقَرْعَ ‏.‏","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":29,"hadith":52}}]}