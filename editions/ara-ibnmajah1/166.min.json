{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجه","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"كتاب السنة"}}},"hadiths":[{"hadithnumber":166,"arabicnumber":166,"text":"حدثنا محمد بن المثنى، وابو بكر بن خلاد الباهلي قالا حدثنا عبد الوهاب، حدثنا خالد الحذاء، عن عكرمة، عن ابن عباس، قال ضمني رسول الله صلى الله عليه وسلم اليه وقال \" اللهم علمه الحكمة وتاويل الكتاب","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":0,"hadith":166}}]}