{"metadata":{"name":"Sunan Ibn Majah","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"كتاب الصيام"}}},"hadiths":[{"hadithnumber":1665,"arabicnumber":1665,"text":"حدثنا محمد بن المصفى الحمصي، حدثنا محمد بن حرب، عن عبيد الله بن عمر، عن نافع، عن ابن عمر، قال: قال رسول الله صلى الله عليه وسلم \" ليس من البر الصيام في السفر","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":7,"hadith":28}}]}