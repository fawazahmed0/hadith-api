{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجه","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"أبواب المعاملات التجارية"}}},"hadiths":[{"hadithnumber":2179,"arabicnumber":2179,"text":"حدثنا عثمان بن ابي شيبة، حدثنا عبدة بن سليمان، عن عبيد الله بن عمر، عن نافع، عن ابن عمر، قال نهى رسول الله صلى الله عليه وسلم عن تلقي الجلب","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":12,"hadith":43}}]}