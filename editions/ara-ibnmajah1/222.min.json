{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجه","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"كتاب السنة"}}},"hadiths":[{"hadithnumber":222,"arabicnumber":222,"text":"حدثنا هشام بن عمار، حدثنا الوليد بن مسلم، حدثنا روح بن جناح ابو سعد، عن مجاهد، عن ابن عباس، قال قال رسول الله صلى الله عليه وسلم \" فقيه واحد اشد على الشيطان من الف عابد","grades":[{"name":"Al-Albani","grade":"Mawdu"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Mawdu"},{"name":"Shuaib Al Arnaut","grade":"Very Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":0,"hadith":222}}]}