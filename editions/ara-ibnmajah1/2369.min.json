{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجه","section":{"13":"The Chapters on Rulings"},"section_detail":{"13":{"hadithnumber_first":2308,"hadithnumber_last":2374,"arabicnumber_first":2308,"arabicnumber_last":2374,"name_native":"أبواب الأحكام"}}},"hadiths":[{"hadithnumber":2369,"arabicnumber":2369,"text":"حدثنا محمد بن بشار، حدثنا عبد الوهاب، حدثنا جعفر بن محمد، عن ابيه، عن جابر، ان النبي صلى الله عليه وسلم قضى باليمين مع الشاهد","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":13,"hadith":62}}]}