{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجه","section":{"24":"The Chapters on Jihad"},"section_detail":{"24":{"hadithnumber_first":2753,"hadithnumber_last":2881,"arabicnumber_first":2753,"arabicnumber_last":2881,"name_native":"كتاب الجهاد"}}},"hadiths":[{"hadithnumber":2805,"arabicnumber":2805,"text":"حدثنا هشام بن عمار، وسويد بن سعيد، قالا حدثنا مالك بن انس، حدثني الزهري، عن انس بن مالك، ان النبي صلى الله عليه وسلم دخل مكة يوم الفتح وعلى راسه المغفر","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":24,"hadith":53}}]}