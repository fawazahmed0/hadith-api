{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجه","section":{"26":"Chapters on Sacrifices"},"section_detail":{"26":{"hadithnumber_first":3120,"hadithnumber_last":3161,"arabicnumber_first":3120,"arabicnumber_last":3161,"name_native":"كتاب الأضاحي"}}},"hadiths":[{"hadithnumber":3131,"arabicnumber":3131,"text":"حدثنا هدية بن عبد الوهاب، انبانا الفضل بن موسى، انبانا الحسين بن واقد، عن علباء بن احمر، عن عكرمة، عن ابن عباس، قال كنا مع رسول الله صلى الله عليه وسلم في سفر فحضر الاضحى فاشتركنا في الجزور عن عشرة والبقرة عن سبعة","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":26,"hadith":12}}]}