{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجه","section":{"27":"Chapters on Slaughtering"},"section_detail":{"27":{"hadithnumber_first":3162,"hadithnumber_last":3199,"arabicnumber_first":3162,"arabicnumber_last":3199,"name_native":"فصول في الذبح"}}},"hadiths":[{"hadithnumber":3186,"arabicnumber":3186,"text":"حدثنا علي بن محمد، حدثنا وكيع، عن شعبة، عن هشام بن زيد بن انس بن مالك، عن انس بن مالك، قال نهى رسول الله صلى الله عليه وسلم عن صبر البهايم","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":27,"hadith":25}}]}