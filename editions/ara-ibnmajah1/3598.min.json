{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجه","section":{"32":"Chapters on Dress"},"section_detail":{"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656,"name_native":"كتاب اللباس"}}},"hadiths":[{"hadithnumber":3598,"arabicnumber":3598,"text":"حدثنا ابو بكر، حدثنا عيسى بن يونس، عن معمر، عن الزهري، عن انس، قال رايت على زينب بنت رسول الله صلى الله عليه وسلم قميص حرير سيراء","grades":[{"name":"Al-Albani","grade":"Shadh"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Shadh"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":32,"hadith":49}}]}