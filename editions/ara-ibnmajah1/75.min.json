{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجه","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"كتاب السنة"}}},"hadiths":[{"hadithnumber":75,"arabicnumber":75,"text":"حدثنا ابو عثمان البخاري، حدثنا الهيثم، حدثنا اسماعيل، عن جرير بن عثمان، عن الحارث، - اظنه - عن مجاهد، عن ابي الدرداء، قال الايمان يزداد وينقص","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":0,"hadith":75}}]}