{"metadata":{"name":"Muwatta Malik","name_native":"موطأ الإمام مالك","section":{"25":"Game"},"section_detail":{"25":{"hadithnumber_first":1052,"hadithnumber_last":1066,"arabicnumber_first":1052,"arabicnumber_last":1066,"name_native":"كتاب الصيد"}}},"hadiths":[{"hadithnumber":1053,"arabicnumber":1053,"text":"وَحَدَّثَنِي عَنْ مَالِكٍ، أَنَّهُ بَلَغَهُ أَنَّ الْقَاسِمَ بْنَ مُحَمَّدٍ، كَانَ يَكْرَهُ مَا قَتَلَ الْمِعْرَاضُ وَالْبُنْدُقَةُ ‏.‏","grades":[{"name":"Salim al-Hilali","grade":"Maqtu Daif"}],"reference":{"book":25,"hadith":2}}]}