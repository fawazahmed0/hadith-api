{"metadata":{"name":"Muwatta Malik","section":{"31":"Business Transactions"},"section_detail":{"31":{"hadithnumber_first":1290,"hadithnumber_last":1385,"arabicnumber_first":1290,"arabicnumber_last":1385,"name_native":"المعاملات التجارية"}}},"hadiths":[{"hadithnumber":1353,"arabicnumber":1353,"text":"حَدَّثَنِي يَحْيَى، عَنْ مَالِكٍ، عَنْ زَيْدِ بْنِ أَسْلَمَ، عَنْ سَعِيدِ بْنِ الْمُسَيَّبِ، أَنَّ رَسُولَ اللَّهِ","grades":[{"name":"Salim al-Hilali","grade":"Hasan Lighairihi"}],"reference":{"book":31,"hadith":15}}]}