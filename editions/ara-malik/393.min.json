{"metadata":{"name":"Muwatta Malik","name_native":"موطأ الإمام مالك","section":{"9":"Shortening the Prayer"},"section_detail":{"9":{"hadithnumber_first":326,"hadithnumber_last":427,"arabicnumber_first":326,"arabicnumber_last":427,"name_native":"كتاب الصلاة"}}},"hadiths":[{"hadithnumber":393,"arabicnumber":393,"text":"وَحَدَّثَنِي عَنْ مَالِكٍ، عَنْ نَافِعٍ، أَنَّ ابْنَ عُمَرَ، لَمْ يَكُنْ يَلْتَفِتُ فِي صَلاَتِهِ ‏.‏","grades":[{"name":"Salim al-Hilali","grade":"Mauquf Sahih"}],"reference":{"book":9,"hadith":68}}]}