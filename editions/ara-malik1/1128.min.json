{"metadata":{"name":"Muwatta Malik","name_native":"موطأ الإمام مالك","section":{"28":"Marriage"},"section_detail":{"28":{"hadithnumber_first":1091,"hadithnumber_last":1149,"arabicnumber_first":1091,"arabicnumber_last":1149,"name_native":"كتاب النكاح"}}},"hadiths":[{"hadithnumber":1128,"arabicnumber":1128,"text":"وحدثني عن مالك، عن عبد الرحمن بن المجبر، انه قال وهب سالم بن عبد الله لابنه جارية قال لا تقربها فاني قد اردتها فلم انشط اليها","grades":[{"name":"Salim al-Hilali","grade":"Maqtu Sahih"}],"reference":{"book":28,"hadith":38}}]}