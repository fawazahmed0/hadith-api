{"metadata":{"name":"Muwatta Malik","section":{"29":"Divorce"},"section_detail":{"29":{"hadithnumber_first":1150,"hadithnumber_last":1271,"arabicnumber_first":1150,"arabicnumber_last":1271,"name_native":"كتاب الطلاق"}}},"hadiths":[{"hadithnumber":1271,"arabicnumber":1271,"text":"وحدثني عن مالك، انه بلغه ان ام سلمة، زوج النبي صلى الله عليه وسلم كانت تقول تجمع الحاد راسها بالسدر والزيت","grades":[{"name":"Salim al-Hilali","grade":"Mauquf Daif"}],"reference":{"book":29,"hadith":68}}]}