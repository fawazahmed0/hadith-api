{"metadata":{"name":"Muwatta Malik","section":{"32":"Qirad"},"section_detail":{"32":{"hadithnumber_first":1386,"hadithnumber_last":1387,"arabicnumber_first":1386,"arabicnumber_last":1387,"name_native":"قراد"}}},"hadiths":[{"hadithnumber":1387,"arabicnumber":1387,"text":"وحدثني مالك، عن العلاء بن عبد الرحمن، عن ابيه، عن جده، ان عثمان بن عفان، اعطاه مالا قراضا يعمل فيه على ان الربح بينهما","grades":[{"name":"Salim al-Hilali","grade":"Mauquf Hasan"}],"reference":{"book":32,"hadith":2}}]}