{"metadata":{"name":"Muwatta Malik","name_native":"موطأ الإمام مالك","section":{"5":"Jumu'a"},"section_detail":{"5":{"hadithnumber_first":225,"hadithnumber_last":245,"arabicnumber_first":225,"arabicnumber_last":245,"name_native":"جمعة"}}},"hadiths":[{"hadithnumber":245,"arabicnumber":245,"text":"وحدثني عن مالك، عن جعفر بن محمد، عن ابيه، ان رسول الله صلى الله عليه وسلم خطب خطبتين يوم الجمعة وجلس بينهما","grades":[{"name":"Salim al-Hilali","grade":"Sahih Lighairihi"}],"reference":{"book":5,"hadith":21}}]}