{"metadata":{"name":"Muwatta Malik","section":{"15":"The Qur'an"},"section_detail":{"15":{"hadithnumber_first":470,"hadithnumber_last":519,"arabicnumber_first":470,"arabicnumber_last":519,"name_native":"القرآن"}}},"hadiths":[{"hadithnumber":507,"arabicnumber":507,"text":"وحدثني عن مالك، عن يحيى بن سعيد، ان سعيد بن المسيب، كان يقول ان الرجل ليرفع بدعاء ولده من بعده وقال بيديه نحو السماء فرفعهما","grades":[{"name":"Salim al-Hilali","grade":"Maqtu Sahih"}],"reference":{"book":15,"hadith":38}}]}