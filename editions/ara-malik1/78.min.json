{"metadata":{"name":"Muwatta Malik","name_native":"موطأ الإمام مالك","section":{"2":"Purity"},"section_detail":{"2":{"hadithnumber_first":32,"hadithnumber_last":145,"arabicnumber_first":32,"arabicnumber_last":145,"name_native":"كتاب الطهارة"}}},"hadiths":[{"hadithnumber":78,"arabicnumber":78,"text":"وحدثني عن مالك، انه بلغه ان عبد الله بن عباس، كان يرعف فيخرج فيغسل الدم عنه ثم يرجع فيبني على ما قد صلى","grades":[{"name":"Salim al-Hilali","grade":"Mauquf Daif"}],"reference":{"book":2,"hadith":47}}]}