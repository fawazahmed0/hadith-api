{"metadata":{"name":"Sahih Muslim","name_native":"صحيح مسلم","section":{"27":"The Book of Oaths"},"section_detail":{"27":{"hadithnumber_first":4254,"hadithnumber_last":4341,"arabicnumber_first":1646.01,"arabicnumber_last":1668.03,"name_native":"كتاب الأيمان والنذور"}}},"hadiths":[{"hadithnumber":4287,"arabicnumber":"1654.03","text":"وحدثنا ابن ابي عمر، حدثنا سفيان، عن ابي الزناد، عن الاعرج، عن ابي هريرة، عن النبي صلى الله عليه وسلم مثله او نحوه","grades":[],"reference":{"book":27,"hadith":34}}]}