{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"كتاب الجنائز"}}},"hadiths":[{"hadithnumber":1892,"arabicnumber":1892,"text":"أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ، قَالَ حَدَّثَنَا حَمَّادٌ، عَنْ أَيُّوبَ، وَقَالَتْ، حَفْصَةُ عَنْ أُمِّ عَطِيَّةَ، وَجَعَلْنَا، رَأْسَهَا ثَلاَثَةَ قُرُونٍ ‏.‏","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":21,"hadith":75}}]}