{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"26":"The Book of Marriage"},"section_detail":{"26":{"hadithnumber_first":3196,"hadithnumber_last":3388,"arabicnumber_first":3196,"arabicnumber_last":3388,"name_native":"كتاب النكاح"}}},"hadiths":[{"hadithnumber":3238,"arabicnumber":3238,"text":"أَخْبَرَنَا قُتَيْبَةُ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ لاَ يَخْطُبْ أَحَدُكُمْ عَلَى خِطْبَةِ بَعْضٍ ‏\"‏ ‏.‏","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":26,"hadith":43}}]}