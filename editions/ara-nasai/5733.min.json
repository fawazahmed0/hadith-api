{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"كتاب الأشربة"}}},"hadiths":[{"hadithnumber":5733,"arabicnumber":5733,"text":"أَخْبَرَنَا سُوَيْدٌ، قَالَ أَنْبَأَنَا عَبْدُ اللَّهِ، عَنْ عَبْدِ الْمَلِكِ، عَنْ عَطَاءٍ، فِي الْعَصِيرِ قَالَ اشْرَبْهُ حَتَّى يَغْلِيَ ‏.‏","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad Maqtu"},{"name":"Al-Albani","grade":"Sahih Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":51,"hadith":195}}]}