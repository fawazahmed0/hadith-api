{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"كتاب الجنائز"}}},"hadiths":[{"hadithnumber":1851,"arabicnumber":1851,"text":"اخبرنا محمد بن عبد الاعلى، قال حدثنا خالد، قال حدثنا شعبة، عن قتادة، عن مطرف، عن حكيم بن قيس، ان قيس بن عاصم، قال لا تنوحوا على فان رسول الله صلى الله عليه وسلم لم ينح عليه . مختصر","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":21,"hadith":34}}]}