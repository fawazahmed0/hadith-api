{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"كتاب الجنائز"}}},"hadiths":[{"hadithnumber":1869,"arabicnumber":1869,"text":"اخبرنا عمرو بن علي، قال حدثنا محمد بن جعفر، قال حدثنا شعبة، عن ثابت، قال سمعت انسا، يقول قال رسول الله صلى الله عليه وسلم \" الصبر عند الصدمة الاولى","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":21,"hadith":52}}]}