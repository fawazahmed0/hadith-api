{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"كتاب الجنائز"}}},"hadiths":[{"hadithnumber":1898,"arabicnumber":1898,"text":"اخبرنا قتيبة، عن مالك، عن هشام بن عروة، عن ابيه، عن عايشة، ان رسول الله صلى الله عليه وسلم كفن في ثلاثة اثواب بيض سحولية ليس فيها قميص ولا عمامة","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":21,"hadith":81}}]}