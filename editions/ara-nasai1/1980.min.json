{"metadata":{"name":"Sunan an Nasai","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"كتاب الجنائز"}}},"hadiths":[{"hadithnumber":1980,"arabicnumber":1980,"text":"اخبرنا قتيبة، عن مالك، عن ابن شهاب، عن سعيد، عن ابي هريرة، ان رسول الله صلى الله عليه وسلم نعى للناس النجاشي وخرج بهم فصف بهم وكبر اربع تكبيرات","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":21,"hadith":163}}]}