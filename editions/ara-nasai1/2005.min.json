{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"كتاب الجنائز"}}},"hadiths":[{"hadithnumber":2005,"arabicnumber":2005,"text":"اخبرنا محمد بن عبد الله بن المبارك، قال حدثنا وكيع، عن سفيان، عن الاسود بن قيس، عن نبيح العنزي، عن جابر، ان النبي صلى الله عليه وسلم قال : \" ادفنوا القتلى في مصارعهم","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":21,"hadith":188}}]}