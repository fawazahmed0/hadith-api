{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"كتاب الصيام"}}},"hadiths":[{"hadithnumber":2145,"arabicnumber":2145,"text":"اخبرنا عبيد الله بن سعيد، قال حدثنا عبد الرحمن، عن ابي بكر بن عياش، عن عاصم، عن زر، عن عبد الله، قال تسحروا . قال عبيد الله لا ادري كيف لفظه","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":22,"hadith":56}}]}