{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"كتاب الصيام"}}},"hadiths":[{"hadithnumber":2228,"arabicnumber":2228,"text":"اخبرنا ابراهيم بن الحسن، عن حجاج، قال ابن جريج اخبرني عطاء، عن ابي صالح الزيات، انه سمع ابا هريرة، يقول قال رسول الله صلى الله عليه وسلم \" الصيام جنة","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":22,"hadith":139}}]}