{"metadata":{"name":"Sunan an Nasai","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"كتاب الصيام"}}},"hadiths":[{"hadithnumber":2292,"arabicnumber":2292,"text":"اخبرنا حميد بن مسعدة، قال حدثنا سفيان، عن العوام بن حوشب، قال قلت لمجاهد الصوم في السفر قال كان رسول الله صلى الله عليه وسلم يصوم ويفطر","grades":[{"name":"Abu Ghuddah","grade":"Sahih Lighairihi"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":22,"hadith":203}}]}