{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"كتاب الصيام"}}},"hadiths":[{"hadithnumber":2339,"arabicnumber":2339,"text":"اخبرنا اسحاق بن ابراهيم، قال انبانا سفيان، عن الزهري، عن حمزة بن عبد الله بن عمر، عن حفصة، قالت لا صيام لمن لم يجمع الصيام قبل الفجر","grades":[{"name":"Abu Ghuddah","grade":"Sahih Muquf"},{"name":"Al-Albani","grade":"Sahih Muquf"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":22,"hadith":250}}]}