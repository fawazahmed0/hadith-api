{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"كتاب الصيام"}}},"hadiths":[{"hadithnumber":2342,"arabicnumber":2342,"text":"اخبرنا محمد بن عبد الاعلى، قال حدثنا المعتمر، قال سمعت عبيد الله، عن نافع، عن ابن عمر، قال اذا لم يجمع الرجل الصوم من الليل فلا يصم","grades":[{"name":"Abu Ghuddah","grade":"Sahih Muquf"},{"name":"Al-Albani","grade":"Sahih Muquf"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":22,"hadith":253}}]}