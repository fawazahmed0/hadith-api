{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"كتاب الحج"}}},"hadiths":[{"hadithnumber":2868,"arabicnumber":2868,"text":"اخبرنا عبيد الله بن فضالة بن ابراهيم، قال حدثنا عبد الله بن الزبير، قال حدثنا سفيان، قال حدثني مالك، عن الزهري، عن انس، ان النبي صلى الله عليه وسلم دخل مكة عام الفتح وعلى راسه المغفر","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":24,"hadith":251}}]}