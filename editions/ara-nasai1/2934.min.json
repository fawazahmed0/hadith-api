{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"كتاب الحج"}}},"hadiths":[{"hadithnumber":2934,"arabicnumber":2934,"text":"اخبرنا يعقوب بن ابراهيم، عن عبد الرحمن بن مهدي، اخبرني هاني بن ايوب، عن طاوس، عن جابر بن عبد الله، ان النبي صلى الله عليه وسلم طاف طوافا واحدا","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":24,"hadith":317}}]}