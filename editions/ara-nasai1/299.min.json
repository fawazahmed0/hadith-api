{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"كتاب الطهارة"}}},"hadiths":[{"hadithnumber":299,"arabicnumber":299,"text":"اخبرنا شعيب بن يوسف، عن يحيى بن سعيد، عن الاعمش، عن ابراهيم، عن همام، عن عايشة، قالت كنت اراه في ثوب رسول الله صلى الله عليه وسلم فاحكه","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":1,"hadith":300}}]}