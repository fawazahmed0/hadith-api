{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"27":"The Book of Divorce"},"section_detail":{"27":{"hadithnumber_first":3389,"hadithnumber_last":3560,"arabicnumber_first":3389,"arabicnumber_last":3560,"name_native":"كتاب الطلاق"}}},"hadiths":[{"hadithnumber":3419,"arabicnumber":3419,"text":"اخبرنا عبيد الله بن سعيد، قال حدثنا عبد الرحمن، عن سفيان، عن منصور، عن مجاهد، عن تميم، مولى فاطمة عن فاطمة، نحوه","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":27,"hadith":31}}]}