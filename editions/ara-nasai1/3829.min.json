{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"35":"The Book of Agriculture"},"section_detail":{"35":{"hadithnumber_first":3761,"hadithnumber_last":3856,"arabicnumber_first":3761,"arabicnumber_last":3856,"name_native":"كتاب الزراعة"}}},"hadiths":[{"hadithnumber":3829,"arabicnumber":3829,"text":"اخبرنا محمد بن منصور، قال حدثنا سفيان، عن ايوب، عن نافع، عن ابن عمر، قال قال رسول الله صلى الله عليه وسلم \" من حلف فقال ان شاء الله فقد استثنى","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":35,"hadith":69}}]}