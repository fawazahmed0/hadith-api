{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"42":"The Book of Hunting and Slaughtering"},"section_detail":{"42":{"hadithnumber_first":4263,"hadithnumber_last":4360,"arabicnumber_first":4263,"arabicnumber_last":4360,"name_native":"كتاب الصيد"}}},"hadiths":[{"hadithnumber":4360,"arabicnumber":4360,"text":"اخبرنا اسحاق بن ابراهيم، قال حدثنا معاذ بن هشام، قال حدثني ابي، عن قتادة، عن الحسن، عن ابي هريرة، نحوه ولم يرفعه","grades":[{"name":"Abu Ghuddah","grade":"Daif Isnaad"},{"name":"Al-Albani","grade":"Daif Isnaad"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":42,"hadith":98}}]}