{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"44":"The Book of Financial Transactions"},"section_detail":{"44":{"hadithnumber_first":4449,"hadithnumber_last":4705,"arabicnumber_first":4449,"arabicnumber_last":4705,"name_native":"كتاب المعاملات المالية"}}},"hadiths":[{"hadithnumber":4492,"arabicnumber":4492,"text":"اخبرنا محمد بن بشار، قال حدثني محمد بن الزبرقان، قال حدثنا يونس بن عبيد، عن الحسن، عن انس، ان النبي صلى الله عليه وسلم نهى ان يبيع حاضر لباد وان كان اباه او اخاه","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih Hadith"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":44,"hadith":44}}]}