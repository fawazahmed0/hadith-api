{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"44":"The Book of Financial Transactions"},"section_detail":{"44":{"hadithnumber_first":4449,"hadithnumber_last":4705,"arabicnumber_first":4449,"arabicnumber_last":4705,"name_native":"كتاب المعاملات المالية"}}},"hadiths":[{"hadithnumber":4547,"arabicnumber":4547,"text":"اخبرنا ابراهيم بن الحسن، قال حدثنا حجاج، قال ابن جريج اخبرني ابو الزبير، انه سمع جابر بن عبد الله، يقول نهى رسول الله صلى الله عليه وسلم عن بيع الصبرة من التمر لا يعلم مكيلها بالكيل المسمى من التمر","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih Hadith"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":44,"hadith":99}}]}