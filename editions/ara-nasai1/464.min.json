{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"5":"The Book of Salah"},"section_detail":{"5":{"hadithnumber_first":448,"hadithnumber_last":493,"arabicnumber_first":448,"arabicnumber_last":493,"name_native":"كتاب صلاح"}}},"hadiths":[{"hadithnumber":464,"arabicnumber":464,"text":"اخبرنا احمد بن حرب، حدثنا محمد بن ربيعة، عن ابن جريج، عن ابي الزبير، عن جابر، قال قال رسول الله صلى الله عليه وسلم \" ليس بين العبد وبين الكفر الا ترك الصلاة","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":5,"hadith":17}}]}