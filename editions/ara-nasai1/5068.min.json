{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"كتاب الزينة"}}},"hadiths":[{"hadithnumber":5068,"arabicnumber":5068,"text":"اخبرنا قتيبة، عن عبد العزيز، عن عمارة بن غزية، عن عمرو بن شعيب، عن ابيه، عن جده، ان رسول الله صلى الله عليه وسلم نهى عن نتف الشيب","grades":[{"name":"Abu Ghuddah","grade":"Hasan Sahih"},{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":48,"hadith":29}}]}