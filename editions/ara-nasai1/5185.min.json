{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"كتاب الزينة"}}},"hadiths":[{"hadithnumber":5185,"arabicnumber":5185,"text":"اخبرنا قتيبة، قال اخبرنا حماد، عن ايوب، عن محمد، عن عبيدة، قال نهى عن مياثر الارجوان، وخواتيم الذهب،","grades":[{"name":"Abu Ghuddah","grade":"Sahih Maqtu"},{"name":"Al-Albani","grade":"Sahih Maqtu"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":48,"hadith":146}}]}