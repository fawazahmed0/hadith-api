{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"كتاب الزينة"}}},"hadiths":[{"hadithnumber":5279,"arabicnumber":5279,"text":"اخبرنا قتيبة، قال حدثنا ابن وهب، عن يونس، عن الزهري، عن انس، ان رسول الله صلى الله عليه وسلم اتخذ خاتما من ورق وفصه حبشي","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":48,"hadith":240}}]}