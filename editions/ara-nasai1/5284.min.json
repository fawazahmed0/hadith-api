{"metadata":{"name":"Sunan an Nasai","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"كتاب الزينة"}}},"hadiths":[{"hadithnumber":5284,"arabicnumber":5284,"text":"اخبرنا الحسين بن عيسى البسطامي، قال حدثنا سلم بن قتيبة، عن شعبة، عن قتادة، عن انس، قال كاني انظر الى بياض خاتم النبي صلى الله عليه وسلم في اصبعه اليسرى","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":48,"hadith":245}}]}