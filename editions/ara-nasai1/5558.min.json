{"metadata":{"name":"Sunan an Nasai","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"كتاب الأشربة"}}},"hadiths":[{"hadithnumber":5558,"arabicnumber":5558,"text":"اخبرنا احمد بن سليمان، قال حدثنا يزيد، قال انبانا حميد، عن عكرمة، عن ابن عباس، قال البسر وحده حرام ومع التمر حرام","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":51,"hadith":19}}]}