{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"كتاب الأشربة"}}},"hadiths":[{"hadithnumber":5559,"arabicnumber":5559,"text":"اخبرنا محمد بن ادم، وعلي بن سعيد، قالا حدثنا عبد الرحيم، عن حبيب بن ابي عمرة، عن سعيد بن جبير، عن ابن عباس، قال نهى رسول الله صلى الله عليه وسلم عن خليط التمر والزبيب وعن التمر والبسر","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":51,"hadith":20}}]}