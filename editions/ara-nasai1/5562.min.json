{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"كتاب الأشربة"}}},"hadiths":[{"hadithnumber":5562,"arabicnumber":5562,"text":"اخبرنا قتيبة، قال حدثنا الليث، عن ابي الزبير، عن جابر، عن رسول الله صلى الله عليه وسلم انه نهى ان ينبذ الزبيب والبسر جميعا ونهى ان ينبذ البسر والرطب جميعا","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":51,"hadith":23}}]}