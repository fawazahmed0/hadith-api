{"metadata":{"name":"Sunan an Nasai","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"كتاب الأشربة"}}},"hadiths":[{"hadithnumber":5580,"arabicnumber":5580,"text":"اخبرنا احمد بن سليمان، قال حدثنا عبيد الله، عن اسراييل، عن ابي حصين، عن عامر، عن ابن عمر، قال الخمر من خمسة من التمر والحنطة والشعير والعسل والعنب","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":51,"hadith":42}}]}