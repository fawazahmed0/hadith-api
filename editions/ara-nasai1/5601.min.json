{"metadata":{"name":"Sunan an Nasai","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"كتاب الأشربة"}}},"hadiths":[{"hadithnumber":5601,"arabicnumber":5601,"text":"اخبرنا سويد، قال انبانا عبد الله، عن الصعق بن حزن، قال كتب عمر بن عبد العزيز الى عدي بن ارطاة كل مسكر حرام","grades":[{"name":"Abu Ghuddah","grade":"Hasan Isnaad"},{"name":"Al-Albani","grade":"Hasan Isnaad"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":51,"hadith":63}}]}