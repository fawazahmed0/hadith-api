{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"كتاب الأشربة"}}},"hadiths":[{"hadithnumber":5642,"arabicnumber":5642,"text":"اخبرنا زياد بن ايوب، قال حدثنا ابن ادريس، قال سمعت المختار بن فلفل، عن انس، قال نهى رسول الله صلى الله عليه وسلم عن الظروف المزفتة","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":51,"hadith":104}}]}