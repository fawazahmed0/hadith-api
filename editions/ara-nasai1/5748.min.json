{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"كتاب الأشربة"}}},"hadiths":[{"hadithnumber":5748,"arabicnumber":5748,"text":"اخبرنا سويد، قال انبانا عبد الله، عن سفيان، عن مغيرة، عن ابي معشر، عن ابراهيم، قال لا باس بنبيذ البختج","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":51,"hadith":210}}]}