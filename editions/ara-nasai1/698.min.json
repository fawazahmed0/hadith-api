{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"8":"The Book of the Masjids"},"section_detail":{"8":{"hadithnumber_first":688,"hadithnumber_last":741,"arabicnumber_first":688,"arabicnumber_last":741,"name_native":"كتاب المساجد"}}},"hadiths":[{"hadithnumber":698,"arabicnumber":698,"text":"اخبرنا قتيبة، عن مالك، عن عبد الله بن دينار، عن ابن عمر، قال كان رسول الله صلى الله عليه وسلم ياتي قباء راكبا وماشيا","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":8,"hadith":11}}]}