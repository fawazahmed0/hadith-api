{"metadata":{"name":"Sunan an Nasai","name_native":"سنن النسائي","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"كتاب الطهارة"}}},"hadiths":[{"hadithnumber":72,"arabicnumber":72,"text":"اخبرنا قتيبة بن سعيد، قال حدثنا الليث، عن ابن شهاب، عن عروة، عن عايشة، انها اخبرته انها، كانت تغتسل مع رسول الله صلى الله عليه وسلم في الاناء الواحد","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":1,"hadith":72}}]}