{"metadata":{"name":"Jami At Tirmidhi","name_native":"جامع الترمذي","section":{"34":"Chapters On Dreams"},"section_detail":{"34":{"hadithnumber_first":2270,"hadithnumber_last":2294,"arabicnumber_first":2270,"arabicnumber_last":2294,"name_native":"فصول في الأحلام"}}},"hadiths":[{"hadithnumber":2274,"arabicnumber":2274,"text":"حَدَّثَنَا قُتَيْبَةُ، حَدَّثَنَا ابْنُ لَهِيعَةَ، عَنْ دَرَّاجٍ، عَنْ أَبِي الْهَيْثَمِ، عَنْ أَبِي سَعِيدٍ، عَنِ النَّبِيِّ صلى الله عليه وسلم ‏ \"‏ أَصْدَقُ الرُّؤْيَا بِالأَسْحَارِ ‏\"‏","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Daif"},{"name":"Al-Albani","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":34,"hadith":5}}]}