{"metadata":{"name":"Jami At Tirmidhi","name_native":"جامع الترمذي","section":{"9":"The Book on Hajj"},"section_detail":{"9":{"hadithnumber_first":809,"hadithnumber_last":964,"arabicnumber_first":809,"arabicnumber_last":964,"name_native":"كتاب الحج"}}},"hadiths":[{"hadithnumber":843,"arabicnumber":843,"text":"حَدَّثَنَا قُتَيْبَةُ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ أَيُّوبَ، عَنْ عِكْرِمَةَ، عَنِ ابْنِ عَبَّاسٍ، أَنَّ النَّبِيَّ صلى الله عليه وسلم تَزَوَّجَ مَيْمُونَةَ وَهُوَ مُحْرِمٌ ‏.‏","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Shadh"},{"name":"Al-Albani","grade":"Shadh"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":9,"hadith":36}}]}