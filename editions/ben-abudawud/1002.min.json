{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":1002,"arabicnumber":1002,"text":"। ‘আবদুল্লাহ ইবনু ‘আব্বাস (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সালাতের সমাপ্তি জানা যেতো তাকবীর দ্বারা।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (482) Sahih Muslim (583)"}],"reference":{"book":2,"hadith":613}}]}