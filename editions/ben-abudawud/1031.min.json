{"metadata":{"name":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":1031,"arabicnumber":1031,"text":"। মুহাম্মাদ ইবনু মুসলিম (রহঃ) তার সানাদে এ হাদীসটি বর্ণনা করেছেন। তাতে এও রয়েছেঃ সে সালাম ফিরানোর পূর্বে বসা অবস্থায় (দু‘টি সাহু সিজদা) করবে।[1] হাসান সহীহ।","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":2,"hadith":642}}]}