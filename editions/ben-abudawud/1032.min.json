{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":1032,"arabicnumber":1032,"text":"। মুহাম্মাদ ইবনু মুসলিম আয-যুহরী (রহঃ) উপরোক্ত সানাদ ও অর্থে হাদীসটি বর্ণনা করেছেন। তিনি (সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম) বলেছেন, সে যেন সালাম ফিরানোর আগে দু‘টি সিজদা্ আদায় করে, অতঃপর সালাম ফিরায়।[1] হাসান সহীহ।","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":2,"hadith":643}}]}