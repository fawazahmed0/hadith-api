{"metadata":{"name":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":1055,"arabicnumber":1055,"text":"। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর স্ত্রী ‘আয়িশাহ্ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, লোকজন জুমু‘আহর সালাতের জন্য নিজ নিজ বাড়ী থেকে এবং মদীনার আওয়ালী (শহরতলী) থেকে দলে দলে আসতো।[1] সহীহ : বুখারী ও মুসলিম।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (902) Sahih Muslim (847)"}],"reference":{"book":2,"hadith":666}}]}