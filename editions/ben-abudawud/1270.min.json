{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"5":"Prayer (Kitab Al-Salat): Voluntary Prayers"},"section_detail":{"5":{"hadithnumber_first":1250,"hadithnumber_last":1370,"arabicnumber_first":1250,"arabicnumber_last":1370,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":1270,"arabicnumber":1270,"text":"। আবূ আইয়ূব (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যুহরের পূর্বে এক সালামে চার রাক‘আত সালাত রয়েছে, এগুলোর জন্য আকাশের সকল দরজা খুলে দেয়া হয়।[1] হাসান।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":5,"hadith":21}}]}