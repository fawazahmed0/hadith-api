{"metadata":{"name":"Sunan Abu Dawud","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"পবিত্রতা অধ্যায়"}}},"hadiths":[{"hadithnumber":140,"arabicnumber":140,"text":"। আবূ হুরাইরাহ্ (রাঃ) সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যখন তোমাদের কেউ অযু করে, তখন সে যেন স্বীয় নাকে পানি দিয়ে (পরিস্কার করে) তা ঝেড়ে ফেলে দেয়।[1] সহীহ : বুখারী ও মুসলিম।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (162) Sahih Muslim (141)"}],"reference":{"book":1,"hadith":140}}]}