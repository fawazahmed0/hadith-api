{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"9":"Zakat (Kitab Al-Zakat)"},"section_detail":{"9":{"hadithnumber_first":1556,"hadithnumber_last":1700,"arabicnumber_first":1556,"arabicnumber_last":1700,"name_native":"যাকাত অধ্যায়"}}},"hadiths":[{"hadithnumber":1577,"arabicnumber":1577,"text":"। মু‘আয (রাঃ) সূত্রে বর্ণিত। তিনি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম হতে পূর্বোক্ত হাদীসের অনুরূপ বর্ণনা করেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":9,"hadith":22}}]}