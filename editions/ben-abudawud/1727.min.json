{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"11":"The Rites of Hajj (Kitab Al-Manasik Wa'l-Hajj)"},"section_detail":{"11":{"hadithnumber_first":1721,"hadithnumber_last":2045,"arabicnumber_first":1721,"arabicnumber_last":2045,"name_native":"হজের রীতি (কিতাব আল-মানসিক ওয়াল-হজ)"}}},"hadiths":[{"hadithnumber":1727,"arabicnumber":1727,"text":"। ইবনু ‘উমার (রাযি.) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কোনো নারী স্বীয় মাহারাম সাথে না নিয়ে তিন দিনের সফর করবে না।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (1087) Sahih Muslim (1338)"}],"reference":{"book":11,"hadith":7}}]}