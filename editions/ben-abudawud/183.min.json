{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"পবিত্রতা অধ্যায়"}}},"hadiths":[{"hadithnumber":183,"arabicnumber":183,"text":"। ক্বায়িস ইবনু তালক হতে একই সানাদে উপরোক্ত হাদীসের সমার্থক হাদীস বর্ণিত আছে। তাতে, সালাতরত অবস্থায় পুরুষাঙ্গ স্পর্শ করলে-কথাটি রয়েছে।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":1,"hadith":183}}]}