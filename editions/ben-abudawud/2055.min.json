{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"নিকাহ (বিয়ে) অধ্যায়"}}},"hadiths":[{"hadithnumber":2055,"arabicnumber":2055,"text":"। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর স্ত্রী ‘আয়িশাহ্ (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ রক্তের সম্পর্কের কারণে যাদেরকে বিয়ে করা হারাম, অনুরূপভাবে দুধপান জনিত সম্পর্কের কারণেও তারা হারাম।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":12,"hadith":10}}]}