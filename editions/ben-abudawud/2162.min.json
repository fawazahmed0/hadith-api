{"metadata":{"name":"Sunan Abu Dawud","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"নিকাহ (বিয়ে) অধ্যায়"}}},"hadiths":[{"hadithnumber":2162,"arabicnumber":2162,"text":"। আবূ হুরাইরাহ (রাযি.) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে ব্যক্তি তার স্ত্রীর সাথে গুহ্যদ্বারে সঙ্গম করে সে অভিশপ্ত।[1] হাসান।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":12,"hadith":117}}]}