{"metadata":{"name":"Sunan Abu Dawud","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"তালাক অধ্যায়"}}},"hadiths":[{"hadithnumber":2234,"arabicnumber":2234,"text":"। ‘আয়িশাহ্ (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বারীরাহকে এখতিয়ার দিয়েছিলেন। তার স্বামী ছিলো ক্রীতদাস।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1504)"}],"reference":{"book":13,"hadith":60}}]}