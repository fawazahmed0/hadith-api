{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"তালাক অধ্যায়"}}},"hadiths":[{"hadithnumber":2246,"arabicnumber":2246,"text":"। ‘আব্বাস ইবনু সাহল (রহ.) থেকে তার পিতার সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ‘আসিম ইবনু ‘আদী (রাযি.)-কে বললেনঃ তুমি মহিলাকে সন্তান প্রসবকাল পর্যন্ত নিজের কাছে রেখে দাও।[1] হাসান।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":13,"hadith":72}}]}