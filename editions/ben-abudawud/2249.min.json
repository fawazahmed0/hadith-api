{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"তালাক অধ্যায়"}}},"hadiths":[{"hadithnumber":2249,"arabicnumber":2249,"text":"। সাহল ইবনু সা‘দ আস-সাঈদী (রাযি.) সূত্রে উক্ত ঘটনা বর্ণিত হয়েছে। তিনি বলেছেন, সন্তাটিকে তার মায়ের সাথে সম্পৃক্ত করে ডাকা হতো।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (4745)"}],"reference":{"book":13,"hadith":75}}]}