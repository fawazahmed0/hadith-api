{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"14":"Fasting (Kitab Al-Siyam)"},"section_detail":{"14":{"hadithnumber_first":2313,"hadithnumber_last":2476,"arabicnumber_first":2313,"arabicnumber_last":2476,"name_native":"সিয়াম (রোজা) অধ্যায়"}}},"hadiths":[{"hadithnumber":2343,"arabicnumber":2343,"text":"। আমর ইবনুল আস (রাযি.) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ আমাদের ও আহলে কিতাবের সওমের মধ্যে পার্থক্য হচ্ছে সাহারী খাওয়া।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1096)"}],"reference":{"book":14,"hadith":31}}]}