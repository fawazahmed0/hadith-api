{"metadata":{"name":"Sunan Abu Dawud","section":{"14":"Fasting (Kitab Al-Siyam)"},"section_detail":{"14":{"hadithnumber_first":2313,"hadithnumber_last":2476,"arabicnumber_first":2313,"arabicnumber_last":2476,"name_native":"সিয়াম (রোজা) অধ্যায়"}}},"hadiths":[{"hadithnumber":2461,"arabicnumber":2461,"text":"। আবূ হুরাইরাহ (রাযি.) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমাদের কোনো (সওম পালনকারী) ব্যক্তিকে খাবার দাওয়াত দেয়া হলে সে যেন বলে, নিশ্চয় আমি রোযাদার।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1150)"}],"reference":{"book":14,"hadith":149}}]}