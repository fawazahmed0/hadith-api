{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2518,"arabicnumber":2518,"text":"। ‘আমর ইবনু মুররাহ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, আমি আবূ ওয়াইলের নিকট এমন একটি হাদীস শুনেছি, যা আমাকে হতবাক করেছে ... অতঃপর বাকী অংশ উপরের হাদীসের অনুরূপ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":15,"hadith":42}}]}