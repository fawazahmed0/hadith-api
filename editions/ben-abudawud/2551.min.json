{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2551,"arabicnumber":2551,"text":"। আনাস ইবনু মালিক (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, ‘আমরা কোনো স্থানে অবতরণ করলে বাহনের পিঠ থেকে হাওদা নামিয়ে এর বিশ্রামের ব্যবস্থা না করা পর্যন্ত সালাত আদায় করতাম না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":15,"hadith":75}}]}