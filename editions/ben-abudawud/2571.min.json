{"metadata":{"name":"Sunan Abu Dawud","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2571,"arabicnumber":2571,"text":"। আনাস (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমাদের রাতের প্রথমাংশে সফর করা উচিত। কেননা রাতের বেলা যমীন সংকুচিত হয়।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":15,"hadith":95}}]}