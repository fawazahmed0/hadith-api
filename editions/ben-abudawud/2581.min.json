{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2581,"arabicnumber":2581,"text":"। ‘ইমরান ইবনু হুসাইন (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ টানা বা তাড়া দেয়া এবং খোঁচা মারা বৈধ নেই। ইয়াহইয়া (রাঃ) তার বর্ণিত হাদীসে ‘রিহান’ (ঘোড়দৌড়) শব্দটিও উল্লেখ করেছেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":15,"hadith":105}}]}