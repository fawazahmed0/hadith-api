{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2583,"arabicnumber":2583,"text":"। আনাস (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর তরবারির বাট রূপা দিয়ে বাঁধানো ছিলো।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":15,"hadith":107}}]}