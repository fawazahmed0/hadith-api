{"metadata":{"name":"Sunan Abu Dawud","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2636,"arabicnumber":2636,"text":"। ‘আমর (রহঃ) সূত্রে বর্ণিত। তিনি জাবির (রাঃ)-এর নিকট শুনেছেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যুদ্ধ হচ্ছে ধোঁকা বা রণকৌশল।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (3030) Sahih Muslim (1739)"}],"reference":{"book":15,"hadith":160}}]}