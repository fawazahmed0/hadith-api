{"metadata":{"name":"Sunan Abu Dawud","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2658,"arabicnumber":2658,"text":"। আল-বারাআ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, হুনাইনের যুদ্ধের দিন নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মুশরিকের মুখোমুখি হন এবং মুসলিমরা ছত্রভঙ্গ হয়ে যায়, তখন তিনি তাঁর খচ্চর থেকে নেমে পায়ে হাঁটতে লাগেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (3042) Sahih Muslim (1776)"}],"reference":{"book":15,"hadith":182}}]}