{"metadata":{"name":"Sunan Abu Dawud","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2674,"arabicnumber":2674,"text":"। আবূ হুরাইরাহ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদেরকে এক অভিযানে প্রেরণের সময় বললেনঃ তোমরা যদি অমুক অমুক ব্যক্তিকে পাও ... অতঃপর বাকী অংশ উপরের হাদীসের অনুরূপ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (3016)"}],"reference":{"book":15,"hadith":198}}]}