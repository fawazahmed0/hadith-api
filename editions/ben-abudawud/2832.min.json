{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"16":"Sacrifice (Kitab Al-Dahaya)"},"section_detail":{"16":{"hadithnumber_first":2788,"hadithnumber_last":2843,"arabicnumber_first":2788,"arabicnumber_last":2843,"name_native":"কোরবানি অধ্যায়"}}},"hadiths":[{"hadithnumber":2832,"arabicnumber":2832,"text":"। সাঈদ ইবনুল মুসাইয়্যিব (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, ফারা‘আ হলো পশুর ঐ প্রথম বাচ্চা, যা তারা দেবতার উদ্দেশ্যে যবাহ করতো।","grades":[{"name":"Al-Albani","grade":"Sahih Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Maqtu"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":16,"hadith":45}}]}