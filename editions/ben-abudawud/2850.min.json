{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"17":"Game (Kitab Al-Said)"},"section_detail":{"17":{"hadithnumber_first":2844,"hadithnumber_last":2861,"arabicnumber_first":2844,"arabicnumber_last":2861,"name_native":"শিকার অধ্যায়"}}},"hadiths":[{"hadithnumber":2850,"arabicnumber":2850,"text":"। ‘আদী ইবনু হাতিম (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তোমার শিকার তীরসহ পানিতে পড়ে ডুবে মারা গেলে তাহলে তুমি তা খাবে না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (5484) Sahih Muslim (1929)"}],"reference":{"book":17,"hadith":7}}]}