{"metadata":{"name":"Sunan Abu Dawud","section":{"17":"Game (Kitab Al-Said)"},"section_detail":{"17":{"hadithnumber_first":2844,"hadithnumber_last":2861,"arabicnumber_first":2844,"arabicnumber_last":2861,"name_native":"শিকার অধ্যায়"}}},"hadiths":[{"hadithnumber":2858,"arabicnumber":2858,"text":"। আবূ ওয়াকিদ (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ জীবিত পশুর দেহের অংশবিশেষ কেটে বিচ্ছিন্ন হলে ঐ অংশ মৃত বলে গণ্য (যা হারাম)।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":17,"hadith":15}}]}