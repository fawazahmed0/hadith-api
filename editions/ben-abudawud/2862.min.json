{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"18":"Wills (Kitab Al-Wasaya)"},"section_detail":{"18":{"hadithnumber_first":2862,"hadithnumber_last":2884,"arabicnumber_first":2862,"arabicnumber_last":2884,"name_native":"ওসিয়ত অধ্যায়"}}},"hadiths":[{"hadithnumber":2862,"arabicnumber":2862,"text":"। ‘আব্দুল্লাহ ইবনু ‘উমার (রাঃ) সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ কোনো মুসলিমের কাছে ওসিয়াত করার মতো সম্পদ থাকলে, তার নিজের কাছে ওসিয়াতনামা না লিখে রেখে দু’ রাতও অতিবাহিত করার অধিকার তার নেই।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (2738) Sahih Muslim (1627)"}],"reference":{"book":18,"hadith":1}}]}