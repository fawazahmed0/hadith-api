{"metadata":{"name":"Sunan Abu Dawud","section":{"19":"Shares of Inheritance (Kitab Al-Fara'id)"},"section_detail":{"19":{"hadithnumber_first":2885,"hadithnumber_last":2927,"arabicnumber_first":2885,"arabicnumber_last":2927,"name_native":"ফারায়েজ (উত্তরাধিকার) অধ্যায়"}}},"hadiths":[{"hadithnumber":2909,"arabicnumber":2909,"text":"। উসামাহ ইবনু যায়িদ (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেন, মুসলিম ব্যক্তি কাফিরের এবং কাফির ব্যক্তি মুসলিমের উত্তরাধিকারী হবে না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (4282، 4283) Sahih Muslim (1614)"}],"reference":{"book":19,"hadith":25}}]}