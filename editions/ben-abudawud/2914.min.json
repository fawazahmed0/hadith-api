{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"19":"Shares of Inheritance (Kitab Al-Fara'id)"},"section_detail":{"19":{"hadithnumber_first":2885,"hadithnumber_last":2927,"arabicnumber_first":2885,"arabicnumber_last":2927,"name_native":"ফারায়েজ (উত্তরাধিকার) অধ্যায়"}}},"hadiths":[{"hadithnumber":2914,"arabicnumber":2914,"text":"। ইবনু ‘আব্বাস (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ জাহিলী যুগে যে মীরাস বণ্টিত হয়েছে তা যার জন্য বণ্টিত হয়েছে তারই থাকবে। আর যে সম্পদ ইসলামী যুগে বণ্টন হবে তা ইসলামী নীতি অনুসারে বণ্টিত হবে।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":19,"hadith":30}}]}