{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":3121,"arabicnumber":3121,"text":"। মা‘কিল ইবনু ইয়াসার (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা তোমাদের মুমূর্ষ ব্যক্তিদের নিকট ‘সূরা ইয়াসীন’ পাঠ করো।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":21,"hadith":33}}]}