{"metadata":{"name":"Sunan Abu Dawud","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":3132,"arabicnumber":3132,"text":"। ‘আব্দুল্লাহ ইবনু জা‘ফর (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেনঃ তোমরা জা‘ফরের পরিবারের জন্য খাবার তৈরী করো। কারণ তাদের কাছে এমন দুঃসংবাদ এসেছে যা তাদেরকে ব্যস্ত রাখবে।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":21,"hadith":44}}]}