{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":3135,"arabicnumber":3135,"text":"। আনাস ইবনু মালিক (রাঃ) সূত্রে বর্ণিত। উহুদ যুদ্ধের শহীদদেরকে গোসল দেয়া হয়নি। তাদেরকে রক্তরঞ্জিত দেহেই দাফন করা হয় এবং তাদের উপর জানাযা পড়া হয়নি।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":21,"hadith":47}}]}