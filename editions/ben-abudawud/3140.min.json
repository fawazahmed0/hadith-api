{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":3140,"arabicnumber":3140,"text":"। আলী (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমার রান অনাবৃত করবে না এবং জীবিত ও মৃত কারো রানের প্রতি দৃষ্টিপাত করবে না।","grades":[{"name":"Al-Albani","grade":"Very Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Very Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":21,"hadith":52}}]}