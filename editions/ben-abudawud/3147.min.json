{"metadata":{"name":"Sunan Abu Dawud","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":3147,"arabicnumber":3147,"text":"। মুহাম্মাদ ইবনু সীরীন (রহঃ) সূত্রে বর্ণিত। তিনি উম্মু আতিয়্যাহ (রাঃ)-এর নিকট গোসল দেয়ার পদ্ধতি শিখেছেন। মুহাম্মাদ (রহঃ) বলেন, কুলপাতা মিশানো গরম পানি দিয়ে দু’ বার এবং কর্পুর মিশ্রিত পানি দিয়ে একবার গোসল দিতে হয়।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":21,"hadith":59}}]}