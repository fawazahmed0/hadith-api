{"metadata":{"name":"Sunan Abu Dawud","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":3210,"arabicnumber":3210,"text":"। আবূ মারহাব (রহঃ) সূত্রে বর্ণিত। ‘আব্দুর রাহমান ইবনু আওফ (রাঃ)-ও নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর কবরে নেমেছিলেন। আমি যেন তাদের চারজনকে এখনো প্রত্যক্ষ করছি।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":21,"hadith":122}}]}