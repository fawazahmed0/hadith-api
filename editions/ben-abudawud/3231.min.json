{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":3231,"arabicnumber":3231,"text":"। আনাস (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যখন কোনো বান্দাকে কবরে রাখা হয়, অতঃপর তার সাথীরা সেখান থেকে চলে যেতে থাকে, তখন সে তাদের জুতার শব্দ শুনতে পায়।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (1338) Sahih Muslim (2870)"}],"reference":{"book":21,"hadith":143}}]}