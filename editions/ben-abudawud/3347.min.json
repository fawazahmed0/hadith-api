{"metadata":{"name":"Sunan Abu Dawud","section":{"23":"Commercial Transactions (Kitab Al-Buyu)"},"section_detail":{"23":{"hadithnumber_first":3326,"hadithnumber_last":3415,"arabicnumber_first":3326,"arabicnumber_last":3415,"name_native":"বাণিজ্যিক লেনদেন (কিতাব আল-বুয়ু)"}}},"hadiths":[{"hadithnumber":3347,"arabicnumber":3347,"text":"। মুহাবির ইবনু দিসার (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, আমি জাবির ইবনু ‘আব্দুল্লাহ (রাঃ)-কে বলতে শুনেছি, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর নিকট আমার কিছু পাওনা ছিলো। তিনি আমার পাওনা পরিশোধ করলেন এবং কিছু বেশী দিলেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (443) Sahih Muslim (715 After 1599)"}],"reference":{"book":23,"hadith":22}}]}