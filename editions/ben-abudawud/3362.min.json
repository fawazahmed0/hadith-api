{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"23":"Commercial Transactions (Kitab Al-Buyu)"},"section_detail":{"23":{"hadithnumber_first":3326,"hadithnumber_last":3415,"arabicnumber_first":3326,"arabicnumber_last":3415,"name_native":"বাণিজ্যিক লেনদেন (কিতাব আল-বুয়ু)"}}},"hadiths":[{"hadithnumber":3362,"arabicnumber":3362,"text":"। খারিজাহ ইবনু যায়িদ ইবনু সাবিত (রাঃ) থেকে তার পিতার সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ‘আরিয়া পদ্ধতিতে খুরমা ও খেজুর ক্রয়-বিক্রয়ের অনুমতি দিয়েছেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":23,"hadith":37}}]}