{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"মজুরি (কিতাব আল-ইজারাহ)"}}},"hadiths":[{"hadithnumber":3453,"arabicnumber":3453,"text":"। ইয়াহইয়া (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, সুফিয়ান সাওরী (রাঃ) ‘লাইসা মিন্না’-এর ব্যাখ্যা ‘আমাদের মতো নয়’ করাকে অপছন্দ করতেন।","grades":[{"name":"Al-Albani","grade":"Sahih Isnaad Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":24,"hadith":38}}]}