{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"মজুরি (কিতাব আল-ইজারাহ)"}}},"hadiths":[{"hadithnumber":3471,"arabicnumber":3471,"text":"। ‘আতা (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, ‘জায়িহাহ’ বলা হয় এমন প্রাকৃতিক দুর্যোগকে যাতে প্রকাশ্য ক্ষতিসাধন হয়ে থাকে। যেমন অতিবৃষ্টি, তুষারপাত, পঙ্গপালের আক্রমণ, ঝড়, অগ্নিকান্ড ইত্যাদি।","grades":[{"name":"Al-Albani","grade":"Hasan Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Maqtu"},{"name":"Shuaib Al Arnaut","grade":"Maqtu"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":24,"hadith":56}}]}