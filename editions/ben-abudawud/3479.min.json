{"metadata":{"name":"Sunan Abu Dawud","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"মজুরি (কিতাব আল-ইজারাহ)"}}},"hadiths":[{"hadithnumber":3479,"arabicnumber":3479,"text":"। জাবির ইবনু ‘আব্দুল্লাহ (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কুকুর ও বিড়ালের বিক্রয় মূল্য গ্রহণ করতে নিষিদ্ধ করেছেন।","grades":[{"name":"Al-Albani","grade":"Sahih Hadith"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":24,"hadith":64}}]}