{"metadata":{"name":"Sunan Abu Dawud","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"মজুরি (কিতাব আল-ইজারাহ)"}}},"hadiths":[{"hadithnumber":3483,"arabicnumber":3483,"text":"। আওন ইবনু আবূ জুহাইফাহ (রহঃ) সূত্রে বর্ণিত। তার পিতা বলেছেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কুকুরের মূল্য গ্রহণ করতে নিষেধ করেছেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":24,"hadith":68}}]}