{"metadata":{"name":"Sunan Abu Dawud","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"মজুরি (কিতাব আল-ইজারাহ)"}}},"hadiths":[{"hadithnumber":3487,"arabicnumber":3487,"text":"। ইয়াযীদ বিনু আবূ হাবীব (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, ‘আতা (রহঃ) জাবির (রাঃ) সূত্রে উপরোক্ত হাদীসের অনুরূপ হাদীস আমাকে লিখে পাঠালেন। তিনি তাতে ‘এটি হারাম’ কথাটুকু উল্লেখ করেননি।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (2236) Sahih Muslim (1581)"}],"reference":{"book":24,"hadith":72}}]}