{"metadata":{"name":"Sunan Abu Dawud","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"মজুরি (কিতাব আল-ইজারাহ)"}}},"hadiths":[{"hadithnumber":3491,"arabicnumber":3491,"text":"। আ‘মাশ (রহঃ) তার নিজস্ব সনদে একই অর্থে হাদীস বর্ণনা করেছেন। তিনি বলেন, (সূরা বাকারাহর) শেষের আয়াতগুলো সুদ (হারাম) সম্পর্কিত।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1580)"}],"reference":{"book":24,"hadith":76}}]}