{"metadata":{"name":"Sunan Abu Dawud","section":{"27":"Drinks (Kitab Al-Ashribah)"},"section_detail":{"27":{"hadithnumber_first":3669,"hadithnumber_last":3735,"arabicnumber_first":3669,"arabicnumber_last":3735,"name_native":"পানীয় অধ্যায়"}}},"hadiths":[{"hadithnumber":3701,"arabicnumber":3701,"text":"। শারীক (রহঃ) সূত্রে বর্ণিত। তিনি তার সনদে বর্ণনা করেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা নেশা উদ্রেককারী বস্তু বর্জন করো।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":27,"hadith":33}}]}