{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"28":"Foods (Kitab Al-At'imah)"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854,"name_native":"খাদ্য অধ্যায়"}}},"hadiths":[{"hadithnumber":3739,"arabicnumber":3739,"text":"। নাফি‘ (রহঃ) সূত্রে আইয়ূবের সনদে অনুরূপ অর্থের হাদীস বর্ণিত। আমি এটি সহীহ এবং যঈফেও পাইনি।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1429)"}],"reference":{"book":28,"hadith":4}}]}