{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"28":"Foods (Kitab Al-At'imah)"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854,"name_native":"খাদ্য অধ্যায়"}}},"hadiths":[{"hadithnumber":3744,"arabicnumber":3744,"text":"। আনাস ইবনু মালিক (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সাফিয়্যাহ (রাঃ)-এর বিবাহে খেজুর ও ছাতু দিয়ে ওয়ালিমা করেছেন।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":28,"hadith":9}}]}