{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"28":"Foods (Kitab Al-At'imah)"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854,"name_native":"খাদ্য অধ্যায়"}}},"hadiths":[{"hadithnumber":3776,"arabicnumber":3776,"text":"। ইবনু উমার (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তোমাদের কেউ খাওয়ার সময় যেন তার ডান হাতে খায় এবং যখন পান করে তখনও যেন তার ডান হাতে পান করে। কেননা শয়তান তার বাম হাতে পানাহার করে।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (2020)"}],"reference":{"book":28,"hadith":41}}]}