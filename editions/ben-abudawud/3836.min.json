{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"28":"Foods (Kitab Al-At'imah)"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854,"name_native":"খাদ্য অধ্যায়"}}},"hadiths":[{"hadithnumber":3836,"arabicnumber":3836,"text":"। আয়িশাহ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তাজা খেজুর দিয়ে তরমুজ খেতেন। তিনি বলতেনঃ এর ঠান্ডা ওটার গরম কমাবে এবং এর গরম ওটির ঠান্ডা কমিয়ে দিবে।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":28,"hadith":101}}]}