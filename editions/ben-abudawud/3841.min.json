{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"28":"Foods (Kitab Al-At'imah)"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854,"name_native":"খাদ্য অধ্যায়"}}},"hadiths":[{"hadithnumber":3841,"arabicnumber":3841,"text":"। মাইমূনাহ (রাঃ) সূত্রে বর্ণিত। একটি ইঁদুর ঘিয়ের মধ্যে পড়ে গেলে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে তা জানানো হলো। তিনি বললেনঃ এর চারপাশের ঘি ফেলে দিয়ে অবশিষ্ট ঘি খাও।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (5538)"}],"reference":{"book":28,"hadith":106}}]}