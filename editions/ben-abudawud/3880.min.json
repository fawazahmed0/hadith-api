{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"29":"Medicine (Kitab Al-Tibb)"},"section_detail":{"29":{"hadithnumber_first":3855,"hadithnumber_last":3903,"arabicnumber_first":3855,"arabicnumber_last":3903,"name_native":"চিকিৎসা অধ্যায়"}}},"hadiths":[{"hadithnumber":3880,"arabicnumber":3880,"text":"। আয়িশাহ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, বদনযরকারীকে নির্দেশ দেয়া হতো যেন সে উযু করে এবং সেই পানি দিয়ে নযর লাগা ব্যক্তি বা বস্তু ধুয়ে নেয়।[1] সনদ সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":29,"hadith":26}}]}