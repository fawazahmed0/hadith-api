{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"33":"Hot Baths (Kitab Al-Hammam)"},"section_detail":{"33":{"hadithnumber_first":4009,"hadithnumber_last":4019,"arabicnumber_first":4009,"arabicnumber_last":4019,"name_native":"গরম গোসল (কিতাব আল-হাম্মাম)"}}},"hadiths":[{"hadithnumber":4013,"arabicnumber":4013,"text":"। সাফওয়ান ইবনু ইয়া‘লা (রহঃ) তাঁর পিতার সূত্রে এ হাদীস নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণনা করেন। ইমাম আবূ দাঊদ (রহঃ) বলেন, প্রথম বর্ণনাটি পূর্ণাঙ্গ।[1] হাসান।","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":33,"hadith":5}}]}