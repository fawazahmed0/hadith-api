{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":403,"arabicnumber":403,"text":"। জাবির ইবনু সামুরাহ (রাঃ) সূত্রে বর্ণিত। সূর্য (পশ্চিম আকাশে) ঢলে পড়লে বিলাল (রাঃ) যুহরের সালাতের আযান দিতেন। [1] হাসান সহীহ : মুসলিম।","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih Sahih Muslim"}],"reference":{"book":2,"hadith":13}}]}