{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"34":"Clothing (Kitab Al-Libas)"},"section_detail":{"34":{"hadithnumber_first":4020,"hadithnumber_last":4158,"arabicnumber_first":4020,"arabicnumber_last":4158,"name_native":"পোষাক-পরিচ্ছদ অধ্যায়"}}},"hadiths":[{"hadithnumber":4109,"arabicnumber":4109,"text":"। আয়িশাহ (রাঃ) সূত্রে অনুরূপ হাদীস বর্ণিত। এতে আরো রয়েছেঃ ‘‘তিনি (সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম) তাকে আল-বায়দা নামক স্থানে পাঠিয়ে দিলেন। এরপর সে (হিজড়া) প্রতি শুক্রবার খাদ্যের জন্য শহরে আসতো।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":34,"hadith":90}}]}