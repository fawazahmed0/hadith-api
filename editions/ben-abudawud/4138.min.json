{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"34":"Clothing (Kitab Al-Libas)"},"section_detail":{"34":{"hadithnumber_first":4020,"hadithnumber_last":4158,"arabicnumber_first":4020,"arabicnumber_last":4158,"name_native":"পোষাক-পরিচ্ছদ অধ্যায়"}}},"hadiths":[{"hadithnumber":4138,"arabicnumber":4138,"text":"। ইবনু আব্বাস (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, সুন্নাত হলো বসার সময় পায়ের জুতা খুলে পাশে রেখে দেয়া।[1] সনদ দুর্বল।","grades":[{"name":"Al-Albani","grade":"Daif Isnaad"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":34,"hadith":119}}]}