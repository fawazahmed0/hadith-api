{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"34":"Clothing (Kitab Al-Libas)"},"section_detail":{"34":{"hadithnumber_first":4020,"hadithnumber_last":4158,"arabicnumber_first":4020,"arabicnumber_last":4158,"name_native":"পোষাক-পরিচ্ছদ অধ্যায়"}}},"hadiths":[{"hadithnumber":4142,"arabicnumber":4142,"text":"। জাবির ইবনু আব্দুল্লাহ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহন সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বিছানা সম্পর্কে বলেনঃ পুরুষের জন্য একটি বিছানা, নারীর জন্য একটি বিছানা এবং একটি অতিথির জন্য। আর চতুর্থটি হলো শয়তানের জন্য।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (2084)"}],"reference":{"book":34,"hadith":123}}]}