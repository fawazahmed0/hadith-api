{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"36":"Signet-Rings (Kitab Al-Khatam)"},"section_detail":{"36":{"hadithnumber_first":4214,"hadithnumber_last":4239,"arabicnumber_first":4214,"arabicnumber_last":4239,"name_native":"সিগনেট-রিং (কিতাব আল-খাতাম)"}}},"hadiths":[{"hadithnumber":4228,"arabicnumber":4228,"text":"। নাফি (রহঃ) সূত্রে বর্ণিত। ইবনু উমার (রাঃ) তার বাম হাতে আংটি পরতেন।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":36,"hadith":15}}]}