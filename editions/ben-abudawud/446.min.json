{"metadata":{"name":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":446,"arabicnumber":446,"text":"। নাজ্জাশীর ভ্রাতুষ্পুত্র যু-মিখবার (রাঃ) সূত্রে বর্ণিত। তিনি অনুরূপ ঘটনার বর্ণনাতে বলেন, অতঃপর বিলাল কোনরূপ তাড়াহুড়া না করে ধীরেসুস্থে আযান দিলেন।[1] শায।","grades":[{"name":"Al-Albani","grade":"Shadh"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Shadh"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":2,"hadith":56}}]}