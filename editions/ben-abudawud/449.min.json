{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":449,"arabicnumber":449,"text":"। আনাস (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ লোকেরা মাসজিদ নিয়ে পরস্পর গৌরব ও অহঙ্কারে মেতে না উঠা পর্যন্ত ক্বিয়ামাত (কিয়ামত) সংঘটিত হবে না।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":2,"hadith":59}}]}