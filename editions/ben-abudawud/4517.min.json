{"metadata":{"name":"Sunan Abu Dawud","section":{"41":"Types of Blood-Wit (Kitab Al-Diyat)"},"section_detail":{"41":{"hadithnumber_first":4494,"hadithnumber_last":4595,"arabicnumber_first":4494,"arabicnumber_last":4595,"name_native":"দিয়ত (রক্তপণ) অধ্যায়"}}},"hadiths":[{"hadithnumber":4517,"arabicnumber":4517,"text":"। কাতাদাহ (রহঃ) থেকে শু‘বাহ (রহঃ) সূত্রে পূর্বোক্ত হাদীসের অনুরূপ বর্ণিত। এতে আরো রয়েছেঃ পরবর্তীতে আল-হাসান (রহঃ) হাদীসটি ভুলে যান। তাই তিনি বলতেন, গোলাম হত্যার অপরাধে স্বাধীন ব্যক্তিকে হত্যা করা যাবে না।[1] সহীহ মাকতু।","grades":[{"name":"Al-Albani","grade":"Sahih Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Maqtu"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":41,"hadith":24}}]}