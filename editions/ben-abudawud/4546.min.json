{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"41":"Types of Blood-Wit (Kitab Al-Diyat)"},"section_detail":{"41":{"hadithnumber_first":4494,"hadithnumber_last":4595,"arabicnumber_first":4494,"arabicnumber_last":4595,"name_native":"দিয়ত (রক্তপণ) অধ্যায়"}}},"hadiths":[{"hadithnumber":4546,"arabicnumber":4546,"text":"। ইবনু আব্বাস (রাঃ) সূত্রে বর্ণিত। বনী আদীর এক ব্যক্তি নিহত হলে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তার দিয়াত নির্ধারণ করেন বারো হাজার দিরহাম।[1] দুর্বলঃ ইরওয়াহ হা/ ২২৪৫।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":41,"hadith":53}}]}