{"metadata":{"name":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":475,"arabicnumber":475,"text":"। আনাস ইবনু মালিক (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ মসজিদে থু থু ফেলা অপরাধ। এর কাফফারা হলো মাটি দিয়ে তা ঢেকে ফেলা অর্থাৎ তা মুছে দিবে।[1] সহীহ : বুখারী ও মুসলিম।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (552)"}],"reference":{"book":2,"hadith":85}}]}