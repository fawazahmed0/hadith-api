{"metadata":{"name":"Sunan Abu Dawud","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"সাধারণ আচরণ (কিতাব আল-আদাব)"}}},"hadiths":[{"hadithnumber":4822,"arabicnumber":4822,"text":"। কাইস (রাঃ) থেকে তার পিতার সূত্রে বর্ণিত। তিনি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর খুৎবা দেয়া অবস্থায় রোদে এসে দাঁড়ালেন। তখন তিনি তাকে আদেশ দিলে তাকে ছায়ায় আনা হয়।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":43,"hadith":50}}]}