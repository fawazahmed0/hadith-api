{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"সাধারণ আচরণ (কিতাব আল-আদাব)"}}},"hadiths":[{"hadithnumber":4894,"arabicnumber":4894,"text":"। আবূ হুরাইরাহ (রাঃ) সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ পরস্পর তিরস্কারকারীর মধ্যে যে প্রথমে আরম্ভ করে উভয়ের দোষ তার উপর বর্তাবে, যতক্ষণ না অপরজন সীমালঙ্ঘন করে।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (2587)"}],"reference":{"book":43,"hadith":122}}]}