{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"সাধারণ আচরণ (কিতাব আল-আদাব)"}}},"hadiths":[{"hadithnumber":4987,"arabicnumber":4987,"text":"। আয়িশাহ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে দ্বীনের সঙ্গে সম্পৃক্ত করা ছাড়া অন্যভাবে কারো পরিচয় দিতে শুনিনি।[1] সনদ দুর্বল।","grades":[{"name":"Al-Albani","grade":"Daif Isnaad"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":43,"hadith":215}}]}