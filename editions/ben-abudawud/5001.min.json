{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"সাধারণ আচরণ (কিতাব আল-আদাব)"}}},"hadiths":[{"hadithnumber":5001,"arabicnumber":5001,"text":"। উসমান ইবনু আবুল আতিকাহ বলেন, তাঁবুর পরিধি সংকীর্ণ হওয়ায় ‘আওফ (রাঃ) কৌতুক করে বলেছিলেন, আমার পুরো শরীরসহ প্রবেশ করবো?[1] সনদ যঈফ মাকতু।","grades":[{"name":"Al-Albani","grade":"Daif Isnaad Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":43,"hadith":229}}]}