{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":509,"arabicnumber":509,"text":"। আনাস (রাঃ) সূত্রে পূর্বোক্ত হাদীসের অনুরূপ বর্ণিত আছে। ইসমাঈল বলেন, আমি এ হাদীস আইউবের নিকট বর্ণনা করলে তিনি বলেন, কিন্তু ক্বাদ ক্বামাতিস্ সলাহ (বাক্যটি জোড় সংখ্যায় বলবে)।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (607) Sahih Muslim (378)"}],"reference":{"book":2,"hadith":119}}]}