{"metadata":{"name":"Sunan Abu Dawud","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"সাধারণ আচরণ (কিতাব আল-আদাব)"}}},"hadiths":[{"hadithnumber":5101,"arabicnumber":5101,"text":"। যায়িদ ইবনু খালিদ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা মোরগকে গালি দিও না। কারণ সে সালাতের জন্য জাগায়।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":43,"hadith":329}}]}