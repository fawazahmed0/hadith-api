{"metadata":{"name":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":586,"arabicnumber":586,"text":"। ‘আমর ইবনু সালামাহ্ (রাঃ) থেকে একই হাদীসে বর্ণিত আছে, আমি একটি তালিযুক্ত চাদর গায়ে দিয়ে তাদের ইমামিত করতাম। চাদরটি ছেঁড়া থাকায় সিজদায় গমনকালে আমার নিতম্ব উন্মুক্ত হয়ে যেত।[1] সহীহ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":2,"hadith":196}}]}