{"metadata":{"name":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":754,"arabicnumber":754,"text":"। ‘আবদুর রহমান সূত্রে বর্ণিত। তিনি বলেন, আমি ইবনুয যুবায়ির (রাঃ)-কে বলতে শুনেছি, সালাতে দুই পা সমান রাখা এবং এক হাতের উপর অপর হাত রাখা সুন্নাত।[1] দুর্বল।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":2,"hadith":364}}]}