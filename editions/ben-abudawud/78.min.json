{"metadata":{"name":"Sunan Abu Dawud","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"পবিত্রতা অধ্যায়"}}},"hadiths":[{"hadithnumber":78,"arabicnumber":78,"text":"। উম্মু সুবাইয়্যাহ আল-জুহানিয়্যাহ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, একই পাত্রে অযু করার সময় আমার ও রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর হাত একত্রে উঠানামা করত।[1] হাসান সহীহ।","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":1,"hadith":78}}]}