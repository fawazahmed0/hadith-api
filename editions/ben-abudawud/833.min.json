{"metadata":{"name":"Sunan Abu Dawud","name_native":"সুনান আবু দাউদ","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":833,"arabicnumber":833,"text":"। জাবির ইবনু ‘আব্দুল্লাহ (রাঃ) সুত্রে বর্ণিত। তিনি বলেন, আমরা নফল সালাতে দাঁড়ানো ও বসা অবস্থায় দু‘আ করতাম এবং রুকূ‘ ও সিজদা্ অবস্থায় তাসবীহ পড়তাম।[1] দুর্বল মাওকূফ।","grades":[{"name":"Al-Albani","grade":"Daif Muquf"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Muquf"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":2,"hadith":443}}]}