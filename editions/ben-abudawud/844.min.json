{"metadata":{"name":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":844,"arabicnumber":844,"text":"। মালিক ইবনুল হুওয়াইরিস (রাঃ) সূত্রে বর্ণিত। তিনি দেখেছেন যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সালাতের বিজোড় রাক‘আত সমূহে সোজা হয়ে না বসা পর্যন্ত দাঁড়াতেন না।[1] সহীহ : বুখারী।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (823)"}],"reference":{"book":2,"hadith":454}}]}