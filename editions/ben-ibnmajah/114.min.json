{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"সুন্নাহ অধ্যায়"}}},"hadiths":[{"hadithnumber":114,"arabicnumber":114,"text":"। আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, উম্মী নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে অবগত করলেন যে, মুমিন ব্যাক্তিরাই আমাকে ভালবাসবে এবং মুনাফিকরাই আমার প্রতি বিদ্বেষ পোষণ করবে।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":0,"hadith":114}}]}