{"metadata":{"name":"Sunan Ibn Majah","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"সুন্নাহ অধ্যায়"}}},"hadiths":[{"hadithnumber":118,"arabicnumber":118,"text":"। ইবনু উমার থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ হাসান ও হুসায়ন জান্নাতী যুবকদের নেতা এবং তাদের পিতা তাদের চেয়ে শ্রেষ্ঠ হবে।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":0,"hadith":118}}]}