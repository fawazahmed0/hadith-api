{"metadata":{"name":"Sunan Ibn Majah","section":{"5":"Establishing the Prayer and the Sunnah Regarding Them"},"section_detail":{"5":{"hadithnumber_first":803,"hadithnumber_last":1432,"arabicnumber_first":803,"arabicnumber_last":1432,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":1324,"arabicnumber":1324,"text":"। আবূ সাঈদ (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ প্রতি দু রাকআত অন্তর একবার সালাম ফিরাবে।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":5,"hadith":522}}]}