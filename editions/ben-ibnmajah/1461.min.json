{"metadata":{"name":"Sunan Ibn Majah","section":{"6":"Chapters Regarding Funerals"},"section_detail":{"6":{"hadithnumber_first":1433,"hadithnumber_last":1637,"arabicnumber_first":1433,"arabicnumber_last":1637,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":1461,"arabicnumber":1461,"text":"। ‘আবদুল্লাহ্ ইবনু ‘উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা তোমাদের মৃতদের আমানতের সাথে (গোপনীয় অঙ্গসমূহ যথাসম্ভব ঢেকে রেখে) গোসল দাও।","grades":[{"name":"Al-Albani","grade":"Mawdu"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Mawdu"},{"name":"Shuaib Al Arnaut","grade":"Mawdu"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":6,"hadith":29}}]}