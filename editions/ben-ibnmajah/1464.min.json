{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"6":"Chapters Regarding Funerals"},"section_detail":{"6":{"hadithnumber_first":1433,"hadithnumber_last":1637,"arabicnumber_first":1433,"arabicnumber_last":1637,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":1464,"arabicnumber":1464,"text":"। ‘আয়িশাহ্ (রাঃ) থেকে বর্ণিত। তিনি বলেন, যা আমি পরে অবগত হয়েছি, তা যদি পূর্বে অবহিত হতে পারতাম, তাহলে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে তাঁর স্ত্রীগণ ব্যতীত আর কেউ গোসল দিতে পারতো না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":6,"hadith":32}}]}