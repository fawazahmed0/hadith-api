{"metadata":{"name":"Sunan Ibn Majah","section":{"6":"Chapters Regarding Funerals"},"section_detail":{"6":{"hadithnumber_first":1433,"hadithnumber_last":1637,"arabicnumber_first":1433,"arabicnumber_last":1637,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":1473,"arabicnumber":1473,"text":"। উবাদাহ ইবনুুস সামিত (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ উত্তম কাফন হলো হুল্লাহ (চাদর)।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":6,"hadith":41}}]}