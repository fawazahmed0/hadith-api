{"metadata":{"name":"Sunan Ibn Majah","section":{"6":"Chapters Regarding Funerals"},"section_detail":{"6":{"hadithnumber_first":1433,"hadithnumber_last":1637,"arabicnumber_first":1433,"arabicnumber_last":1637,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":1479,"arabicnumber":1479,"text":"। আবূ মূসা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একটি লাশ তাড়াহুড়া করে নিয়ে যেতে দেখে বলেনঃ তোমরা যেন শান্তভাবে যাও।","grades":[{"name":"Al-Albani","grade":"Munkar"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Munkar"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":6,"hadith":47}}]}