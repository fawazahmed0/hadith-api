{"metadata":{"name":"Sunan Ibn Majah","section":{"6":"Chapters Regarding Funerals"},"section_detail":{"6":{"hadithnumber_first":1433,"hadithnumber_last":1637,"arabicnumber_first":1433,"arabicnumber_last":1637,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":1603,"arabicnumber":1603,"text":"। আবূ হুরাইরাহ (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ কোন ব্যক্তির তিনটি সন্তান মারা গেলে সে জাহান্নাম পার হয়ে যাবে, তবে শপথ পূর্ণ না করার জন্য (শাস্তি পাবে)।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}],"reference":{"book":6,"hadith":171}}]}