{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"সুন্নাহ অধ্যায়"}}},"hadiths":[{"hadithnumber":166,"arabicnumber":166,"text":"। ইবনু আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে তাঁর বুকের সাথে জড়িয়ে ধরে বললেনঃ হে আল্লাহ! তাকে প্রজ্ঞা ও কুরআনের তাৎপর্য জ্ঞান দান করুন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":0,"hadith":166}}]}