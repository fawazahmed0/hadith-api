{"metadata":{"name":"Sunan Ibn Majah","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"সিয়াম (রোজা) অধ্যায়"}}},"hadiths":[{"hadithnumber":1697,"arabicnumber":1697,"text":"। সাহল ইবনু সা‘দ (রাঃ) থেকে বর্ণিত। তিনি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ মানুষ কল্যাণের সাথে থাকবে, যাবত তারা জলদি(যথাসময়ে) ইফতার করতে থাকবে।","grades":[{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}],"reference":{"book":7,"hadith":60}}]}