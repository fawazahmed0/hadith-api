{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"8":"The Chapters Regarding Zakat"},"section_detail":{"8":{"hadithnumber_first":1783,"hadithnumber_last":1844,"arabicnumber_first":1783,"arabicnumber_last":1844,"name_native":"যাকাত অধ্যায়"}}},"hadiths":[{"hadithnumber":1819,"arabicnumber":1819,"text":"। আত্তাব ইবনু উসাইদ (বা উসাইদ) (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম লোকেদের আঙ্গুর ও অন্যান্য ফলের পরিমাণ অনুমান করে নির্ধারণের জন্য লোক পাঠাতেন।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":8,"hadith":37}}]}