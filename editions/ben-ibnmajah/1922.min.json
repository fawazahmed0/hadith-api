{"metadata":{"name":"Sunan Ibn Majah","section":{"9":"The Chapters on Marriage"},"section_detail":{"9":{"hadithnumber_first":1845,"hadithnumber_last":2015,"arabicnumber_first":1845,"arabicnumber_last":2015,"name_native":"নিকাহ (বিয়ে) অধ্যায়"}}},"hadiths":[{"hadithnumber":1922,"arabicnumber":1922,"text":"। ‘আয়িশাহ্ (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি কখনও রসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর লজ্জাস্থানের দিকে তাকাইনি বা তা দেখিনি।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":9,"hadith":78}}]}