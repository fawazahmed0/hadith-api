{"metadata":{"name":"Sunan Ibn Majah","section":{"9":"The Chapters on Marriage"},"section_detail":{"9":{"hadithnumber_first":1845,"hadithnumber_last":2015,"arabicnumber_first":1845,"arabicnumber_last":2015,"name_native":"নিকাহ (বিয়ে) অধ্যায়"}}},"hadiths":[{"hadithnumber":1994,"arabicnumber":1994,"text":"। সাহল ইবনু সা‘দ (রাঃ) থেকে বর্ণিত। রসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ কুলক্ষণ বলতে কিছু থাকলে তা ঘোড়া, স্ত্রীলোক ও ঘরেই থাকতো।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}],"reference":{"book":9,"hadith":150}}]}