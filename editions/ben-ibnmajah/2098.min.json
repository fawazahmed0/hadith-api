{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"11":"The Chapters on Expiation"},"section_detail":{"11":{"hadithnumber_first":2090,"hadithnumber_last":2136,"arabicnumber_first":2090,"arabicnumber_last":2136,"name_native":"কাফফারা অধ্যায়"}}},"hadiths":[{"hadithnumber":2098,"arabicnumber":2098,"text":"। সাবিত ইবনুল দাহহাক (রাঃ) থেকে বর্ণিত। তিনি বলেন, রসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে ব্যক্তি স্বেচ্ছায় দীন ইসলাম ব্যতীত অন্য ধর্মের মিথ্যা শপথ করলো, সে যেরূপ বলেছে সে তদ্রূপ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":11,"hadith":9}}]}