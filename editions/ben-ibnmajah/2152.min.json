{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"ব্যবসায়িক লেনদেনের অধ্যায়"}}},"hadiths":[{"hadithnumber":2152,"arabicnumber":2152,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ লোকেদের মধ্যে অধিক মিথ্যাবাদী হলো কাপড়ে রংকারী ও অংলকার নির্মাতারা।","grades":[{"name":"Al-Albani","grade":"Mawdu"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Mawdu"},{"name":"Shuaib Al Arnaut","grade":"Mawdu"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":12,"hadith":16}}]}