{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"ব্যবসায়িক লেনদেনের অধ্যায়"}}},"hadiths":[{"hadithnumber":2189,"arabicnumber":2189,"text":"। আত্তাব ইবনে আসীদ (উসাউদ) (রাঃ) থেকে বর্ণিত। তিনি বলেন যে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন তাকে মক্কায় পাঠান তখন তাকে (লোকসানের) ঝুঁকি বহন না করা পর্যন্ত মুনাফা গ্রহণ করতে নিষেধ করেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":12,"hadith":53}}]}