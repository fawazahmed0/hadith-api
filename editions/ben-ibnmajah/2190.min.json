{"metadata":{"name":"Sunan Ibn Majah","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"ব্যবসায়িক লেনদেনের অধ্যায়"}}},"hadiths":[{"hadithnumber":2190,"arabicnumber":2190,"text":"। ‘উকবা উবনে ‘আমের অথবা সামুরা ইবনে জুনদুর (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ কোন ব্যক্তি কোন জিনিস পরপর দু’জন ক্রেতার নিকট বিক্রয় করলে তা প্রথম ক্রেতা পাবে।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":12,"hadith":54}}]}