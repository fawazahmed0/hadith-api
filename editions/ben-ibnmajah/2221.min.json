{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"ব্যবসায়িক লেনদেনের অধ্যায়"}}},"hadiths":[{"hadithnumber":2221,"arabicnumber":2221,"text":"। মালেক আবূ সাওয়ান ইবনে ইমায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর হিজরতের পূর্বে আমি তাঁর নিকট একটি পাজামা বিক্রয় করেছিলাম। তিনি ওযন করে দিলেন এবং আমাকে কিছু বেশীই দিলেন।","grades":[{"name":"Al-Albani","grade":"Sahih Hadith"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":12,"hadith":85}}]}