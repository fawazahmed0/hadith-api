{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"ব্যবসায়িক লেনদেনের অধ্যায়"}}},"hadiths":[{"hadithnumber":2222,"arabicnumber":2222,"text":"। জাবির ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা যখন ওযন করে দিবে, তখন একটু বেশীই দিবে।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":12,"hadith":86}}]}