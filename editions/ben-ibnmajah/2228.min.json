{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"ব্যবসায়িক লেনদেনের অধ্যায়"}}},"hadiths":[{"hadithnumber":2228,"arabicnumber":2228,"text":"। জাবির (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহসাল্লাল্লাহু আলাইহি ওয়াসাল্লাম খাদ্যশস্য দু’বার ওজন না দেয়া পর্যন্ত তা বিক্রয় করতে নিষেধ করেছেন। একটি হলো বিক্রেতার ওজন, অপরটি হলো ক্রেতার ওজন।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":12,"hadith":92}}]}