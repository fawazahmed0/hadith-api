{"metadata":{"name":"Sunan Ibn Majah","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"ব্যবসায়িক লেনদেনের অধ্যায়"}}},"hadiths":[{"hadithnumber":2244,"arabicnumber":2244,"text":"। সামুরা ইবনে জুনদুব (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ গোলাম ফেরত দেওয়ার সময়সীমা তিন দিন।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":12,"hadith":108}}]}