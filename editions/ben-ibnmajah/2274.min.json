{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"ব্যবসায়িক লেনদেনের অধ্যায়"}}},"hadiths":[{"hadithnumber":2274,"arabicnumber":2274,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ সুদের গুনাহর সত্তরটি স্তর রয়েছে। তার মধ্যে সবচেয়ে ক্ষুদ্র স্তর হলো আপন মাকে বিবাহ (যেনা) করা।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":12,"hadith":138}}]}