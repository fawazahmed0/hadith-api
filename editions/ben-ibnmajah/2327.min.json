{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"13":"The Chapters on Rulings"},"section_detail":{"13":{"hadithnumber_first":2308,"hadithnumber_last":2374,"arabicnumber_first":2308,"arabicnumber_last":2374,"name_native":"বিধিবিধানের অধ্যায়"}}},"hadiths":[{"hadithnumber":2327,"arabicnumber":2327,"text":"। বারাআ ইবনে আযেব (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ইহূদী সম্প্রদায়ের এক পন্ডিত ব্যক্তিকে ডেকে বলেনঃ আমি তোমাকে সেই মহান সত্তার শপথ করে বলছি যিনি মূসা (রাঃ)-এর উপর তাওরাত কিতাব নাযিল করেছেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":13,"hadith":20}}]}