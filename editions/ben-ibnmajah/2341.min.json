{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"13":"The Chapters on Rulings"},"section_detail":{"13":{"hadithnumber_first":2308,"hadithnumber_last":2374,"arabicnumber_first":2308,"arabicnumber_last":2374,"name_native":"বিধিবিধানের অধ্যায়"}}},"hadiths":[{"hadithnumber":2341,"arabicnumber":2341,"text":"। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ ক্ষতি করাও যাবে না, ক্ষতি সহাও যাবে না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":13,"hadith":34}}]}