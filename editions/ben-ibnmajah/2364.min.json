{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"13":"The Chapters on Rulings"},"section_detail":{"13":{"hadithnumber_first":2308,"hadithnumber_last":2374,"arabicnumber_first":2308,"arabicnumber_last":2374,"name_native":"বিধিবিধানের অধ্যায়"}}},"hadiths":[{"hadithnumber":2364,"arabicnumber":2364,"text":"। যায়েদ ইবনে খালিত আল-জুহানী (রাঃ) বলেন, তিনি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলতে শুনেছেনঃ সাক্ষীগণের মধ্যে উত্তম সেই ব্যক্তি, যে তলব করার আগেই সাক্ষ্য দেয়।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":13,"hadith":57}}]}