{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"15":"The Chapters on Charity"},"section_detail":{"15":{"hadithnumber_first":2390,"hadithnumber_last":2528,"arabicnumber_first":2390,"arabicnumber_last":2528,"name_native":"দাতব্য অধ্যায়"}}},"hadiths":[{"hadithnumber":2390,"arabicnumber":2390,"text":"। উমার ইবনুল খাত্তাব (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তুমি তোমার কৃত দান ফেরত নিও না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":15,"hadith":1}}]}