{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"18":"The Chapters on Lost Property"},"section_detail":{"18":{"hadithnumber_first":2502,"hadithnumber_last":2511,"arabicnumber_first":2502,"arabicnumber_last":2511,"name_native":"হারানো সম্পত্তি অধ্যায়"}}},"hadiths":[{"hadithnumber":2509,"arabicnumber":2509,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ খনিজ সম্পদের এক-পঞ্চমাংশ (রাষ্ট্রের) প্রাপ্য।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":18,"hadith":8}}]}