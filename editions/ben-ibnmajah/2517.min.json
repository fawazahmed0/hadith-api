{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"19":"The Chapters on Manumission (of Slaves)"},"section_detail":{"19":{"hadithnumber_first":2512,"hadithnumber_last":2532,"arabicnumber_first":2512,"arabicnumber_last":2532,"name_native":"ম্যানুমিশনের অধ্যায় (দাসদের)"}}},"hadiths":[{"hadithnumber":2517,"arabicnumber":2517,"text":"। জাবির ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদের মাঝে জীবিত থাকা অবস্থায় আমরা আমাদের যুদ্ধবন্দিনী ক্রীতদাসী ও উম্মু ওয়ালাদ বিক্রয় করতাম। আমরা এটাকে দূষণীয় মনে করতাম না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":19,"hadith":6}}]}