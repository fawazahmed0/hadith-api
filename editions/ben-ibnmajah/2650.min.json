{"metadata":{"name":"Sunan Ibn Majah","section":{"21":"The Chapters on Blood Money"},"section_detail":{"21":{"hadithnumber_first":2615,"hadithnumber_last":2694,"arabicnumber_first":2615,"arabicnumber_last":2694,"name_native":"দিয়ত (রক্তপণ) অধ্যায়"}}},"hadiths":[{"hadithnumber":2650,"arabicnumber":2650,"text":"। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ সব দাঁতের মূল্য ও মর্যাদা সমান। সামনের দাঁত ও মাড়ির দাঁত (দিয়াতের ক্ষেত্রে) এক সমান।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":21,"hadith":36}}]}