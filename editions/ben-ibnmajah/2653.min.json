{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"21":"The Chapters on Blood Money"},"section_detail":{"21":{"hadithnumber_first":2615,"hadithnumber_last":2694,"arabicnumber_first":2615,"arabicnumber_last":2694,"name_native":"দিয়ত (রক্তপণ) অধ্যায়"}}},"hadiths":[{"hadithnumber":2653,"arabicnumber":2653,"text":"। ‘আমর ইবনে শু‘আইব (রাঃ) থেকে পর্যায়ক্রমে তার পিতা ও তার দাদার সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ সবগুলো আঙ্গুল (দিয়াত) সমান। প্রতিটি আঙ্গুলের দিয়াত দশটি করে উট।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":21,"hadith":39}}]}