{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"21":"The Chapters on Blood Money"},"section_detail":{"21":{"hadithnumber_first":2615,"hadithnumber_last":2694,"arabicnumber_first":2615,"arabicnumber_last":2694,"name_native":"দিয়ত (রক্তপণ) অধ্যায়"}}},"hadiths":[{"hadithnumber":2662,"arabicnumber":2662,"text":"। উমার ইবনুল খাত্তাব (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে বলতে শুনেছিঃ সন্তান হত্যার অপরাধে পিতাকে হত্যা করা যাবে না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":21,"hadith":48}}]}