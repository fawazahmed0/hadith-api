{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"21":"The Chapters on Blood Money"},"section_detail":{"21":{"hadithnumber_first":2615,"hadithnumber_last":2694,"arabicnumber_first":2615,"arabicnumber_last":2694,"name_native":"দিয়ত (রক্তপণ) অধ্যায়"}}},"hadiths":[{"hadithnumber":2671,"arabicnumber":2671,"text":"। খাশখাশ আল-আনবারী (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি আমার এক পুত্রসহ নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কাছে এলাম। তিনি বলেনঃ তোমার অপরাধের প্রতিশোধ তার থেকে নেয়া যাবে না এবং তার অপরাধের প্রতিশোধ তোমার থেকে নেয়া যাবে না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":21,"hadith":57}}]}