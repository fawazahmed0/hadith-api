{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"21":"The Chapters on Blood Money"},"section_detail":{"21":{"hadithnumber_first":2615,"hadithnumber_last":2694,"arabicnumber_first":2615,"arabicnumber_last":2694,"name_native":"দিয়ত (রক্তপণ) অধ্যায়"}}},"hadiths":[{"hadithnumber":2684,"arabicnumber":2684,"text":"। মা‘কিল ইবনে ইয়াসার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ মুসলিমগণ অন্যদের (বিজাতীয় শত্রুর) বিরুদ্ধে একটি হাতস্বরূপ। তাদের জীবনের মূল্য এক সমান।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":21,"hadith":70}}]}