{"metadata":{"name":"Sunan Ibn Majah","section":{"23":"Chapters on Shares of Inheritance"},"section_detail":{"23":{"hadithnumber_first":2719,"hadithnumber_last":2752,"arabicnumber_first":2719,"arabicnumber_last":2752,"name_native":"ফারায়েজ (উত্তরাধিকার) অধ্যায়"}}},"hadiths":[{"hadithnumber":2723,"arabicnumber":2723,"text":"। মাকিল ইবনে ইয়াসার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদের মধ্যেকার দাদাকে এক-যষ্ঠাংশ ওয়ারিসী স্বত্ব প্রদানের নির্দেশ দিলেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":23,"hadith":5}}]}