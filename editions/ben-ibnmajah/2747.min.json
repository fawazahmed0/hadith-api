{"metadata":{"name":"Sunan Ibn Majah","section":{"23":"Chapters on Shares of Inheritance"},"section_detail":{"23":{"hadithnumber_first":2719,"hadithnumber_last":2752,"arabicnumber_first":2719,"arabicnumber_last":2752,"name_native":"ফারায়েজ (উত্তরাধিকার) অধ্যায়"}}},"hadiths":[{"hadithnumber":2747,"arabicnumber":2747,"text":"। ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ওয়ালাআ স্বত্ব বিক্রয় বা হেবা করতে নিষেধ করেছেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":23,"hadith":29}}]}