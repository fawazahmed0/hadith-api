{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"24":"The Chapters on Jihad"},"section_detail":{"24":{"hadithnumber_first":2753,"hadithnumber_last":2881,"arabicnumber_first":2753,"arabicnumber_last":2881,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2797,"arabicnumber":2797,"text":"। সাহল ইবনে হুনাইফ (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি সর্বান্তঃকরণে সত্যিকারভাবে আল্লাহর নিকট শাহাদাত কামনা করবে, আল্লাহ তাকে শহীদদের মর্যাদা দান করবেন, যদিও সে তার বিছানায় মারা যায়।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":24,"hadith":45}}]}