{"metadata":{"name":"Sunan Ibn Majah","section":{"24":"The Chapters on Jihad"},"section_detail":{"24":{"hadithnumber_first":2753,"hadithnumber_last":2881,"arabicnumber_first":2753,"arabicnumber_last":2881,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2805,"arabicnumber":2805,"text":"। আনাস ইবনে মালেক (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মক্কা বিজয়ের দিন শিরস্ত্রাণ পরিহিত অবস্থায় মক্কায় প্রবেশ করেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":24,"hadith":53}}]}