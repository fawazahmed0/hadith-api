{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"24":"The Chapters on Jihad"},"section_detail":{"24":{"hadithnumber_first":2753,"hadithnumber_last":2881,"arabicnumber_first":2753,"arabicnumber_last":2881,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2825,"arabicnumber":2825,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে বিদায় দিয়ে বলেনঃ আমি তোমাকে আল্লাহর আমানতে সোপর্দ করলাম, যাঁর নিকট সোপর্দকৃত জিনিস ধ্বংস হয় না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":24,"hadith":73}}]}