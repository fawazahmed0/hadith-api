{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"24":"The Chapters on Jihad"},"section_detail":{"24":{"hadithnumber_first":2753,"hadithnumber_last":2881,"arabicnumber_first":2753,"arabicnumber_last":2881,"name_native":"জিহাদ অধ্যায়"}}},"hadiths":[{"hadithnumber":2836,"arabicnumber":2836,"text":"। সালামা ইবনুল আকওয়া' (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি এক ব্যক্তির সাথে মল্লযুদ্ধে লিপ্ত হয়ে তাকে হত্যা করলাম। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তার মালপত্র আমাকে দিলেন।","grades":[{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":24,"hadith":84}}]}