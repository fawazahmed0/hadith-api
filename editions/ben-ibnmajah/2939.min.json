{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"হজের আচার-অনুষ্ঠানের অধ্যায়"}}},"hadiths":[{"hadithnumber":2939,"arabicnumber":2939,"text":"। আবদুল্লাহ ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, আম্বিয়া-ই কিরাম (আ) হেরেমের এলাকায় পদব্রজে ও নগ্নপদে প্রবেশ করতেন এবং রায়তুল্লাহ তাওয়াফসহ হজ্জের যাবতীয় অনুষ্ঠান নগ্নপদে ও পদব্রজে সমাপন করতেন।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":25,"hadith":58}}]}