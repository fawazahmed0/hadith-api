{"metadata":{"name":"Sunan Ibn Majah","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"হজের আচার-অনুষ্ঠানের অধ্যায়"}}},"hadiths":[{"hadithnumber":2972,"arabicnumber":2972,"text":"। জাবির ইবনে আবদুল্লাহ, ইবনে উমার ও ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ও তাঁর সাহাবীগণ মক্কায় পৌঁছে হজ্জ ও উমরা উভয়ের জন্য একবার (সাত চক্র) মাত্র তাওয়াফ করেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":25,"hadith":91}}]}