{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"হজের আচার-অনুষ্ঠানের অধ্যায়"}}},"hadiths":[{"hadithnumber":3007,"arabicnumber":3007,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমরা বললাম, হে আল্লাহর রাসূল! আমরা কি মিনায় আপনার জন্য একটি ঘর বানাবো না, যা আপনাকে ছায়া দান করবে? তিনি বলেনঃ না, মিনায় যারা আগে পৌঁছবে, তা তাদের ঠিকানা।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":25,"hadith":126}}]}