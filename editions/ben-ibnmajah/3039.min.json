{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"হজের আচার-অনুষ্ঠানের অধ্যায়"}}},"hadiths":[{"hadithnumber":3039,"arabicnumber":3039,"text":"। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তালবিয়া পাঠ অব্যাহত রেখেছেন যতক্ষণ না জামরাতুল আকাবায় (কোরবানীর দিন) কংকর নিক্ষেপ করেছেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":25,"hadith":158}}]}