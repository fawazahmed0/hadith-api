{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"হজের আচার-অনুষ্ঠানের অধ্যায়"}}},"hadiths":[{"hadithnumber":3049,"arabicnumber":3049,"text":"। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, হজ্জের অনুষ্ঠানাদিতে অগ্র-পশ্চাত হয়ে যাওয়ার ব্যাপারে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে জিজ্ঞাসা করা হলে তিনি দু’ হাতের ইশারায় বলেনঃ কোন ক্ষতি নেই।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":25,"hadith":168}}]}