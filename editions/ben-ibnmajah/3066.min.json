{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"হজের আচার-অনুষ্ঠানের অধ্যায়"}}},"hadiths":[{"hadithnumber":3066,"arabicnumber":3066,"text":"। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আব্বাস (রাঃ) ব্যতীত আর কাউকে মিনার রাতগুলোতে মক্কায় অবস্থানের অনুমতি দেননি। কারণ তার উপর পানি সরবরাহের দায়িত্ব অর্পিত ছিল।","grades":[{"name":"Al-Albani","grade":"Daif Isnaad"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":25,"hadith":185}}]}