{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"হজের আচার-অনুষ্ঠানের অধ্যায়"}}},"hadiths":[{"hadithnumber":3083,"arabicnumber":3083,"text":"। ইবনে উমার (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ইহরাম অবস্থায় ঘ্রাণহীন যায়তুনের তৈল মাথায় মাখতেন।","grades":[{"name":"Al-Albani","grade":"Daif Isnaad"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif Isnaad"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":25,"hadith":202}}]}