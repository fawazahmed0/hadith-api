{"metadata":{"name":"Sunan Ibn Majah","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"হজের আচার-অনুষ্ঠানের অধ্যায়"}}},"hadiths":[{"hadithnumber":3101,"arabicnumber":3101,"text":"। ইয়াস ইবনে সালামা (রাঃ) থেকে তার পিতার সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কোরবানীর পশুর মধ্যে একটি উটও ছিল।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":25,"hadith":220}}]}