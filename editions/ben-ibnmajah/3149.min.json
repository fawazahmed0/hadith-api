{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"26":"Chapters on Sacrifices"},"section_detail":{"26":{"hadithnumber_first":3120,"hadithnumber_last":3161,"arabicnumber_first":3120,"arabicnumber_last":3161,"name_native":"কোরবানি অধ্যায়"}}},"hadiths":[{"hadithnumber":3149,"arabicnumber":3149,"text":"। উম্মু সালামা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যখন (যিলহজ্জ মাসের) প্রথম দশক শুরু হয় এবং তোমাদের কেউ কোরবানী করার ইচ্ছা রাখে, সে যেন তার চুল ও শরীরের কোন অংশ স্পর্শ না করে (না কাটে)।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":26,"hadith":30}}]}