{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"26":"Chapters on Sacrifices"},"section_detail":{"26":{"hadithnumber_first":3120,"hadithnumber_last":3161,"arabicnumber_first":3120,"arabicnumber_last":3161,"name_native":"কোরবানি অধ্যায়"}}},"hadiths":[{"hadithnumber":3151,"arabicnumber":3151,"text":"। আনাস ইবনে মালেক (রাঃ) থেকে বর্ণিত। এক ব্যক্তি কোরবানীর দিন ঈদের নামাযের পূর্বে কোরবানী করলো। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তাকে পুনর্বার কোরবানী করার নির্দেশ দেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":26,"hadith":32}}]}