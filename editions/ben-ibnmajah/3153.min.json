{"metadata":{"name":"Sunan Ibn Majah","section":{"26":"Chapters on Sacrifices"},"section_detail":{"26":{"hadithnumber_first":3120,"hadithnumber_last":3161,"arabicnumber_first":3120,"arabicnumber_last":3161,"name_native":"কোরবানি অধ্যায়"}}},"hadiths":[{"hadithnumber":3153,"arabicnumber":3153,"text":"। উআইমির ইবনে আশকার (রাঃ) থেকে বর্ণিত। তিনি ঈদের নামাযের পূর্বে যবেহ করেন। তিনি বিষয়টি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর নিকট উল্লেখ করলে তিনি বলেনঃ তুমি পুনরায় কোরবানী করো।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":26,"hadith":34}}]}