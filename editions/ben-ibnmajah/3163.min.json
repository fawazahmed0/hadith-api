{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"27":"Chapters on Slaughtering"},"section_detail":{"27":{"hadithnumber_first":3162,"hadithnumber_last":3199,"arabicnumber_first":3162,"arabicnumber_last":3199,"name_native":"জবাই সংক্রান্ত অধ্যায়"}}},"hadiths":[{"hadithnumber":3163,"arabicnumber":3163,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদেরকে পুত্র সন্তানের পক্ষ থেকে দু’টি ÿকরী এবং কন্যা সন্তানের পক্ষ থেকে একটি বকরী দিয়ে আকীকা করার জন্য নির্দেশ দিয়েছেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":27,"hadith":2}}]}