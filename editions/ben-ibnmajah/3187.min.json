{"metadata":{"name":"Sunan Ibn Majah","section":{"27":"Chapters on Slaughtering"},"section_detail":{"27":{"hadithnumber_first":3162,"hadithnumber_last":3199,"arabicnumber_first":3162,"arabicnumber_last":3199,"name_native":"জবাই সংক্রান্ত অধ্যায়"}}},"hadiths":[{"hadithnumber":3187,"arabicnumber":3187,"text":"। ইবনে ‘আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা কোন জীবন্ত প্রাণীকে চাঁদমারির লক্ষ্যবস্তু বানিও না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":27,"hadith":26}}]}