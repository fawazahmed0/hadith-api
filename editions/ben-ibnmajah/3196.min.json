{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"27":"Chapters on Slaughtering"},"section_detail":{"27":{"hadithnumber_first":3162,"hadithnumber_last":3199,"arabicnumber_first":3162,"arabicnumber_last":3199,"name_native":"জবাই সংক্রান্ত অধ্যায়"}}},"hadiths":[{"hadithnumber":3196,"arabicnumber":3196,"text":"। আনাস মালেক (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর ঘোষক ঘোষণা করলেনঃ নিশ্চিতভাবে আল্লাহ ও তাঁর রাসূল তোমাদেরকে গৃহপালিত গাধার গোশত খেতে নিষেধ করেছেন। কারণ তা নাপাক।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":27,"hadith":35}}]}