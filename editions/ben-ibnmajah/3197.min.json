{"metadata":{"name":"Sunan Ibn Majah","section":{"27":"Chapters on Slaughtering"},"section_detail":{"27":{"hadithnumber_first":3162,"hadithnumber_last":3199,"arabicnumber_first":3162,"arabicnumber_last":3199,"name_native":"জবাই সংক্রান্ত অধ্যায়"}}},"hadiths":[{"hadithnumber":3197,"arabicnumber":3197,"text":"। জাবির বিন আবদুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমরা ঘোড়ার গোশত আহার করতাম। আমি (আতা) বললাম, খচ্চরের গোশত? তিনি বলেন, না।","grades":[{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":27,"hadith":36}}]}