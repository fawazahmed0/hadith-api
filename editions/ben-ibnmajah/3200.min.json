{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"28":"Chapters on Hunting"},"section_detail":{"28":{"hadithnumber_first":3200,"hadithnumber_last":3250,"arabicnumber_first":3200,"arabicnumber_last":3250,"name_native":"শিকার অধ্যায়"}}},"hadiths":[{"hadithnumber":3200,"arabicnumber":3200,"text":"। আবদুল্লাহ বিন মুগাফফাল (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কুকুর নিধনের নির্দেশ দেন,অতঃপর বলেনঃ লোকেদের কুকুরের কী প্রয়োজন? অতঃপর তিনি তাদের শিকারী কুকুর রাখার অনুমতি দেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":28,"hadith":1}}]}