{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"28":"Chapters on Hunting"},"section_detail":{"28":{"hadithnumber_first":3200,"hadithnumber_last":3250,"arabicnumber_first":3200,"arabicnumber_last":3250,"name_native":"শিকার অধ্যায়"}}},"hadiths":[{"hadithnumber":3209,"arabicnumber":3209,"text":"। জাবির ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমাদেরকে অগ্নি উপাসকদের কুকুর ও পাখির ধৃত শিকার খেতে নিষেধ করা হয়েছে।","grades":[{"name":"Al-Albani","grade":"Daif Isnaad"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":28,"hadith":10}}]}