{"metadata":{"name":"Sunan Ibn Majah","section":{"28":"Chapters on Hunting"},"section_detail":{"28":{"hadithnumber_first":3200,"hadithnumber_last":3250,"arabicnumber_first":3200,"arabicnumber_last":3250,"name_native":"শিকার অধ্যায়"}}},"hadiths":[{"hadithnumber":3216,"arabicnumber":3216,"text":"। ইবনে উমার (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ জীবিত প্রাণীর দেহের কোন অংশ কেটে বিচ্ছিন্ন করা হলে তা মৃত হিসাবে গণ্য।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":28,"hadith":17}}]}