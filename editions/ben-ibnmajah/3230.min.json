{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"28":"Chapters on Hunting"},"section_detail":{"28":{"hadithnumber_first":3200,"hadithnumber_last":3250,"arabicnumber_first":3200,"arabicnumber_last":3250,"name_native":"শিকার অধ্যায়"}}},"hadiths":[{"hadithnumber":3230,"arabicnumber":3230,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম গিরগিটি সম্পর্কে বলেনঃ তা ক্ষতিকর প্রাণী।","grades":[{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":28,"hadith":31}}]}