{"metadata":{"name":"Sunan Ibn Majah","section":{"28":"Chapters on Hunting"},"section_detail":{"28":{"hadithnumber_first":3200,"hadithnumber_last":3250,"arabicnumber_first":3200,"arabicnumber_last":3250,"name_native":"শিকার অধ্যায়"}}},"hadiths":[{"hadithnumber":3232,"arabicnumber":3232,"text":"। আবূ সা‘লাবা আল-খুশানী (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম শিকারী দাঁতযুক্ত যে কোন হিংস্র জন্তু খেতে নিষেধ করেছেন। যুহরী (রাঃ) বলেন, আমি সিরিয়ায় পৌঁছার পূর্ব পর্যন্ত এ হাদীস শুনতে পাইনি।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":28,"hadith":33}}]}