{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":"খাদ্য অধ্যায়"}}},"hadiths":[{"hadithnumber":3258,"arabicnumber":3258,"text":"। আবূ মূসা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ মুমিন ব্যক্তি এক পাকস্থলীতে খায় এবং কাফের ব্যক্তি সাত পাকস্থলীতে খায়।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":29,"hadith":8}}]}