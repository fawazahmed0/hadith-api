{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":"খাদ্য অধ্যায়"}}},"hadiths":[{"hadithnumber":3287,"arabicnumber":3287,"text":"। উমার ইবনুল খাত্তাব (রাঃ) বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা একত্রে আহার করো এবং বিচ্ছিন্নভাবে করো না। কারণ বরকত থাকে সমষ্টির সাথে।","grades":[{"name":"Al-Albani","grade":"Very Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":29,"hadith":37}}]}