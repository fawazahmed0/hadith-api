{"metadata":{"name":"Sunan Ibn Majah","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":"খাদ্য অধ্যায়"}}},"hadiths":[{"hadithnumber":3317,"arabicnumber":3317,"text":"। জাবির ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন , রাসূলুললাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ সির্কা উত্তম তরকারী।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":29,"hadith":67}}]}