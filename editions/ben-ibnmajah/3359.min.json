{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":"খাদ্য অধ্যায়"}}},"hadiths":[{"hadithnumber":3359,"arabicnumber":3359,"text":"। ‘আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি আহার তৈরি করলাম এবং রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে দাওয়াত দিলাম। তিনি এসে ঘরের ভেতর ছবি দেখতে পেয়ে ফিরে গেলেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":29,"hadith":109}}]}