{"metadata":{"name":"Sunan Ibn Majah","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":"খাদ্য অধ্যায়"}}},"hadiths":[{"hadithnumber":3366,"arabicnumber":3366,"text":"। ‘উকবা ইবনে ‘আমের আল-জুহানী (রাঃ) বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তাঁর সাহাবীগণকে বললেনঃ তোমরা পিঁয়াজ খেও না। অতঃপর তিনি আস্তে বলেনঃ কাঁচা পিঁয়াজ।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":29,"hadith":116}}]}