{"metadata":{"name":"Sunan Ibn Majah","section":{"30":"Chapters on Drinks"},"section_detail":{"30":{"hadithnumber_first":3371,"hadithnumber_last":3435,"arabicnumber_first":3371,"arabicnumber_last":3435,"name_native":"পানীয় অধ্যায়"}}},"hadiths":[{"hadithnumber":3374,"arabicnumber":3374,"text":"। আবু হুরায়রা (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি দুনিয়াতে শরাব পান করে, সে আখেরাতে তা পান করতে পারবে না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":30,"hadith":4}}]}