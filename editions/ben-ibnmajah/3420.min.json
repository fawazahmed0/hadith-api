{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"30":"Chapters on Drinks"},"section_detail":{"30":{"hadithnumber_first":3371,"hadithnumber_last":3435,"arabicnumber_first":3371,"arabicnumber_last":3435,"name_native":"পানীয় অধ্যায়"}}},"hadiths":[{"hadithnumber":3420,"arabicnumber":3420,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মশকের মুখে মুখ লাগিয়ে পানি পান করতে নিষেধ করেছেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":30,"hadith":50}}]}