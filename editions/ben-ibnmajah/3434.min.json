{"metadata":{"name":"Sunan Ibn Majah","section":{"30":"Chapters on Drinks"},"section_detail":{"30":{"hadithnumber_first":3371,"hadithnumber_last":3435,"arabicnumber_first":3371,"arabicnumber_last":3435,"name_native":"পানীয় অধ্যায়"}}},"hadiths":[{"hadithnumber":3434,"arabicnumber":3434,"text":"। আবূ কাতাদা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ লোকেদের পানীয় পরিবেশনকারী সবশেষে পান করবে।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":30,"hadith":64}}]}