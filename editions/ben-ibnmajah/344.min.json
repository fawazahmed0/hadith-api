{"metadata":{"name":"Sunan Ibn Majah","section":{"1":"The Book of Purification and its Sunnah"},"section_detail":{"1":{"hadithnumber_first":267,"hadithnumber_last":666,"arabicnumber_first":267,"arabicnumber_last":666,"name_native":"পবিত্রতা অধ্যায়"}}},"hadiths":[{"hadithnumber":344,"arabicnumber":344,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমাদের কেউ যেন বদ্ধ পানিতে পেশাব না করে।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":1,"hadith":78}}]}