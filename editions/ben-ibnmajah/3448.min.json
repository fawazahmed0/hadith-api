{"metadata":{"name":"Sunan Ibn Majah","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"চিকিৎসা অধ্যায়"}}},"hadiths":[{"hadithnumber":3448,"arabicnumber":3448,"text":"। সালেম ইবনে আবদুল্লাহ (রাঃ) থেকে তার পিতার সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ অবশ্যই তোমরা এই কালো দানা ব্যবহার করবে। কেননা তাতে মৃত্যু ছাড়া সব রোগের নিরাময় রয়েছে।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":31,"hadith":13}}]}