{"metadata":{"name":"Sunan Ibn Majah","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"চিকিৎসা অধ্যায়"}}},"hadiths":[{"hadithnumber":3466,"arabicnumber":3466,"text":"। আমর ইবনে শোআইব (রাঃ) থেকে পর্যায়ক্রমে তার পিতা ও তার দাদার সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কোন ব্যক্তি চিকিৎসা বিদ্যা অর্জন না করেই চিকিৎসা করলে সে দায়ী হবে।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":31,"hadith":31}}]}