{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"চিকিৎসা অধ্যায়"}}},"hadiths":[{"hadithnumber":3476,"arabicnumber":3476,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তোমরা যে সকল জিনিস দ্বারা চিকিৎসা করো তার কোনটির মধ্যে উপকার থাকলে তা রক্তমোক্ষণের মধ্যেও আছে।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":31,"hadith":41}}]}