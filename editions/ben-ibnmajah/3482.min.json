{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"চিকিৎসা অধ্যায়"}}},"hadiths":[{"hadithnumber":3482,"arabicnumber":3482,"text":"। আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, জিবরাঈল (আ) ঘাড়ের দু’ পাশের শিরায় এবং ঘাড়ের কাছাকাছি পিঠের ফোলা অংশে রক্ষমোক্ষণ করানোর পরামর্শ নিয়ে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর নিকট আসেন।","grades":[{"name":"Al-Albani","grade":"Very Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":31,"hadith":47}}]}