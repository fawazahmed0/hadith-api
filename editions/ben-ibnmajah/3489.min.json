{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"চিকিৎসা অধ্যায়"}}},"hadiths":[{"hadithnumber":3489,"arabicnumber":3489,"text":"। মুগীরা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি তপ্ত লোহা দ্বারা (দেহে) দাগ নেয় বা ঝাড়ফুঁক গ্রহণ করায় সে তাওয়াক্কুল (আল্লাহর উপর নির্ভরশীলতা) থেকে বিচ্যুত হলো।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":31,"hadith":54}}]}