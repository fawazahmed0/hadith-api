{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"চিকিৎসা অধ্যায়"}}},"hadiths":[{"hadithnumber":3535,"arabicnumber":3535,"text":"। সালিম (রাঃ) থেকে তার পিতার সূত্রে বর্ণিত। রাসূলুললাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তোমরা সাপ মেরে ফেলো, বিশেষত দু'মুখো সাপ এবং লেজবিহীন সাপ! কেননা এ দু’টি সাপ দৃষ্টিশক্তি নষ্ট করে এবং গর্ভপাত ঘটায়।","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":31,"hadith":100}}]}