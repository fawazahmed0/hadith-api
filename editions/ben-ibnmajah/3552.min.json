{"metadata":{"name":"Sunan Ibn Majah","section":{"32":"Chapters on Dress"},"section_detail":{"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656,"name_native":"পোষাক-পরিচ্ছদ অধ্যায়"}}},"hadiths":[{"hadithnumber":3552,"arabicnumber":3552,"text":"। উবাদা ইবনুস সামিত (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একটি চাদর পরিহিত অবস্থায় নামায পড়েন, যা তিনি পিঠ দিয়ে বেঁধে রেখেছিলেন।","grades":[{"name":"Al-Albani","grade":"Daif Isnaad"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":32,"hadith":3}}]}