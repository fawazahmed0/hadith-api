{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"32":"Chapters on Dress"},"section_detail":{"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656,"name_native":"পোষাক-পরিচ্ছদ অধ্যায়"}}},"hadiths":[{"hadithnumber":3582,"arabicnumber":3582,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ফাতেমা (রাঃ) অথবা উম্মু সালামা (রাঃ) কে বলেনঃ তোমার পরিধেয় বস্ত্রের আঁচল এক হাত পরিমাণ লম্বা হতে পারে।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"name":"Shuaib Al Arnaut","grade":"Very Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":32,"hadith":33}}]}