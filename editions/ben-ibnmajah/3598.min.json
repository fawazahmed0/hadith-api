{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"32":"Chapters on Dress"},"section_detail":{"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656,"name_native":"পোষাক-পরিচ্ছদ অধ্যায়"}}},"hadiths":[{"hadithnumber":3598,"arabicnumber":3598,"text":"। আনাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর কন্যা যয়নব (রাঃ) ,র পরিধানে লাল রং-এর রেশমী কাপড়ের জামা দেখেছি।","grades":[{"name":"Al-Albani","grade":"Shadh"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Shadh"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":32,"hadith":49}}]}