{"metadata":{"name":"Sunan Ibn Majah","section":{"32":"Chapters on Dress"},"section_detail":{"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656,"name_native":"পোষাক-পরিচ্ছদ অধ্যায়"}}},"hadiths":[{"hadithnumber":3613,"arabicnumber":3613,"text":"। আবদুল্লাহ ইবনে উকাইম (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমাদের নিকট এ মর্মে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর নির্দেশনামা এলোঃ তোমরা মৃতজীবের চামড়া ও শিরা কোন কাজে ব্যবহার করো না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":32,"hadith":64}}]}