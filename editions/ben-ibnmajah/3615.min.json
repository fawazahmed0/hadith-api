{"metadata":{"name":"Sunan Ibn Majah","section":{"32":"Chapters on Dress"},"section_detail":{"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656,"name_native":"পোষাক-পরিচ্ছদ অধ্যায়"}}},"hadiths":[{"hadithnumber":3615,"arabicnumber":3615,"text":"। আনাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর জুতাজোড়ার দু’টি ফিতা ছিলো।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":32,"hadith":66}}]}