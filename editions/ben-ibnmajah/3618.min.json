{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"32":"Chapters on Dress"},"section_detail":{"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656,"name_native":"পোষাক-পরিচ্ছদ অধ্যায়"}}},"hadiths":[{"hadithnumber":3618,"arabicnumber":3618,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কোন ব্যক্তিকে দাঁড়ানো অবস্থায় জুতা পরতে নিষেধ করেছেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":32,"hadith":69}}]}