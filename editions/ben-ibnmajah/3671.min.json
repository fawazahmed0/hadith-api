{"metadata":{"name":"Sunan Ibn Majah","section":{"33":"Etiquette"},"section_detail":{"33":{"hadithnumber_first":3657,"hadithnumber_last":3826,"arabicnumber_first":3657,"arabicnumber_last":3826,"name_native":"আদব ও শিষ্টাচার অধ্যায়"}}},"hadiths":[{"hadithnumber":3671,"arabicnumber":3671,"text":"। আনাস ইবনে মালেক (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ ﷺ বলেনঃ তোমরা তোমাদের সন্তানদের সাথে উত্তম আচরণ করো এবং তাদেরকে উত্তমরূপে সদাচার শিক্ষা দাও।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":33,"hadith":15}}]}