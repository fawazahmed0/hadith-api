{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"33":"Etiquette"},"section_detail":{"33":{"hadithnumber_first":3657,"hadithnumber_last":3826,"arabicnumber_first":3657,"arabicnumber_last":3826,"name_native":"আদব ও শিষ্টাচার অধ্যায়"}}},"hadiths":[{"hadithnumber":3734,"arabicnumber":3734,"text":"। আবদুল্লাহ ইবনে সালাম (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি এসে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর নিকট উপস্থিত হলাম, তখন আমার নাম রাখেন আবদুল্লাহ ইবনে সালাম।","grades":[{"name":"Al-Albani","grade":"Munkar Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Munkar Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":33,"hadith":78}}]}