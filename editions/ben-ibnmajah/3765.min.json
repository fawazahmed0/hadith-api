{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"33":"Etiquette"},"section_detail":{"33":{"hadithnumber_first":3657,"hadithnumber_last":3826,"arabicnumber_first":3657,"arabicnumber_last":3826,"name_native":"আদব ও শিষ্টাচার অধ্যায়"}}},"hadiths":[{"hadithnumber":3765,"arabicnumber":3765,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এক ব্যক্তিকে একটি কবুতরের পিছু ধাওয়া করতে দেখে বলেনঃ এক শয়তান আরেক শয়তাণীর পিছু নিয়েছে।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":33,"hadith":109}}]}