{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"33":"Etiquette"},"section_detail":{"33":{"hadithnumber_first":3657,"hadithnumber_last":3826,"arabicnumber_first":3657,"arabicnumber_last":3826,"name_native":"আদব ও শিষ্টাচার অধ্যায়"}}},"hadiths":[{"hadithnumber":3820,"arabicnumber":3820,"text":"। আয়েশা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলতেনঃ হে আল্লাহ! যারা উত্তম কাজ করতে পেরে আনন্দিত হয় এবং নিকৃষ্ট কাজ করলে ক্ষমা প্রার্থনা করে, আমাকে তাদের অন্তর্ভুক্ত করো।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":33,"hadith":164}}]}