{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"35":"Interpretation of Dreams"},"section_detail":{"35":{"hadithnumber_first":3893,"hadithnumber_last":3926,"arabicnumber_first":3893,"arabicnumber_last":3926,"name_native":"স্বপ্নের ব্যাখ্যা"}}},"hadiths":[{"hadithnumber":3900,"arabicnumber":3900,"text":"। আবদুল্লাহ (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি স্বপ্নে আমাকে দেখলো, সে যেন আমাকে জাগ্রত অবস্থায় দেখলো। কেননা শয়তান আমার স্বরূপ (সাদৃশ্য) ধারণ করতে পারে না।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":35,"hadith":8}}]}