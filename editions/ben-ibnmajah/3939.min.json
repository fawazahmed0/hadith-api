{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"36":"Tribulations"},"section_detail":{"36":{"hadithnumber_first":3927,"hadithnumber_last":4099,"arabicnumber_first":3927,"arabicnumber_last":4099,"name_native":"ক্লেশ"}}},"hadiths":[{"hadithnumber":3939,"arabicnumber":3939,"text":"। আবদুল্লাহ ইবনে মাসউদ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ মুসলিমকে গালি দেয়া ফাসেকী এবং তাকে হত্যা করা কুফরী।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":36,"hadith":14}}]}