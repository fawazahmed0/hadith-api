{"metadata":{"name":"Sunan Ibn Majah","section":{"36":"Tribulations"},"section_detail":{"36":{"hadithnumber_first":3927,"hadithnumber_last":4099,"arabicnumber_first":3927,"arabicnumber_last":4099,"name_native":"ক্লেশ"}}},"hadiths":[{"hadithnumber":4085,"arabicnumber":4085,"text":"। আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ মাহ্দী আমাদের আহলে বাইত থেকে হবে। আল্লাহ তা‘আলা তাকে এক রাতে খিলাফতের যোগ্য করবেন।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":36,"hadith":160}}]}