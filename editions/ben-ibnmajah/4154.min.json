{"metadata":{"name":"Sunan Ibn Majah","section":{"37":"Zuhd"},"section_detail":{"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341,"name_native":"জুহদ"}}},"hadiths":[{"hadithnumber":4154,"arabicnumber":4154,"text":"। আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কন্যাকে যেদিন আমার ঘরে তুলে আনা হলো সেদিন রাতে আমাদের বিছানা ছিলো ছাগলের চামড়া।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":37,"hadith":55}}]}