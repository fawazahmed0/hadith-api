{"metadata":{"name":"Sunan Ibn Majah","section":{"37":"Zuhd"},"section_detail":{"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341,"name_native":"জুহদ"}}},"hadiths":[{"hadithnumber":4181,"arabicnumber":4181,"text":"। আনাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ প্রতিটি ধর্মেরই একটা স্বতন্ত্র বৈশিষ্ট্য আছে। আর ইসলামের স্বতন্ত্র বৈশিষ্ট্য হলো ‘লজ্জাশীলতা’।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":37,"hadith":82}}]}