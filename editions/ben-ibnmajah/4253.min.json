{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"37":"Zuhd"},"section_detail":{"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341,"name_native":"জুহদ"}}},"hadiths":[{"hadithnumber":4253,"arabicnumber":4253,"text":"। আবদুল্লাহ ইবনে ‘আমর (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ রূহ কণ্ঠাগত না হওয়া (মৃত্যুর পূর্ব মুহূর্ত) পর্যন্ত মহামহিম আল্লাহ বান্দার তওবা কবুল করেন।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":37,"hadith":154}}]}