{"metadata":{"name":"Sunan Ibn Majah","section":{"37":"Zuhd"},"section_detail":{"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341,"name_native":"জুহদ"}}},"hadiths":[{"hadithnumber":4315,"arabicnumber":4315,"text":"। ইমরান ইবনুল হুসাইন (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ আমার শাফাআতের বদৌলতে ‘জাহান্নামী’ নামের একদল জাহান্নাম থেকে নাজাত পাবে।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":37,"hadith":216}}]}