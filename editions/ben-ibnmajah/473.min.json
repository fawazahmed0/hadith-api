{"metadata":{"name":"Sunan Ibn Majah","section":{"1":"The Book of Purification and its Sunnah"},"section_detail":{"1":{"hadithnumber_first":267,"hadithnumber_last":666,"arabicnumber_first":267,"arabicnumber_last":666,"name_native":"পবিত্রতা অধ্যায়"}}},"hadiths":[{"hadithnumber":473,"arabicnumber":473,"text":"। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম পিতলের একটি পাত্রে উযূ (ওজু/অজু/অযু) করেন।","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":1,"hadith":207}}]}