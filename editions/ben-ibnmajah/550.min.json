{"metadata":{"name":"Sunan Ibn Majah","section":{"1":"The Book of Purification and its Sunnah"},"section_detail":{"1":{"hadithnumber_first":267,"hadithnumber_last":666,"arabicnumber_first":267,"arabicnumber_last":666,"name_native":"পবিত্রতা অধ্যায়"}}},"hadiths":[{"hadithnumber":550,"arabicnumber":550,"text":"। মুগীরাহ ইবনু শুবাহ (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মোজার উপরিভাগ ও নিম্নভাগ মাসহ(মাসেহ) করেন।","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":1,"hadith":284}}]}