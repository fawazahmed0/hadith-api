{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"সুন্নাহ অধ্যায়"}}},"hadiths":[{"hadithnumber":58,"arabicnumber":58,"text":"। আবদুল্লাহ ইবনু উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এক ব্যাক্তিকে লজ্জাশীলতা সম্পর্কে তার ভাইকে নাসীহাত (তিরস্কার) করতে শুনলেন। তখন তিনি বলেনঃ নিশ্চয় লজ্জাশীলতা ঈমানের একটি শাখা।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":0,"hadith":58}}]}