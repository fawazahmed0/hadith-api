{"metadata":{"name":"Sunan Ibn Majah","section":{"2":"The Book of the Prayer"},"section_detail":{"2":{"hadithnumber_first":667,"hadithnumber_last":705,"arabicnumber_first":667,"arabicnumber_last":705,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":674,"arabicnumber":674,"text":"। আবূ বারযা আল-আসলামী (রাঃ) থেকে বর্ণিত। তিনি বলেন, সূর্য (পশ্চিমাকাশে) ঢলে পড়ার পর নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যোহরের সালাত আদায় করতেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}],"reference":{"book":2,"hadith":8}}]}