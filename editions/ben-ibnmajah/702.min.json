{"metadata":{"name":"Sunan Ibn Majah","section":{"2":"The Book of the Prayer"},"section_detail":{"2":{"hadithnumber_first":667,"hadithnumber_last":705,"arabicnumber_first":667,"arabicnumber_last":705,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":702,"arabicnumber":702,"text":"। আয়িশাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এশার সালাতের পূর্বে ঘুমাননি এবং তারপরে নৈশ আলাপ করেননি।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":2,"hadith":36}}]}