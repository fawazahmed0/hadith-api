{"metadata":{"name":"Sunan Ibn Majah","section":{"2":"The Book of the Prayer"},"section_detail":{"2":{"hadithnumber_first":667,"hadithnumber_last":705,"arabicnumber_first":667,"arabicnumber_last":705,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":703,"arabicnumber":703,"text":"। আবদুল্লাহ ইবনু মাসঊদ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এশার সালাতের পর আমাদের নৈশালাপ নিষেধ করতেন অর্থাৎ কঠোরভাবে নিষেধ করতেন।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":2,"hadith":37}}]}