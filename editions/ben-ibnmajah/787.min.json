{"metadata":{"name":"Sunan Ibn Majah","name_native":"সুনান ইবনে মাজাহ","section":{"4":"The Book On The Mosques And The Congregations"},"section_detail":{"4":{"hadithnumber_first":735,"hadithnumber_last":802,"arabicnumber_first":735,"arabicnumber_last":802,"name_native":"মসজিদ ও জামাতের উপর বই"}}},"hadiths":[{"hadithnumber":787,"arabicnumber":787,"text":"। আবূ হুরাইরাহ (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ জামাআতের ফযীলাত তোমাদের কারো একাকী সালাত পড়ার তুলনায় পঁচিশ গুণ বেশি।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}],"reference":{"book":4,"hadith":53}}]}