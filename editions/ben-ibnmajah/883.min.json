{"metadata":{"name":"Sunan Ibn Majah","section":{"5":"Establishing the Prayer and the Sunnah Regarding Them"},"section_detail":{"5":{"hadithnumber_first":803,"hadithnumber_last":1432,"arabicnumber_first":803,"arabicnumber_last":1432,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":883,"arabicnumber":883,"text":"। ইবনু আব্বাস (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ আমি সাত অঙ্গে সিজদা করতে আদিষ্ট হয়েছি।","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}],"reference":{"book":5,"hadith":81}}]}