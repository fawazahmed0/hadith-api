	"hadiths": [
		{
			"hadithnumber": 94,
			"arabicnumber": 94,
			"text": "। আবূ হুরায়রা(রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ আবূ বাকরের ধন-সম্পদ আমার যতটুকু উপকারে এসেছে অন্য কারো ধন-সম্পদ আমার তত উপকারে আসেনি। রাবী বলেন, এ কথায় আবূ বাকর কেঁদে ফেলেন এবং বলেন, হে আল্লাহ্‌র রাসূল! আমি ও আমার ধন-সম্পদ আপনারই।",
			"grades": [
				{
					"name": "Al-Albani",
