{"metadata":{"name":"Muwatta Malik","name_native":"মুয়াত্তা মালিক","section":{"20":"Hajj"},"section_detail":{"20":{"hadithnumber_first":705,"hadithnumber_last":957,"arabicnumber_first":705,"arabicnumber_last":957,"name_native":"হজ্জ অধ্যায়"}}},"hadiths":[{"hadithnumber":731,"arabicnumber":731,"text":"রেওয়ায়ত ২৮. মালিক (রহঃ) জনৈক নির্ভরযোগ্য ব্যক্তির নিকট শুনিয়াছেন যে, আবদুল্লাহ ইবন উমর (রাঃ) এলিয়া (বায়তুল মুকাদ্দাস) হইতে ইহরাম বাঁধিয়াছিলেন।","grades":[{"name":"Salim al-Hilali","grade":"Mauquf Sahih"}],"reference":{"book":20,"hadith":27}}]}