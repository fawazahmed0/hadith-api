{"metadata":{"name":"Sunan an Nasai","section":{"14":"The Book of Jumu'ah (Friday Prayer)"},"section_detail":{"14":{"hadithnumber_first":1367,"hadithnumber_last":1432,"arabicnumber_first":1367,"arabicnumber_last":1432,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":1377,"arabicnumber":1377,"text":"। কুতায়বা (রহঃ) ... আবূ সাঈদ খুদরী (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, জুমু'আর দিনের গোসল প্রত্যেক বালিগ ব্যক্তির উপর জরুরী।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":14,"hadith":14}}]}