{"metadata":{"name":"Sunan an Nasai","name_native":"সুনান আন-নাসায়ী","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":1824,"arabicnumber":1824,"text":"। হুসায়ন ইবনু হুরায়ছ এবং মুহাম্মাদ ইবনু আব্দুল্লাহ (রহঃ) ... আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, তোমরা মৃত্যুকে অধিক স্মরণ কর।","grades":[{"name":"Abu Ghuddah","grade":"Hasan Sahih"},{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":21,"hadith":7}}]}