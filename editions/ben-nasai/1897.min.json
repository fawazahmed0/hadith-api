{"metadata":{"name":"Sunan an Nasai","name_native":"সুনান আন-নাসায়ী","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":1897,"arabicnumber":1897,"text":"। ইসহাক (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে সাহল নামক স্থানের তিনটি সাদা কাপড় দ্বারা কাফন দেওয়া হয়েছিল।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":21,"hadith":80}}]}