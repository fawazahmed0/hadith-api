{"metadata":{"name":"Sunan an Nasai","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"জানাযা (দাফন) অধ্যায়"}}},"hadiths":[{"hadithnumber":2005,"arabicnumber":2005,"text":"। মুহাম্মাদ ইবনু আব্দুল্লাহ (রহঃ) ... জাবির (রাঃ) থেকে বর্নিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, তোমরা শহীদদের তাদের নিজ নিজ শাহাদাতের স্থানেই দাফন কর।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":21,"hadith":188}}]}