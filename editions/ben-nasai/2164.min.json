{"metadata":{"name":"Sunan an Nasai","name_native":"সুনান আন-নাসায়ী","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"সিয়াম (রোজা) অধ্যায়"}}},"hadiths":[{"hadithnumber":2164,"arabicnumber":2164,"text":"। সুওয়াইদ ইবনু নাসর (রহঃ) ... মিকদাম ইবনু মা'দী কারিব (রাঃ) সুত্রে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেন তোমরা ভোর রাত্রের খাদ্য অবশ্যই খাবে। কেননা সেটাই সকাল বেলার পবিত্র খাবার।","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":22,"hadith":75}}]}