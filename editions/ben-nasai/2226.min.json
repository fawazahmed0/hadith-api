{"metadata":{"name":"Sunan an Nasai","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"সিয়াম (রোজা) অধ্যায়"}}},"hadiths":[{"hadithnumber":2226,"arabicnumber":2226,"text":"মুহাম্মদ ইবন মুসান্না এবং মুহাম্মদ ইবন বাশশার (রহঃ) ... রাফে' ইন খাদীজ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম হাকল হতে তোমাদেরকে নিষেধ করেছেন।","grades":[{"name":"Abu Ghuddah","grade":"Sahih Lighairihi"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":22,"hadith":137}}]}