{"metadata":{"name":"Sunan an Nasai","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"সিয়াম (রোজা) অধ্যায়"}}},"hadiths":[{"hadithnumber":2235,"arabicnumber":2235,"text":"। মুহাম্মাদ ইবনু হাতিম (রহঃ) ... আবূ উবায়দা (রাঃ) থেকে বর্ণিত। তিনি বলেনঃ সাওম (রোযা/রোজা/সিয়াম/ছিয়াম) ঢালস্বরূপ যতক্ষণ পর্যন্ত সে তা ভেঙ্গে না ফেলে।","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad Maqtu"},{"name":"Al-Albani","grade":"Sahih Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":22,"hadith":146}}]}