{"metadata":{"name":"Sunan an Nasai","name_native":"সুনান আন-নাসায়ী","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"পবিত্রতা অধ্যায়"}}},"hadiths":[{"hadithnumber":264,"arabicnumber":264,"text":"। মুহাম্মদ ইবনু উবায়দ (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত, তিনি বলেন রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একই গোসলে সকল স্ত্রীর নিকট গমন করতেন।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":1,"hadith":265}}]}