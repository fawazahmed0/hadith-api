{"metadata":{"name":"Sunan an Nasai","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"হজ্জের কিতাব"}}},"hadiths":[{"hadithnumber":2837,"arabicnumber":2837,"text":"কুতায়বা (রহঃ) ... ইবন আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ইহরাম অবস্থায় মায়মূনা (রাঃ)-কে বিবাহ করেছিলেন।","grades":[{"name":"Abu Ghuddah","grade":"Shadh"},{"name":"Al-Albani","grade":"Shadh"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":24,"hadith":220}}]}