{"metadata":{"name":"Sunan an Nasai","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"হজ্জের কিতাব"}}},"hadiths":[{"hadithnumber":2866,"arabicnumber":2866,"text":"ইসহাক ইবন ইবরাহীম (রহঃ) ... জাবির (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন মক্কায় প্রবেশ করেন, তখন তাঁর পতাকা ছিল সাদা রংয়ের।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":24,"hadith":249}}]}