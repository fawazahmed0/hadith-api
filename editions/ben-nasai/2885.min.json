{"metadata":{"name":"Sunan an Nasai","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"হজ্জের কিতাব"}}},"hadiths":[{"hadithnumber":2885,"arabicnumber":2885,"text":"মুহাম্মদ ইবন আবদুল্লাহ্ ইবন ইয়ায়ীদ মুকরী (রহঃ) ... উম্মে শরীক (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে টিকটিকি হত্যা করতে আদেশ করেছেন।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":24,"hadith":268}}]}