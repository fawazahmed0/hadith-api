{"metadata":{"name":"Sunan an Nasai","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"পবিত্রতা অধ্যায়"}}},"hadiths":[{"hadithnumber":298,"arabicnumber":298,"text":"। হুসায়ন ইবনু হুরায়স (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত, তিনি বলেনঃ আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কাপড় থেকে তা ঘষে ফেলতাম।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":1,"hadith":299}}]}