{"metadata":{"name":"Sunan an Nasai","name_native":"সুনান আন-নাসায়ী","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"পবিত্রতা অধ্যায়"}}},"hadiths":[{"hadithnumber":300,"arabicnumber":300,"text":"। কুতায়বা (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত। তিনি বলেনঃ আমার মনে পড়ে, আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কাপড় থেকে জানবাতের চিহ্ন ঘষে ফেলতাম।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":1,"hadith":301}}]}