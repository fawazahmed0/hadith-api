{"metadata":{"name":"Sunan an Nasai","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"হজ্জের কিতাব"}}},"hadiths":[{"hadithnumber":3026,"arabicnumber":3026,"text":"ইয়াহইয়া ইবন হাবীব ইবন আরাবী (রহঃ) ... আবূ আইয়ুব (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মাগরিব এবং ইশার সালাত একত্রে আদায় করেন মুযদালিফায়।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":24,"hadith":409}}]}