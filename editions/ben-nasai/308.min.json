{"metadata":{"name":"Sunan an Nasai","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"পবিত্রতা অধ্যায়"}}},"hadiths":[{"hadithnumber":308,"arabicnumber":308,"text":"। আলী ইবনু হুজর (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত যে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তার চাঁদরের একদিক উঠিয়ে তাতে থুথু ফেললেন, এরপর এক অংশের উপর অন্য অংশ চাপা দিলেন।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":1,"hadith":309}}]}