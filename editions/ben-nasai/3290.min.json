{"metadata":{"name":"Sunan an Nasai","section":{"26":"The Book of Marriage"},"section_detail":{"26":{"hadithnumber_first":3196,"hadithnumber_last":3388,"arabicnumber_first":3196,"arabicnumber_last":3388,"name_native":"নিকাহ (বিয়ে) অধ্যায়"}}},"hadiths":[{"hadithnumber":3290,"arabicnumber":3290,"text":"ইবারাহীম ইবন ইয়াকুব (রহঃ) ... আবু হুরায়রা (রাঃ) থেকে বর্ণিত। কোন নারীর খালা এবং ফুফুর সাথে ঐ নারীকে বিবাহ করতে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম নিষেধ করেছেন।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":26,"hadith":95}}]}