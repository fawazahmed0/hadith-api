{"metadata":{"name":"Sunan an Nasai","section":{"33":"The Book of ar-Ruqba"},"section_detail":{"33":{"hadithnumber_first":3706,"hadithnumber_last":3719,"arabicnumber_first":3706,"arabicnumber_last":3719,"name_native":"আর-রুক্বা কিতাব"}}},"hadiths":[{"hadithnumber":3718,"arabicnumber":3718,"text":"মুহাম্মাদ ইবন উবায়দ (রহঃ) ... যায়দ ইবন সাবিত (রাঃ) সূত্রে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেছেনঃ উমরা ওয়ারিসদের জন্য।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":33,"hadith":13}}]}