{"metadata":{"name":"Sunan an Nasai","name_native":"সুনান আন-নাসায়ী","section":{"40":"The Book of al-'Aqiqah"},"section_detail":{"40":{"hadithnumber_first":4212,"hadithnumber_last":4221,"arabicnumber_first":4212,"arabicnumber_last":4221,"name_native":"আল-আকীকাহ কিতাব"}}},"hadiths":[{"hadithnumber":4219,"arabicnumber":4219,"text":"আহমদ ইবন হাফস ইবন আবদুল্লাহ (রহঃ) ... ইবন আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম হাসান এবং হুসায়নের আকীকায় দু'টি করে বকরী যবেহ করেন।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":40,"hadith":8}}]}