{"metadata":{"name":"Sunan an Nasai","section":{"43":"The Book of ad-Dahaya (Sacrifices)"},"section_detail":{"43":{"hadithnumber_first":4361,"hadithnumber_last":4448,"arabicnumber_first":4361,"arabicnumber_last":4448,"name_native":"কোরবানি অধ্যায়"}}},"hadiths":[{"hadithnumber":4423,"arabicnumber":4423,"text":"ইসহাক ইবন ইব্রাহীম (রহঃ) ... ইবন উমর (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তিন দিনের পরেও কুরবানীর গোশত আহার করতে নিষেধ করেছেন।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":43,"hadith":63}}]}