{"metadata":{"name":"Sunan an Nasai","section":{"44":"The Book of Financial Transactions"},"section_detail":{"44":{"hadithnumber_first":4449,"hadithnumber_last":4705,"arabicnumber_first":4449,"arabicnumber_last":4705,"name_native":"আর্থিক লেনদেনের বই"}}},"hadiths":[{"hadithnumber":4535,"arabicnumber":4535,"text":"কুতায়বা ইবন সাঈদ (রহঃ) ... রাফি' ইবন খাদিজ (রাঃ) থেকে বর্ণিত, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম নিষেধ করেছেন, মুহাকালা এবং মুযাবানা ধরনের ক্রয়-বিক্রয় হতে।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":44,"hadith":87}}]}