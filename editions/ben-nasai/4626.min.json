{"metadata":{"name":"Sunan an Nasai","section":{"44":"The Book of Financial Transactions"},"section_detail":{"44":{"hadithnumber_first":4449,"hadithnumber_last":4705,"arabicnumber_first":4449,"arabicnumber_last":4705,"name_native":"আর্থিক লেনদেনের বই"}}},"hadiths":[{"hadithnumber":4626,"arabicnumber":4626,"text":"মুহাম্মদ ইবন মানসূর (রহঃ) ... জাবির (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কয়েক বছরের জন্য ফল বিক্রয় করতে নিষেধ করেছেন।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":44,"hadith":178}}]}