{"metadata":{"name":"Sunan an Nasai","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"অলঙ্করণ বই"}}},"hadiths":[{"hadithnumber":5072,"arabicnumber":5072,"text":"আলী ইবন খাশরাম (রহঃ) ... আবূ হুরায়রা (রাঃ) থেকে বর্ণিত, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ ইয়াহুদী ও নাসারা খিযাব লাগায় না, তোমরা তাদের বিরোধিতায় খিযাব লাগাবে।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":48,"hadith":33}}]}