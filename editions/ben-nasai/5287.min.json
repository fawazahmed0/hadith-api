{"metadata":{"name":"Sunan an Nasai","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"অলঙ্করণ বই"}}},"hadiths":[{"hadithnumber":5287,"arabicnumber":5287,"text":"হান্নাদ ইবন সারী (রহঃ) ... আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে তর্জনী, মধ্যমা এবং এর নিকটবর্তী আঙ্গুলে আংটি পরতে নিষেধ করেছেন।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":48,"hadith":248}}]}