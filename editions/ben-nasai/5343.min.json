{"metadata":{"name":"Sunan an Nasai","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"অলঙ্করণ বই"}}},"hadiths":[{"hadithnumber":5343,"arabicnumber":5343,"text":"আবদুল্লাহ্ ইবন মুহাম্মদ (রহঃ) ... আমর ইবন হুরায়স (রহঃ) তাঁর পিতা থেকে বর্ণনা করেন, তিনি বলেন, আমি রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর মাথায় ছাইরঙা পাগড়ি দেখেছি।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":48,"hadith":304}}]}