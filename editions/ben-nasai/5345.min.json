{"metadata":{"name":"Sunan an Nasai","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"অলঙ্করণ বই"}}},"hadiths":[{"hadithnumber":5345,"arabicnumber":5345,"text":"আমর ইবন মানসূর (রহঃ) ... জাবির (রাঃ) বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মক্কা বিজয়ের দিন মক্কায় প্রবেশ করেন, তখন তাঁর মাথায় কালো পাগড়ি ছিল।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":48,"hadith":306}}]}