{"metadata":{"name":"Sunan an Nasai","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"অলঙ্করণ বই"}}},"hadiths":[{"hadithnumber":5366,"arabicnumber":5366,"text":"হাসান ইবন কাযা'আ (রহঃ) ... আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদের গায়ে দেওয়ার চাদরে নামায পড়তেন না।","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":48,"hadith":327}}]}