{"metadata":{"name":"Sunan an Nasai","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"পানীয় অধ্যায়"}}},"hadiths":[{"hadithnumber":5714,"arabicnumber":5714,"text":"সুওয়ায়দ (রহঃ) ... ইবন সীরীন (রহঃ) থেকে বর্ণিত। তিনি বলেন, ঐ ব্যক্তির নিকট রস বিক্রি কর, যে তা জ্বালিয়ে তিলা (জেলি) বানাবে; মদ বানাবে না।","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad Maqtu"},{"name":"Al-Albani","grade":"Sahih Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":51,"hadith":176}}]}