{"metadata":{"name":"Sunan an Nasai","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"পানীয় অধ্যায়"}}},"hadiths":[{"hadithnumber":5742,"arabicnumber":5742,"text":"সুওয়ায়দ (রহঃ) ... আবদুল্লাহ (রহঃ) থেকে বর্ণিত। তিনি বলেন, আমি শুনেছি, সুফইয়ানকে নবীয সম্পর্কে জিজ্ঞাসা করা হলে তিনি বললেনঃ তা সন্ধ্যায় ভিজিয়ে রেখে ভোরে পান করবে।","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad Maqtu"},{"name":"Al-Albani","grade":"Sahih Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":51,"hadith":204}}]}