{"metadata":{"name":"Jami At Tirmidhi","section":{"14":"The Book on Business"},"section_detail":{"14":{"hadithnumber_first":1205,"hadithnumber_last":1321,"arabicnumber_first":1205,"arabicnumber_last":1321,"name_native":"ব্যবসার উপর বই"}}},"hadiths":[{"hadithnumber":1226,"arabicnumber":1226,"text":"। ইবনু উমর (রাঃ) হতে বর্ণিত আছে, খেজুরের লাল বা হলুদ বর্ণ না আসা পর্যন্ত তা বিক্রয় করতে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বারণ করেছেন। - সহীহ, বেচা-কেনার হাদীস।","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih Hadith"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":14,"hadith":26}}]}