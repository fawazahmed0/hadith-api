{"metadata":{"name":"Jami At Tirmidhi","name_native":"জামি আত-তিরমিজি","section":{"24":"The Book on Clothing"},"section_detail":{"24":{"hadithnumber_first":1720,"hadithnumber_last":1787,"arabicnumber_first":1720,"arabicnumber_last":1787,"name_native":"পোষাক-পরিচ্ছদ অধ্যায়"}}},"hadiths":[{"hadithnumber":1764,"arabicnumber":1764,"text":"। উম্মু সালামা (রাঃ) হতে বর্ণিত আছে, তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লামের সবচাইতে পছন্দনীয় পোশাক ছিল জামা। সহীহ, দেখুন পূর্বের হাদীস","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":24,"hadith":47}}]}