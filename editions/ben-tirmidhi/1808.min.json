{"metadata":{"name":"Jami At Tirmidhi","name_native":"জামি আত-তিরমিজি","section":{"25":"The Book on Food"},"section_detail":{"25":{"hadithnumber_first":1788,"hadithnumber_last":1860,"arabicnumber_first":1788,"arabicnumber_last":1860,"name_native":"খাদ্য বিষয়ক বই"}}},"hadiths":[{"hadithnumber":1808,"arabicnumber":1808,"text":"। আলী (রাঃ) হতে বর্ণিত আছে, তিনি বলেন, রসুন রান্না না করে (কাঁচা) খেতে নিষেধ করা হয়েছে। সহীহ, ইরওয়া","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":25,"hadith":22}}]}