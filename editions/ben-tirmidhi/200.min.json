{"metadata":{"name":"Jami At Tirmidhi","section":{"2":"The Book on Salat (Prayer)"},"section_detail":{"2":{"hadithnumber_first":149,"hadithnumber_last":451,"arabicnumber_first":149,"arabicnumber_last":451,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":200,"arabicnumber":200,"text":"। আবূ হুরাইরা (রাঃ) হতে বর্ণিত আছে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ বিনা ওযুতে কেউ যেন আযান না দেয়। যঈফ, ইরওয়া","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Daif"},{"name":"Al-Albani","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":2,"hadith":52}}]}