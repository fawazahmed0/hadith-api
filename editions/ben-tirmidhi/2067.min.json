{"metadata":{"name":"Jami At Tirmidhi","name_native":"জামি আত-তিরমিজি","section":{"28":"Chapters on Medicine"},"section_detail":{"28":{"hadithnumber_first":2036,"hadithnumber_last":2089,"arabicnumber_first":2036,"arabicnumber_last":2089,"name_native":"চিকিৎসা অধ্যায়"}}},"hadiths":[{"hadithnumber":2067,"arabicnumber":2067,"text":"। সাঈদ ইবনু যাইদ (রাঃ) হতে বর্ণিত আছে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ ছত্রাক’ মান্নের অন্তর্ভুক্ত। এর পানি চোখের জন্য নিরাময়। সহীহ, রাওযুন নায়ীর (৪৪৪), বুখারী, মুসলিম। আবূ ঈসা বলেন, এ হাদীসটি হাসান সহীহ।","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":28,"hadith":32}}]}