{"metadata":{"name":"Jami At Tirmidhi","name_native":"জামি আত-তিরমিজি","section":{"49":"Chapters on Virtues"},"section_detail":{"49":{"hadithnumber_first":3605,"hadithnumber_last":3956,"arabicnumber_first":3605,"arabicnumber_last":3956,"name_native":"গুণাবলীর অধ্যায়"}}},"hadiths":[{"hadithnumber":3809,"arabicnumber":3809,"text":"। আলী (রাঃ) হতে বর্ণিত আছে, তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ আমি পরামর্শ ছাড়া কাউকে নেতার পদ দিলে ইবনু উম্মি আবদকেই নেতার পদ দিতাম। যঈফ, দেখুন পূর্বের হাদীস","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Daif"},{"name":"Al-Albani","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":49,"hadith":209}}]}