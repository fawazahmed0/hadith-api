{"metadata":{"name":"Jami At Tirmidhi","section":{"2":"The Book on Salat (Prayer)"},"section_detail":{"2":{"hadithnumber_first":149,"hadithnumber_last":451,"arabicnumber_first":149,"arabicnumber_last":451,"name_native":"সালাত (নামাজ) অধ্যায়"}}},"hadiths":[{"hadithnumber":434,"arabicnumber":434,"text":"। সালিম হতে ও ইবনু উমার (রাঃ) সূত্রে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লামের নিকট হতে .... একই হাদীস পুনর্বার বর্ণিত হয়েছে। আবু ঈসা বলেনঃ এ হাদীসটি হাসান সহীহ্।","grades":[{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":2,"hadith":287}}]}