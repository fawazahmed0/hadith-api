{"metadata":{"name":"Sunan Abu Dawud","section":{"5":"Prayer (Kitab Al-Salat): Voluntary Prayers"},"section_detail":{"5":{"hadithnumber_first":1250,"hadithnumber_last":1370,"arabicnumber_first":1250,"arabicnumber_last":1370,"name_native":"Prayer (Kitab Al-Salat): Voluntary Prayers"}}},"hadiths":[{"hadithnumber":1317,"arabicnumber":1317,"text":"Masruq said:I asked 'Aishah about the prayer of the Messenger of Allah (ﷺ), and I said to her: At what time he prayed at night ? She said: When he heard the cock crow, he got up and prayed","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (1132) Sahih Muslim (741)"}],"reference":{"book":5,"hadith":68}}]}