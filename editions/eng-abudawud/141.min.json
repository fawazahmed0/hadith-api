{"metadata":{"name":"Sunan Abu Dawud","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"Purification (Kitab Al-Taharah)"}}},"hadiths":[{"hadithnumber":141,"arabicnumber":141,"text":"Narrated Abdullah ibn Abbas: The Messenger of Allah (ﷺ) said: Cleanse your nose well (after snuffing up water) twice or thrice","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":1,"hadith":141}}]}