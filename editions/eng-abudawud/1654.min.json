{"metadata":{"name":"Sunan Abu Dawud","section":{"9":"Zakat (Kitab Al-Zakat)"},"section_detail":{"9":{"hadithnumber_first":1556,"hadithnumber_last":1700,"arabicnumber_first":1556,"arabicnumber_last":1700,"name_native":"Zakat (Kitab Al-Zakat)"}}},"hadiths":[{"hadithnumber":1654,"arabicnumber":1654,"text":"The aforesaid tradition has also been transmitted by Ibn Abbas through a different chain of narrators in a similar manner. This version adds :“My father exchanged them for him”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":9,"hadith":99}}]}