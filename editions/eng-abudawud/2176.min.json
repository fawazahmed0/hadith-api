{"metadata":{"name":"Sunan Abu Dawud","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"Divorce (Kitab Al-Talaq)"}}},"hadiths":[{"hadithnumber":2176,"arabicnumber":2176,"text":"Abu Hurairah reported the Apostle of Allaah(ﷺ) as saying “A woman should not ask for the divorce of her sister to make her bowl vacant for her and to marry him. She will have what is decreed for her.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (6601)"}],"reference":{"book":13,"hadith":2}}]}