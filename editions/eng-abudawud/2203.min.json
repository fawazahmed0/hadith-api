{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sunan Abu Dawud","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"Divorce (Kitab Al-Talaq)"}}},"hadiths":[{"hadithnumber":2203,"arabicnumber":2203,"text":"A’ishah said The Apostle of Allaah(ﷺ) gave us our choice and we chose him so that was not reckoned anything (i.e., divorce)","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (5262) Sahih Muslim (1477)"}],"reference":{"book":13,"hadith":29}}]}