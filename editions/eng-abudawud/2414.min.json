{"metadata":{"name":"Sunan Abu Dawud","section":{"14":"Fasting (Kitab Al-Siyam)"},"section_detail":{"14":{"hadithnumber_first":2313,"hadithnumber_last":2476,"arabicnumber_first":2313,"arabicnumber_last":2476,"name_native":"Fasting (Kitab Al-Siyam)"}}},"hadiths":[{"hadithnumber":2414,"arabicnumber":2414,"text":"Nafi' said:Ibn 'Umar used to go out to al-Ghabah (jungle), but he neither broke his fast, nor shortened his prayer","grades":[{"name":"Al-Albani","grade":"Sahih Muquf"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Muquf"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":14,"hadith":102}}]}