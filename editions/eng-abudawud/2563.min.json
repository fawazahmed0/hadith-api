{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sunan Abu Dawud","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"Jihad (Kitab Al-Jihad)"}}},"hadiths":[{"hadithnumber":2563,"arabicnumber":2563,"text":"Anas bin Malik said “I brought my brother when he was born to Prophet(ﷺ) to chew something for him and rub his palate with it and found him in a sheep pen branding the sheep, I think, on their ears.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (5542) Sahih Muslim (2119)"}],"reference":{"book":15,"hadith":87}}]}