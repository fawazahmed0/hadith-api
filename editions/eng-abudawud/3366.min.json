{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sunan Abu Dawud","section":{"23":"Commercial Transactions (Kitab Al-Buyu)"},"section_detail":{"23":{"hadithnumber_first":3326,"hadithnumber_last":3415,"arabicnumber_first":3326,"arabicnumber_last":3415,"name_native":"Commercial Transactions (Kitab Al-Buyu)"}}},"hadiths":[{"hadithnumber":3366,"arabicnumber":3366,"text":"Ibn Ishaq said:'Araya means that a man lends another man some palm-trees, but he (the owner) feels inconvenient that the man looks after the trees (by frequent visits). He (the borrower) sells them (to the owner) by calculation","grades":[{"name":"Al-Albani","grade":"Sahih Isnaad Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":23,"hadith":41}}]}