{"metadata":{"name":"Sunan Abu Dawud","section":{"27":"Drinks (Kitab Al-Ashribah)"},"section_detail":{"27":{"hadithnumber_first":3669,"hadithnumber_last":3735,"arabicnumber_first":3669,"arabicnumber_last":3735,"name_native":"Drinks (Kitab Al-Ashribah)"}}},"hadiths":[{"hadithnumber":3702,"arabicnumber":3702,"text":"Jabir b. ‘Abd Allah said:Dates were steeped for the Messenger of Allah (ﷺ) in a skin, but when they could not find a skin, they were steeped for him in a small stone vessel","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1998)"}],"reference":{"book":27,"hadith":34}}]}