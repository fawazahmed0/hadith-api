{"metadata":{"name":"Sunan Abu Dawud","section":{"28":"Foods (Kitab Al-At'imah)"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854,"name_native":"Foods (Kitab Al-At'imah)"}}},"hadiths":[{"hadithnumber":3811,"arabicnumber":3811,"text":"Narrated Abdullah ibn Amr ibn al-'As: On the day of Khaybar the Messenger of Allah (may pease be upon him) forbade (eating) the flesh of domestic asses, and the animal which feeds on filth: riding it and eating its flesh","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":28,"hadith":76}}]}