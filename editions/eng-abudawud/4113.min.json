{"metadata":{"name":"Sunan Abu Dawud","section":{"34":"Clothing (Kitab Al-Libas)"},"section_detail":{"34":{"hadithnumber_first":4020,"hadithnumber_last":4158,"arabicnumber_first":4020,"arabicnumber_last":4158,"name_native":"Clothing (Kitab Al-Libas)"}}},"hadiths":[{"hadithnumber":4113,"arabicnumber":4113,"text":"Narrated 'Amr b. Suh'aib: On his father's authority, said that his grandfather reported the Prophet (ﷺ) said: When one of you marries his male-slave to his slave-woman, he should not look at her private parts","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":34,"hadith":94}}]}