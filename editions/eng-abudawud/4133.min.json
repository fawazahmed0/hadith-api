{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sunan Abu Dawud","section":{"34":"Clothing (Kitab Al-Libas)"},"section_detail":{"34":{"hadithnumber_first":4020,"hadithnumber_last":4158,"arabicnumber_first":4020,"arabicnumber_last":4158,"name_native":"Clothing (Kitab Al-Libas)"}}},"hadiths":[{"hadithnumber":4133,"arabicnumber":4133,"text":"Narrated Jabir:We were with the Prophet (ﷺ) on a journey. He said: Make a general practice of wearing sandals, for a man keeps riding as long as he wears sandals","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (2096)"}],"reference":{"book":34,"hadith":114}}]}