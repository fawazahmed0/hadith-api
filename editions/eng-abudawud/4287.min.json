{"metadata":{"name":"Sunan Abu Dawud","section":{"38":"The Promised Deliverer (Kitab Al-Mahdi)"},"section_detail":{"38":{"hadithnumber_first":4279,"hadithnumber_last":4290,"arabicnumber_first":4279,"arabicnumber_last":4290,"name_native":"The Promised Deliverer (Kitab Al-Mahdi)"}}},"hadiths":[{"hadithnumber":4287,"arabicnumber":4287,"text":"The tradition mentioned above has also been transmitted by Qatadah through a different chain of narrators. This version has \"nine years\". Abu Dawud said:The other narrators mentioned \"nine years\" from Hisham except Mu'adh","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":38,"hadith":9}}]}