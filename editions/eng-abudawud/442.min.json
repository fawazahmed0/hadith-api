{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"Prayer (Kitab Al-Salat)"}}},"hadiths":[{"hadithnumber":442,"arabicnumber":442,"text":"Anas b. Malik reported the Prophet (ﷺ) as saying:If any one forgets a prayer or oversleeps, he should observe it when he remembers it ; there is no expiation for it except that","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (597) Sahih Muslim (684)"}],"reference":{"book":2,"hadith":52}}]}