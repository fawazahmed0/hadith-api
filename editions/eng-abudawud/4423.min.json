{"metadata":{"name":"Sunan Abu Dawud","section":{"40":"Prescribed Punishments (Kitab Al-Hudud)"},"section_detail":{"40":{"hadithnumber_first":4351,"hadithnumber_last":4493,"arabicnumber_first":4351,"arabicnumber_last":4493,"name_native":"Prescribed Punishments (Kitab Al-Hudud)"}}},"hadiths":[{"hadithnumber":4423,"arabicnumber":4423,"text":"Simak said:I heard this tradition from Jabir b. Samurah. But the first version is more perfect. This version has: He repeated twice, Simak said: I narrated to Sa’id b. Jubair. He said: He repeated it four times","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1692)"}],"reference":{"book":40,"hadith":73}}]}