{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sunan Abu Dawud","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"General Behavior (Kitab Al-Adab)"}}},"hadiths":[{"hadithnumber":5228,"arabicnumber":5228,"text":"Abu Qatadah said:The Prophet (ﷺ) was on journey. The people became thirsty, and they went quickly. I guarded the Messenger of Allah(ﷺ) on that night. He said: May Allah guard you for the reason you have guarded His Prophet","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (681)"}],"reference":{"book":43,"hadith":456}}]}