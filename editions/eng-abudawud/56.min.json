{"metadata":{"name":"Sunan Abu Dawud","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"Purification (Kitab Al-Taharah)"}}},"hadiths":[{"hadithnumber":56,"arabicnumber":56,"text":"Narrated Aisha, Ummul Mu'minin: Ablution water and tooth-stick were placed by the side of the Prophet (ﷺ). When he got up during the night (for prayer), he relieved himself, then he used the tooth-stick","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":1,"hadith":56}}]}