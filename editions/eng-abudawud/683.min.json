{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"Prayer (Kitab Al-Salat)"}}},"hadiths":[{"hadithnumber":683,"arabicnumber":683,"text":"Abu Bakrah said that he came to the mosque when the prophet (ﷺ) was bowing. So I bowed outside the row (before joining it). The prophet (ﷺ) said; May Allah increase your eagerness! But do not do it again","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (783)"}],"reference":{"book":2,"hadith":293}}]}