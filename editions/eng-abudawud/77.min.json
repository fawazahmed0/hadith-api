{"metadata":{"name":"Sunan Abu Dawud","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"Purification (Kitab Al-Taharah)"}}},"hadiths":[{"hadithnumber":77,"arabicnumber":77,"text":"Narrated Aishah :I and the Messenger of Allaah ( sal Allaahu alayhi wa sallam ) took a bath from one vessel while we were sexually defiled","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (299)"}],"reference":{"book":1,"hadith":77}}]}