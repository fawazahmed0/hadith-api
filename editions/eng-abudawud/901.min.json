{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"Prayer (Kitab Al-Salat)"}}},"hadiths":[{"hadithnumber":901,"arabicnumber":901,"text":"Abu Hurairah reported the Prophet(ﷺ) as saying:when one of you prostrates himself, he should not stretch out his forearms( on the ground) like a dog and he should join both of his thighs","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":2,"hadith":511}}]}