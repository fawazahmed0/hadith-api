{"metadata":{"name":"Sunan Ibn Majah","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"The Book of the Sunnah"}}},"hadiths":[{"hadithnumber":101,"arabicnumber":101,"text":"It was narrated that Anas said:\"It was said: 'O Messenger of Allah, which of the people is most beloved to you?' He said: \"Aishah.' It was asked, 'And among men?' He said: 'Her father","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":0,"hadith":101}}]}