{"metadata":{"name":"Sunan Ibn Majah","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"The Book of the Sunnah"}}},"hadiths":[{"hadithnumber":142,"arabicnumber":142,"text":"It was narrated from Abu Hurairah that:The Prophet said to Hasan: \"O Allah, I love him, so love him and love those who love him.\" He said: \"And he hugged him to his chest","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}],"reference":{"book":0,"hadith":142}}]}