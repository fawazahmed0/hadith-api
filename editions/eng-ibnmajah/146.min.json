{"metadata":{"name":"Sunan Ibn Majah","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"The Book of the Sunnah"}}},"hadiths":[{"hadithnumber":146,"arabicnumber":146,"text":"It was narrated that 'Ali bin Abu Talib said:\"I was sitting with the Prophet, and 'Ammar bin Yasir asked permission to enter. The Prophet said: 'Let him in, welcome to the good and the purified","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":0,"hadith":146}}]}