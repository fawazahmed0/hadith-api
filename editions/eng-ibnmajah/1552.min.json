{"metadata":{"name":"Sunan Ibn Majah","section":{"6":"Chapters Regarding Funerals"},"section_detail":{"6":{"hadithnumber_first":1433,"hadithnumber_last":1637,"arabicnumber_first":1433,"arabicnumber_last":1637,"name_native":"Chapters Regarding Funerals"}}},"hadiths":[{"hadithnumber":1552,"arabicnumber":1552,"text":"It was narrated from Abu Sa’eed that the Messenger of Allah (ﷺ) was brought into his grave from the direction of the Qiblah, and he was placed in his grave gently","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":6,"hadith":120}}]}