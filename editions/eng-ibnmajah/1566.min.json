{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"6":"Chapters Regarding Funerals"},"section_detail":{"6":{"hadithnumber_first":1433,"hadithnumber_last":1637,"arabicnumber_first":1433,"arabicnumber_last":1637,"name_native":"Chapters Regarding Funerals"}}},"hadiths":[{"hadithnumber":1566,"arabicnumber":1566,"text":"It was narrated from Abu Hurairah said:The Messenger of Allah (ﷺ) said: “If one of you were to sit on a live coal that burns him, that would be better for him than if he were to sit on a grave.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":6,"hadith":134}}]}