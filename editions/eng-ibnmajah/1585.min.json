{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"6":"Chapters Regarding Funerals"},"section_detail":{"6":{"hadithnumber_first":1433,"hadithnumber_last":1637,"arabicnumber_first":1433,"arabicnumber_last":1637,"name_native":"Chapters Regarding Funerals"}}},"hadiths":[{"hadithnumber":1585,"arabicnumber":1585,"text":"It was narrated from Abu Umamah that the Messenger of Allah (ﷺ) cursed the woman who scratches her face and rends her garment and cries that she is doomed (i.e. because of the death of this person)","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":6,"hadith":153}}]}