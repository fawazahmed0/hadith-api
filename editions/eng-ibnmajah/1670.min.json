{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"Fasting"}}},"hadiths":[{"hadithnumber":1670,"arabicnumber":1670,"text":"It was narrated that ‘Aishah said:“We used to menstruate at the time of the Prophet (ﷺ), and he would order us to make up for the (missed) fasts.’”","grades":[{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":7,"hadith":33}}]}