{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"Fasting"}}},"hadiths":[{"hadithnumber":1693,"arabicnumber":1693,"text":"It was narrated from Ibn ‘Abbas that the Prophet (ﷺ) said:“Seek help by eating Suhur for fasting that day, and by taking a brief rest (at midday) for praying at night.”","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":7,"hadith":56}}]}