{"metadata":{"name":"Sunan Ibn Majah","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"Fasting"}}},"hadiths":[{"hadithnumber":1705,"arabicnumber":1705,"text":"It was narrated from ‘Abdullah bin Shikhkhir that his father said:“The Prophet (ﷺ) said: ‘Whoever fasts continually, he neither fasts nor breaks his fast.’”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":7,"hadith":68}}]}