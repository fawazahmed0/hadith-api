{"metadata":{"name":"Sunan Ibn Majah","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"Fasting"}}},"hadiths":[{"hadithnumber":1738,"arabicnumber":1738,"text":"It was narrated from Abu Qatadah that the Messenger of Allah (ﷺ) said:“Fasting the day of ‘Ashura’, I hope, will expiate for the sins of the previous year.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":7,"hadith":101}}]}