{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"Fasting"}}},"hadiths":[{"hadithnumber":1742,"arabicnumber":1742,"text":"It was narrated that Abu Hurairah said:“A man came to the Prophet (ﷺ) and said: ‘Which fasting is better after the month of Ramadan?’ He said: ‘The month of Allah which is called Muharram.’”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":7,"hadith":105}}]}