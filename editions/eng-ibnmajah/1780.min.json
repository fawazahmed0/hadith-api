{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"Fasting"}}},"hadiths":[{"hadithnumber":1780,"arabicnumber":1780,"text":"‘Aishah said:“One of the wives of the Messenger of Allah (ﷺ) observed I’tikaf with him, and she used to see red and yellow discharge, and sometime she would put a basin beneath her.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":7,"hadith":143}}]}