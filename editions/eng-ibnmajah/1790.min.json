{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"8":"The Chapters Regarding Zakat"},"section_detail":{"8":{"hadithnumber_first":1783,"hadithnumber_last":1844,"arabicnumber_first":1783,"arabicnumber_last":1844,"name_native":"The Chapters Regarding Zakat"}}},"hadiths":[{"hadithnumber":1790,"arabicnumber":1790,"text":"Ali narrated that:the Messenger of Allah said: “I have exempted you from having to pay Zakat on horses and slaves, bring one quarter of one-tenth of every forty Dirhan: one Dirham.”","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":8,"hadith":8}}]}