{"metadata":{"name":"Sunan Ibn Majah","section":{"9":"The Chapters on Marriage"},"section_detail":{"9":{"hadithnumber_first":1845,"hadithnumber_last":2015,"arabicnumber_first":1845,"arabicnumber_last":2015,"name_native":"The Chapters on Marriage"}}},"hadiths":[{"hadithnumber":1941,"arabicnumber":1941,"text":"It was narrated from 'Aishah:that the Prophet Allah said: “Suckling once or twice does not make (marriage) unlawful.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":9,"hadith":97}}]}