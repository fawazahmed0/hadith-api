{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"9":"The Chapters on Marriage"},"section_detail":{"9":{"hadithnumber_first":1845,"hadithnumber_last":2015,"arabicnumber_first":1845,"arabicnumber_last":2015,"name_native":"The Chapters on Marriage"}}},"hadiths":[{"hadithnumber":1953,"arabicnumber":1953,"text":"It was narrated that Ibn 'Umar said:“Ghailan bin Salamah became Muslim and he had ten wives. The Prophet said to him: 'Choose four of them.' ”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":9,"hadith":109}}]}