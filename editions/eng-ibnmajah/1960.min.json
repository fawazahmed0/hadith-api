{"metadata":{"name":"Sunan Ibn Majah","section":{"9":"The Chapters on Marriage"},"section_detail":{"9":{"hadithnumber_first":1845,"hadithnumber_last":2015,"arabicnumber_first":1845,"arabicnumber_last":2015,"name_native":"The Chapters on Marriage"}}},"hadiths":[{"hadithnumber":1960,"arabicnumber":1960,"text":"It was narrated from Ibn 'Umar:that the Messenger of Allah said : \"Any slave who gets married without his master's permission, is a fornicator","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Lighairihi"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":9,"hadith":116}}]}