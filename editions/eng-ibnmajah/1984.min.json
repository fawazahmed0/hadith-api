{"metadata":{"name":"Sunan Ibn Majah","section":{"9":"The Chapters on Marriage"},"section_detail":{"9":{"hadithnumber_first":1845,"hadithnumber_last":2015,"arabicnumber_first":1845,"arabicnumber_last":2015,"name_native":"The Chapters on Marriage"}}},"hadiths":[{"hadithnumber":1984,"arabicnumber":1984,"text":"It was narrated that 'Aishah said:\"The Messenger of Allah never beat any of his servants, or wives, and his hand never hit anything","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":9,"hadith":140}}]}