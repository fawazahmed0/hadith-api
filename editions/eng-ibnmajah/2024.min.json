{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"10":"The Chapters on Divorce"},"section_detail":{"10":{"hadithnumber_first":2016,"hadithnumber_last":2477,"arabicnumber_first":2016,"arabicnumber_last":2477,"name_native":"The Chapters on Divorce"}}},"hadiths":[{"hadithnumber":2024,"arabicnumber":2024,"text":"It was narrated that 'Amir Sha'bi said:\"I said to Fatimah bint Qais: 'Tell me about your divorce.' She said: 'My husband divorced me three times when he was leaving for Yemen, and the Messenger of Allah (ﷺ) allowed that","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":10,"hadith":9}}]}