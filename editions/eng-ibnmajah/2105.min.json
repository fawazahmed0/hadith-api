{"metadata":{"name":"Sunan Ibn Majah","section":{"11":"The Chapters on Expiation"},"section_detail":{"11":{"hadithnumber_first":2090,"hadithnumber_last":2136,"arabicnumber_first":2090,"arabicnumber_last":2136,"name_native":"The Chapters on Expiation"}}},"hadiths":[{"hadithnumber":2105,"arabicnumber":2105,"text":"It was narrated from Ibn 'Umar that the Messenger of Allah (ﷺ) said:\"Whoever swears an oath and says In sha' Allah, if he wishes he may go ahead and if he wishes he may not, without having broken his oath","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":11,"hadith":16}}]}