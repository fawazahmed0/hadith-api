{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"The Chapters on Business Transactions"}}},"hadiths":[{"hadithnumber":2203,"arabicnumber":2203,"text":"It was narrated from Jabir bin 'Abdullah that the Messenger of Allah (ﷺ) said:\"May Allah have mercy on a person who is lenient when he sells, lenient when he buys, and lenient when he asks for payment","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":12,"hadith":67}}]}