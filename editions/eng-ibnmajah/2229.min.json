{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"12":"The Chapters on Business Transactions"},"section_detail":{"12":{"hadithnumber_first":2137,"hadithnumber_last":2307,"arabicnumber_first":2137,"arabicnumber_last":2307,"name_native":"The Chapters on Business Transactions"}}},"hadiths":[{"hadithnumber":2229,"arabicnumber":2229,"text":"It was narrated that Ibn 'Umar said:\"We used to buy food from troops of riders (i.e., the caravans) without knowing the amount, but the Messenger of Allah (ﷺ) forbade us to sell it until it had been delivered to us","grades":[{"name":"Al-Albani","grade":"Sahih Hadith"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":12,"hadith":93}}]}