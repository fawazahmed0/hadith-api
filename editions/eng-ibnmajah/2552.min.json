{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"20":"The Chapters on Legal Punishments"},"section_detail":{"20":{"hadithnumber_first":2533,"hadithnumber_last":2614,"arabicnumber_first":2533,"arabicnumber_last":2614,"name_native":"The Chapters on Legal Punishments"}}},"hadiths":[{"hadithnumber":2552,"arabicnumber":2552,"text":"It was narrated from Salamah bin Muhabbiq that:the case of a man who had intercourse with the slave woman of his wife was referred to the Messenger of Allah (ﷺ), and he did not stipulate any legal punishment for him","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":20,"hadith":20}}]}