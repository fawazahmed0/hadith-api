{"metadata":{"name":"Sunan Ibn Majah","section":{"21":"The Chapters on Blood Money"},"section_detail":{"21":{"hadithnumber_first":2615,"hadithnumber_last":2694,"arabicnumber_first":2615,"arabicnumber_last":2694,"name_native":"The Chapters on Blood Money"}}},"hadiths":[{"hadithnumber":2617,"arabicnumber":2617,"text":"It was narrated from Abdullah that the Messenger of Allah (ﷺ) said:The first matter concerning which judgment will be passed among the people on the Day of Resurrection will be bloodshed.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":21,"hadith":3}}]}