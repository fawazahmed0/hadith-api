{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"24":"The Chapters on Jihad"},"section_detail":{"24":{"hadithnumber_first":2753,"hadithnumber_last":2881,"arabicnumber_first":2753,"arabicnumber_last":2881,"name_native":"The Chapters on Jihad"}}},"hadiths":[{"hadithnumber":2839,"arabicnumber":2839,"text":"It was narrated that Ibn ‘Abbas said:“Sa’b bin Jaththamah said: ‘The Prophet (ﷺ) was asked about the polytheists who are attacked at night, and their women and children are killed.’ He said: ‘They are from among them.’”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":24,"hadith":87}}]}