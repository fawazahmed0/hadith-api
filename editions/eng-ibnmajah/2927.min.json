{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"Chapters on Hajj Rituals"}}},"hadiths":[{"hadithnumber":2927,"arabicnumber":2927,"text":"It was narrated that ‘Aishah said:“It is as if I can see the races of perfume in the parting (of hair) of the Messenger of Allah (ﷺ), while he is reciting the Talbiyah.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":25,"hadith":46}}]}