{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"Chapters on Hajj Rituals"}}},"hadiths":[{"hadithnumber":2956,"arabicnumber":2956,"text":"It was narrated that ‘Abdullah bin ‘Umar said:“I heard the Messenger of Allah (ﷺ) say: ‘Whoever performs Tawaf around the House and prays two Rak’ah, it is as if he freed a slave.’”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":25,"hadith":75}}]}