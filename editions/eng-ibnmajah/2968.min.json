{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"Chapters on Hajj Rituals"}}},"hadiths":[{"hadithnumber":2968,"arabicnumber":2968,"text":"It was narrated that Anas bin Malik said:“We went out with the Messenger of Allah (ﷺ) to Makkah, and I heard him say: ‘Labbaika ‘Umratan wa hajjatan [Here I am (O Allah), for ‘Umrah and Hajj].’”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":25,"hadith":87}}]}