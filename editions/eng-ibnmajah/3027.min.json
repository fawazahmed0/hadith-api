{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"Chapters on Hajj Rituals"}}},"hadiths":[{"hadithnumber":3027,"arabicnumber":3027,"text":"It was narrated from ‘Aishah that Sawdah bint Zam’ah was a slow- moving woman, so she asked the Messenger of Allah (ﷺ) for permission to depart from Jam’ ahead of the people, and he gave her permission","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":25,"hadith":146}}]}