{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"Chapters on Hajj Rituals"}}},"hadiths":[{"hadithnumber":3053,"arabicnumber":3053,"text":"It was narrated that Jabir said:“I saw the Messenger of Allah (ﷺ) stoning ‘Aqabah Pillar at forenoon, but after that day, he would do it after the sun had passed its zenith.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":25,"hadith":172}}]}