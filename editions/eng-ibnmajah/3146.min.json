{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"26":"Chapters on Sacrifices"},"section_detail":{"26":{"hadithnumber_first":3120,"hadithnumber_last":3161,"arabicnumber_first":3120,"arabicnumber_last":3161,"name_native":"Chapters on Sacrifices"}}},"hadiths":[{"hadithnumber":3146,"arabicnumber":3146,"text":"It was narrated that Abu Sa’eed Al-Khudri said:“We bought a ram for sacrifice, then a wolf tore some flesh from its rump and ears. We asked the Prophet (ﷺ) and he told us to offer it as a sacrifice.”","grades":[{"name":"Al-Albani","grade":"Very Daif Isnaad"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":26,"hadith":27}}]}