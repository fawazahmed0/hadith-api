{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"27":"Chapters on Slaughtering"},"section_detail":{"27":{"hadithnumber_first":3162,"hadithnumber_last":3199,"arabicnumber_first":3162,"arabicnumber_last":3199,"name_native":"Chapters on Slaughtering"}}},"hadiths":[{"hadithnumber":3197,"arabicnumber":3197,"text":"It was narrated that ‘Ata’ narrated that Jabir bin ‘Abdullah said:“We used to eat the meat of horses.” I said: “And mules?” He said: “No.”","grades":[{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":27,"hadith":36}}]}