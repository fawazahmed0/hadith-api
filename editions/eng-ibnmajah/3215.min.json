{"metadata":{"name":"Sunan Ibn Majah","section":{"28":"Chapters on Hunting"},"section_detail":{"28":{"hadithnumber_first":3200,"hadithnumber_last":3250,"arabicnumber_first":3200,"arabicnumber_last":3250,"name_native":"Chapters on Hunting"}}},"hadiths":[{"hadithnumber":3215,"arabicnumber":3215,"text":"It was narrated that ‘Adi bit Hatim said:“I asked the Messenger of Allah (ﷺ) about Mi’rad. He said: ‘Do not eat unless you pierce (the game).’”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":28,"hadith":16}}]}