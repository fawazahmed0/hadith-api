{"metadata":{"name":"Sunan Ibn Majah","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":" Chapters on Food"}}},"hadiths":[{"hadithnumber":3268,"arabicnumber":3268,"text":"It was narrated from Jabir that the Messenger of Allah (ﷺ) said:“Do not eat with your left hand, for Satan eats with his left hand.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":29,"hadith":18}}]}