{"metadata":{"name":"Sunan Ibn Majah","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":" Chapters on Food"}}},"hadiths":[{"hadithnumber":3313,"arabicnumber":3313,"text":"It was narrated that ‘Aishah said:“We used to store trotters and the Messenger of Allah (ﷺ) would eat them fifteen days after the sacrifice.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":29,"hadith":63}}]}