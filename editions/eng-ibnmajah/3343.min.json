{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":" Chapters on Food"}}},"hadiths":[{"hadithnumber":3343,"arabicnumber":3343,"text":"It was narrated that Abu Hurairah said:“By the One in Whose Hand is my soul, the Prophet of Allah (ﷺ) never ate his fill of wheat bread for three days in a row, until Allah took his soul.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":29,"hadith":93}}]}