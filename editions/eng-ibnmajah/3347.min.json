{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":" Chapters on Food"}}},"hadiths":[{"hadithnumber":3347,"arabicnumber":3347,"text":"It was narrated that Ibn ‘Abbas said:“The Messenger of Allah (ﷺ) used to spend many nights in a row hungry and his family could find no supper, and usually their bread was barley bread.”","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":29,"hadith":97}}]}