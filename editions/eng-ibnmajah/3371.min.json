{"metadata":{"name":"Sunan Ibn Majah","section":{"30":"Chapters on Drinks"},"section_detail":{"30":{"hadithnumber_first":3371,"hadithnumber_last":3435,"arabicnumber_first":3371,"arabicnumber_last":3435,"name_native":"Chapters on Drinks"}}},"hadiths":[{"hadithnumber":3371,"arabicnumber":3371,"text":"It was narrated that Abu Darda’ said:‘My close friend (ﷺ) advised me: ‘Do not drink wine, for it is the key to all evils.’”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":30,"hadith":1}}]}