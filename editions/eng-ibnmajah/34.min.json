{"metadata":{"name":"Sunan Ibn Majah","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"The Book of the Sunnah"}}},"hadiths":[{"hadithnumber":34,"arabicnumber":34,"text":"It was narrated that Abu Hurairah said:\"The Messenger of Allah (ﷺ) said: 'Whoever attributes to me something that I have not said, let him take his place in Hell","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":0,"hadith":34}}]}