{"metadata":{"name":"Sunan Ibn Majah","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"Chapters on Medicine"}}},"hadiths":[{"hadithnumber":3476,"arabicnumber":3476,"text":"It was narrated from Abu Hurairah that the Prophet (ﷺ) said:“If there is any good in any of the remedies you use, it is in cupping.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":31,"hadith":41}}]}