{"metadata":{"name":"Sunan Ibn Majah","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"Chapters on Medicine"}}},"hadiths":[{"hadithnumber":3489,"arabicnumber":3489,"text":"It was narrated from ‘Aqqar bin Al-Mughirah from his father that the Prophet (ﷺ) said:“Whoever seeks treatment by cauterization, or with Ruqyah, then he had absolved himself of reliance upon Allah.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":31,"hadith":54}}]}