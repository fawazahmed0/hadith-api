{"metadata":{"name":"Sunan Ibn Majah","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"Chapters on Medicine"}}},"hadiths":[{"hadithnumber":3495,"arabicnumber":3495,"text":"Salim bin ‘Abdullah narrated that his father said:“The Messenger of Allah (ﷺ) said: ‘You should use antimony, for it improves the eyesight and makes the hair (eyelashes) grow.’”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":31,"hadith":60}}]}