{"metadata":{"name":"Sunan Ibn Majah","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"Chapters on Medicine"}}},"hadiths":[{"hadithnumber":3497,"arabicnumber":3497,"text":"It was narrated from Ibn ‘Abbas that the Messenger of Allah (ﷺ) said:“The best of your kohl is antimony, for it improves the eyesight and makes the hair (eyelashes) grow.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":31,"hadith":62}}]}