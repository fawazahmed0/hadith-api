{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"32":"Chapters on Dress"},"section_detail":{"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656,"name_native":"Chapters on Dress"}}},"hadiths":[{"hadithnumber":3640,"arabicnumber":3640,"text":"It was narrated that Anas bin Malik said:“The Messenger of Allah (ﷺ) had a ring made for him, and he said: ‘I have had a ring made for me and had it engraved, and no one should make a ring with similar engraving.’”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":32,"hadith":91}}]}