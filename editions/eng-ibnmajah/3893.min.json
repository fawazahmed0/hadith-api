{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"35":"Interpretation of Dreams"},"section_detail":{"35":{"hadithnumber_first":3893,"hadithnumber_last":3926,"arabicnumber_first":3893,"arabicnumber_last":3926,"name_native":"Interpretation of Dreams"}}},"hadiths":[{"hadithnumber":3893,"arabicnumber":3893,"text":"It was narrated from Anas bin Malik that the Messenger of Allah (ﷺ) said:“A good dream from a righteous man is one of the forty-six parts of prophecy.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":35,"hadith":1}}]}