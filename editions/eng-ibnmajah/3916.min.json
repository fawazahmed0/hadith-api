{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"35":"Interpretation of Dreams"},"section_detail":{"35":{"hadithnumber_first":3893,"hadithnumber_last":3926,"arabicnumber_first":3893,"arabicnumber_last":3926,"name_native":"Interpretation of Dreams"}}},"hadiths":[{"hadithnumber":3916,"arabicnumber":3916,"text":"It was narrated from Ibn ‘Abbas that the Messenger of Allah (ﷺ) said:“Whoever tells of a false dream, will be ordered (on the Day of Resurrection) to tie two grains of barley together, and he will be punished for that.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":35,"hadith":24}}]}