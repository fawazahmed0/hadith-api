{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"37":"Zuhd"},"section_detail":{"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341,"name_native":"Zuhd"}}},"hadiths":[{"hadithnumber":4234,"arabicnumber":4234,"text":"It was narrated from Anas that the Messenger of Allah (ﷺ) said:“The son of Adam grows old but two things remain young in him: His craving for wealth and his craving for a long life.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":37,"hadith":135}}]}