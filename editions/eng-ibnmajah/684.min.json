{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sunan Ibn Majah","section":{"2":"The Book of the Prayer"},"section_detail":{"2":{"hadithnumber_first":667,"hadithnumber_last":705,"arabicnumber_first":667,"arabicnumber_last":705,"name_native":"The Book of the Prayer"}}},"hadiths":[{"hadithnumber":684,"arabicnumber":684,"text":"It was narrated from 'Ali bin Abu Talib that,:On the Day of Khandaq, the Messenger of Allah said: \"May Allah fill their houses and graves with fire, just as they distracted us from the middle prayer","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":2,"hadith":18}}]}