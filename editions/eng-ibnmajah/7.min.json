{"metadata":{"name":"Sunan Ibn Majah","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"The Book of the Sunnah"}}},"hadiths":[{"hadithnumber":7,"arabicnumber":7,"text":"Abu Hurairah narrated that:The Messenger of Allah (ﷺ) said: \"A group of my Ummah will continue to adhere steadfastly to the command of Allah and those who oppose them will not be able to harm them","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":0,"hadith":7}}]}