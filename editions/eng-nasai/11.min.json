{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"The Book of Purification"}}},"hadiths":[{"hadithnumber":11,"arabicnumber":11,"text":"It was narrated from Abu Hurairah that the Prophet (ﷺ) said:\"The Fitrah are five: Circumcision, shaving the pubes, plucking the armpit hairs, clipping the nails and taking from the mustache","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":1,"hadith":11}}]}