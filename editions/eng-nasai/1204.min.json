{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"13":"The Book of Forgetfulness (In Prayer)"},"section_detail":{"13":{"hadithnumber_first":1179,"hadithnumber_last":1366,"arabicnumber_first":1179,"arabicnumber_last":1366,"name_native":"The Book of Forgetfulness (In Prayer)"}}},"hadiths":[{"hadithnumber":1204,"arabicnumber":1204,"text":"It was narrated from Abu Qatadah that:The Messenger of Allah (ﷺ) used to pray carrying Umamah. When he prostrated he put her down and when he stood up he picked her up again","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":13,"hadith":26}}]}