{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"13":"The Book of Forgetfulness (In Prayer)"},"section_detail":{"13":{"hadithnumber_first":1179,"hadithnumber_last":1366,"arabicnumber_first":1179,"arabicnumber_last":1366,"name_native":"The Book of Forgetfulness (In Prayer)"}}},"hadiths":[{"hadithnumber":1362,"arabicnumber":1362,"text":"It was narrated that 'Aishah said:\"Women used to pray fajr with the Messenger of Allah (ﷺ), and when he said the taslim they would leave, wrapped in their Mirts, unrecognizable because of the darkness","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":13,"hadith":184}}]}