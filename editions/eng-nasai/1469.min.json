{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"16":"The Book of Eclipses"},"section_detail":{"16":{"hadithnumber_first":1459,"hadithnumber_last":1503,"arabicnumber_first":1459,"arabicnumber_last":1503,"name_native":"The Book of Eclipses"}}},"hadiths":[{"hadithnumber":1469,"arabicnumber":1469,"text":"It was narrated from Kathir bin Abbas, from Abdullah bin Abbas that:The Messenger of Allah (ﷺ) prayed on the day the sun was eclipsed, bowing four times in two rak'ahs and prostrating four times","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":16,"hadith":11}}]}