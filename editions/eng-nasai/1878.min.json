{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"The Book of Funerals"}}},"hadiths":[{"hadithnumber":1878,"arabicnumber":1878,"text":"It was narrated from Anas:that the Messenger of Allah announced the news of the death of Zaid and Ja'far before news of them came. He announced their death and his eyes were overflowing with tears","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":21,"hadith":61}}]}