{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"The Book of Funerals"}}},"hadiths":[{"hadithnumber":1935,"arabicnumber":1935,"text":"It was narrated that 'Aishah said:\"Something bad was said in the presence of the Prophet about a person who had died. He said: 'Do not say anything but good about your dead","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":21,"hadith":118}}]}