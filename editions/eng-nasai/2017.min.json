{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"The Book of Funerals"}}},"hadiths":[{"hadithnumber":2017,"arabicnumber":2017,"text":"It was narrated from Hisham bin 'Amir that the Messenger of Allah said:\"Dig graves and dig them well, and bury two or three (together), and put in first the one who knew the Qur'an most","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":21,"hadith":200}}]}