{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"The Book of Fasting"}}},"hadiths":[{"hadithnumber":2289,"arabicnumber":2289,"text":"It was narrated from Ibn 'Abbas that:the Messenger of Allah fasted while traveling until he reached Qudaid, then he called for a cup of milk and drank and broke his fast; he and his Companions","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":22,"hadith":200}}]}