{"metadata":{"name":"Sunan an Nasai","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"The Book of Fasting"}}},"hadiths":[{"hadithnumber":2335,"arabicnumber":2335,"text":"It was narrated from Hafsah that she used to say:\"Whoever does not intend to fast from the night before, should not fast.\" (Daif)","grades":[{"name":"Abu Ghuddah","grade":"Sahih Muquf"},{"name":"Al-Albani","grade":"Sahih Muquf"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":22,"hadith":246}}]}