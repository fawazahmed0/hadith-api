{"metadata":{"name":"Sunan an Nasai","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"The Book of Fasting"}}},"hadiths":[{"hadithnumber":2353,"arabicnumber":2353,"text":"It was narrated from Umm Salamah:That the Prophet would not fast any month of the year in full except Shaban and he used to join it to Ramadan","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":22,"hadith":264}}]}