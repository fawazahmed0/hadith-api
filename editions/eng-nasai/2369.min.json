{"metadata":{"name":"Sunan an Nasai","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"The Book of Fasting"}}},"hadiths":[{"hadithnumber":2369,"arabicnumber":2369,"text":"It was narrated that Abu Hurairah said:\"The Messenger of Allah commanded me to pray two Rakahs of Duha, and not to sleep until I had prayed witr, and to fast three days each month","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":22,"hadith":280}}]}