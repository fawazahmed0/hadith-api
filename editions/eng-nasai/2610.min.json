{"metadata":{"name":"Sunan an Nasai","section":{"23":"The Book of Zakah"},"section_detail":{"23":{"hadithnumber_first":2435,"hadithnumber_last":2618,"arabicnumber_first":2435,"arabicnumber_last":2618,"name_native":"The Book of Zakah"}}},"hadiths":[{"hadithnumber":2610,"arabicnumber":2610,"text":"Shu'bah said:\"I said to Abu Iyas Mu'awiyah bin Qurrah: 'Did you hear Ans bin Malik say: The Messenger of Allah said: The son of the daughter of a people is one of them? He said: 'Yes","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":23,"hadith":176}}]}