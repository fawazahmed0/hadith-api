{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"The Book of Hajj"}}},"hadiths":[{"hadithnumber":2807,"arabicnumber":2807,"text":"Surqah said:'The Messenger of Allah joined Hajj and Umrah and we did so with him. We said: \"Is it just for us, or for all time?\" He said: \"No, it is for all time","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":24,"hadith":189}}]}