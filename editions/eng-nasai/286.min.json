{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"The Book of Purification"}}},"hadiths":[{"hadithnumber":286,"arabicnumber":286,"text":"It was narrated that 'Aishah said:\"If one of us was menstruating, the Messenger of Allah (ﷺ) would tell her to put on an Izar (waist wrap) then he would fondle her","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"}],"reference":{"book":1,"hadith":287}}]}