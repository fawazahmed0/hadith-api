{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"2":"The Book of Water"},"section_detail":{"2":{"hadithnumber_first":325,"hadithnumber_last":347,"arabicnumber_first":325,"arabicnumber_last":347,"name_native":"The Book of Water"}}},"hadiths":[{"hadithnumber":338,"arabicnumber":338,"text":"It was narrated from Abu Hurairah that the Messenger of Allah (ﷺ) said:\"If a dog licks the vessel of any one of you, let him wash it seven times, the first time with dust","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":2,"hadith":14}}]}