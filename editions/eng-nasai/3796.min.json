{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"35":"The Book of Agriculture"},"section_detail":{"35":{"hadithnumber_first":3761,"hadithnumber_last":3856,"arabicnumber_first":3761,"arabicnumber_last":3856,"name_native":"The Book of Agriculture"}}},"hadiths":[{"hadithnumber":3796,"arabicnumber":3796,"text":"It was narrated that Jabir said:\"I entered the house of the Prophet with him and there was some bread and vinegar. The Messenger of Allah said: 'Eat; what a good condiment is vinegar","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":35,"hadith":36}}]}