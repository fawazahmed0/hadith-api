{"metadata":{"name":"Sunan an Nasai","section":{"44":"The Book of Financial Transactions"},"section_detail":{"44":{"hadithnumber_first":4449,"hadithnumber_last":4705,"arabicnumber_first":4449,"arabicnumber_last":4705,"name_native":"The Book of Financial Transactions"}}},"hadiths":[{"hadithnumber":4504,"arabicnumber":4504,"text":"It was narrated from Ibn 'Umar that the Messenger of Allah said:\"Do not urge someone to cancel a sale he has already agreed upon so as to sell him your own goods, unless he bys or changes his mind","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":44,"hadith":56}}]}