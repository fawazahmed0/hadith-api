{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"44":"The Book of Financial Transactions"},"section_detail":{"44":{"hadithnumber_first":4449,"hadithnumber_last":4705,"arabicnumber_first":4449,"arabicnumber_last":4705,"name_native":"The Book of Financial Transactions"}}},"hadiths":[{"hadithnumber":4542,"arabicnumber":4542,"text":"It was narrated from Sahl bin Abi Hathamah that the Prophet forbade selling fruits before their condition was known, but he granted a concession allowing 'Araya sales by estimate, so its people could eat fresh dates","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih Hadith"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":44,"hadith":94}}]}