{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"The Book of Adornment"}}},"hadiths":[{"hadithnumber":5094,"arabicnumber":5094,"text":"It was narrated from Hisham bin 'Urwah, from his wife Fatimah, from Asma' bint Abi Bakr, that:The Messenger of Allah [SAW] cursed the woman who affixes hair extensions and the woman who has that done","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":48,"hadith":55}}]}