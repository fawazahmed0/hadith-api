{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"The Book of Adornment"}}},"hadiths":[{"hadithnumber":5144,"arabicnumber":5144,"text":"Ali bin Abi Talib said:\"The Prophet of Allah [SAW] took hold of some silk in his right hand and some gold in his left, then he said: 'These two are forbidden for the males of my Ummah","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":48,"hadith":105}}]}