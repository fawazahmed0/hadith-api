{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"48":"The Book of Adornment"},"section_detail":{"48":{"hadithnumber_first":5040,"hadithnumber_last":5378,"arabicnumber_first":5040,"arabicnumber_last":5378,"name_native":"The Book of Adornment"}}},"hadiths":[{"hadithnumber":5252,"arabicnumber":5252,"text":"It was narrated that 'Abdullah said:\"May Allah curse Al-Mutanammisat and who have their teeth separated. Shall I not curse those whom the Messenger of Allah [SAW] cursed?","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":48,"hadith":213}}]}