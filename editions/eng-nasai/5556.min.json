{"metadata":{"name":"Sunan an Nasai","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"The Book of Drinks"}}},"hadiths":[{"hadithnumber":5556,"arabicnumber":5556,"text":"It was narrated from Jabir that:The Messenger of Allah [SAW] forbade soaking raisins and dried dates together, and he forbade soaking Al-Busr and dried dates together","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":51,"hadith":17}}]}