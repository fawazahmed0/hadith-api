{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasai","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"The Book of Drinks"}}},"hadiths":[{"hadithnumber":5617,"arabicnumber":5617,"text":"It was narrated that Ibn 'Umar said:\"The Messenger of Allah [SAW] forbade Al-Hantam. I (the narrator) said: \"What is Al-Hantam?\" He said: \"The earthenware jar","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":51,"hadith":79}}]}