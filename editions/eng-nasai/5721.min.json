{"metadata":{"name":"Sunan an Nasai","section":{"51":"The Book of Drinks"},"section_detail":{"51":{"hadithnumber_first":5540,"hadithnumber_last":5758,"arabicnumber_first":5540,"arabicnumber_last":5758,"name_native":"The Book of Drinks"}}},"hadiths":[{"hadithnumber":5721,"arabicnumber":5721,"text":"It was narrated from Abu Musa Al-'Ash'ari that:He used to drink thickened grape juice that of which two-third had gone and one-third was left","grades":[{"name":"Abu Ghuddah","grade":"Sahih Muquf"},{"name":"Al-Albani","grade":"Sahih Muquf"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":51,"hadith":183}}]}