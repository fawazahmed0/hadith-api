{"metadata":{"name":"Jami At Tirmidhi","name_native":"Jami At-Tirmidhi","section":{"2":"The Book on Salat (Prayer)"},"section_detail":{"2":{"hadithnumber_first":149,"hadithnumber_last":451,"arabicnumber_first":149,"arabicnumber_last":451,"name_native":"The Book on Salat (Prayer)"}}},"hadiths":[{"hadithnumber":220,"arabicnumber":220,"text":"Abu Sa'eed narrated:\"A man came when Allah's Messenger had already prayed, so he said: 'Which of you will give some reward to this person?' So a man stood to pray with him","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":2,"hadith":72}}]}