{"metadata":{"name":"Jami At Tirmidhi","section":{"40":"The Book on Faith"},"section_detail":{"40":{"hadithnumber_first":2606,"hadithnumber_last":2644,"arabicnumber_first":2606,"arabicnumber_last":2644,"name_native":"The Book on Faith"}}},"hadiths":[{"hadithnumber":2628,"arabicnumber":2628,"text":"Narrated Abu Musa Al-Ash'ari:that the Prophet (ﷺ) was asked: \"Which of the Muslims is most virtuous?\" He said: \"The one from (the harm of) whose tongue and hand (other) Muslims are safe","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":40,"hadith":23}}]}