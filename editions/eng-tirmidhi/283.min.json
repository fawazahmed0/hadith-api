{"metadata":{"name":"Jami At Tirmidhi","name_native":"Jami At-Tirmidhi","section":{"2":"The Book on Salat (Prayer)"},"section_detail":{"2":{"hadithnumber_first":149,"hadithnumber_last":451,"arabicnumber_first":149,"arabicnumber_last":451,"name_native":"The Book on Salat (Prayer)"}}},"hadiths":[{"hadithnumber":283,"arabicnumber":283,"text":"Tawus said:\"We asked Ibn Abbas about squatting (sitting) on the heels. He said: 'It is the Sunnah.' We said: 'We think that it is difficult for a man.' He said: 'Rather, it is Sunnah of your Prophet","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":2,"hadith":135}}]}