{"metadata":{"name":"Jami At Tirmidhi","section":{"43":"Chapters on Manners"},"section_detail":{"43":{"hadithnumber_first":2736,"hadithnumber_last":2858,"arabicnumber_first":2736,"arabicnumber_last":2858,"name_native":"Chapters on Manners"}}},"hadiths":[{"hadithnumber":2836,"arabicnumber":2836,"text":"Narrated Samurah bin Jundab:that the Messenger of Allah (ﷺ) said: \"Do not name your boy Rabah, nor Aflah, nor Yasar, nor Najih, so that it may be said: 'Is he there?' and it may be said: 'No","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":43,"hadith":110}}]}