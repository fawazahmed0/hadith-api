{"metadata":{"name":"Jami At Tirmidhi","name_native":"Jami At-Tirmidhi","section":{"48":"Chapters on Supplication"},"section_detail":{"48":{"hadithnumber_first":3370,"hadithnumber_last":3604.1,"arabicnumber_first":3370,"arabicnumber_last":3604.1,"name_native":"Chapters on Supplication"}}},"hadiths":[{"hadithnumber":3464,"arabicnumber":3464,"text":"Jabir narrated that:The Prophet (ﷺ) said: “Whoever says: ‘Glory is to Allah, the Magnificent, and with His Praise (Subḥān Allāhil-Aẓīm, wa biḥamdih)’ a date-palm tree is planted for him in Paradise.”","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":48,"hadith":95}}]}