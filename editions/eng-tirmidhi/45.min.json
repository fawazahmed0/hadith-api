{"metadata":{"name":"Jami At Tirmidhi","name_native":"Jami At-Tirmidhi","section":{"1":"The Book on Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":148,"arabicnumber_first":1,"arabicnumber_last":148,"name_native":"The Book on Purification"}}},"hadiths":[{"hadithnumber":45,"arabicnumber":45,"text":"Thabit bin Abi Safiyyah said, :\"I asked Abu Ja'far: 'Did Jabir narrate to you that: \"The Prophet performed Wudu one time each, and two times, and three times?\" He said: \"Yes","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Daif"},{"name":"Al-Albani","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":1,"hadith":45}}]}