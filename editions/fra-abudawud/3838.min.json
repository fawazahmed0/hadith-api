{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sunan Abû Dâwûd","section":{"28":"Foods (Kitab Al-At'imah)"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854,"name_native":"Livre des aliments"}}},"hadiths":[{"hadithnumber":3838,"arabicnumber":3838,"text":"Rapporté par Jabir ibn Abdullah : J’étais en expédition avec le Messager d’Allah ﷺ. Nous avons pris les ustensiles et les outres des polythéistes et nous les avons utilisés. Il ne nous a pas reproché cela","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":28,"hadith":103}}]}