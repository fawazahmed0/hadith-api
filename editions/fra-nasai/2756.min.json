{"metadata":{"name":"Sunan an Nasai","name_native":"Sunan an-Nasa'i","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"Le livre du Hajj"}}},"hadiths":[{"hadithnumber":2756,"arabicnumber":2756,"text":"Rapporté par Jabir : Concernant le Hajj du Prophète ﷺ, lorsqu'il est arrivé à Dhul-Hulaifah, il a prié puis il est resté silencieux jusqu'à ce qu'il arrive à Al-Baida","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":24,"hadith":138}}]}