	"hadiths": [
		{
			"hadithnumber": 1034,
			"arabicnumber": 1034,
			"text": "‘Абдуллах ибн Бухайна, да будет доволен им Аллах, сказал: «Однажды Посланник Аллаха ﷺ совершал с нами молитву и не сел после двух рак‘атов. Люди встали вместе с ним. В конце молитвы, когда мы ожидали таслима, он сначала произнёс такбир, совершил во время своего сидения два земных поклона и лишь потом произнёс таслим»",
