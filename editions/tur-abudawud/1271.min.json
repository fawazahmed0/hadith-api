{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"5":"Prayer (Kitab Al-Salat): Voluntary Prayers"},"section_detail":{"5":{"hadithnumber_first":1250,"hadithnumber_last":1370,"arabicnumber_first":1250,"arabicnumber_last":1370,"name_native":"Namaz Kitabı"}}},"hadiths":[{"hadithnumber":1271,"arabicnumber":1271,"text":"İbn Ömer (r.a.)'den; demiştir ki: Resûlullah sallellahu aleyhi ve sellem şöyle buyurdu: \"İkindi'nin farzından önce dört rekat (namaz) kılan kimseye Allah rahmet etsin","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":5,"hadith":22}}]}