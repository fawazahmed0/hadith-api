{"metadata":{"name":"Sunan Abu Dawud","section":{"9":"Zekât Bölümü"},"section_detail":{"9":{"hadithnumber_first":1556,"hadithnumber_last":1700,"arabicnumber_first":1556,"arabicnumber_last":1700}}},"hadiths":[{"hadithnumber":1585,"arabicnumber":1585,"text":"Enes b, Mâlik'den rivayet edildiğine göre, Resûlullah (s.a.v.) şöyle buyurmuştur: \"Zekâtta haksız davranan, onu vermeyen gibidir","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":9,"hadith":30}}]}