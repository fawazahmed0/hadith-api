{"metadata":{"name":"Sunan Abu Dawud","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"Nikah Kitabı"}}},"hadiths":[{"hadithnumber":2120,"arabicnumber":2120,"text":"Süleym oğulanndan bir adamdan; demiştir ki: Nebi (s.a.v.)'e (giderek kendisinden) Ümâme bint Abdulmuttalib'i istedim. Bunun üzerine hutbe okumaksızın (onu) bana nikahladı","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":12,"hadith":75}}]}