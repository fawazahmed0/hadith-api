{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"Talak (Boşanma) Kitabı"}}},"hadiths":[{"hadithnumber":2194,"arabicnumber":2194,"text":"Ebû Hureyre (r.a.)'den rivayet edildiğine göre, Rasûlullah sallallahu aleyhi ve sellem şöyle buyurmuştur; \"Üç şeyin ciddisi de, şakası da ciddidir. Nikâh, talak, rec'â","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":13,"hadith":20}}]}