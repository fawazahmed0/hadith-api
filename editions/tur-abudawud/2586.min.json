{"metadata":{"name":"Sunan Abu Dawud","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"Cihad Kitabı"}}},"hadiths":[{"hadithnumber":2586,"arabicnumber":2586,"text":"Cabir (r,a.)'den rivayet edildiğine göre, Rasûlullah (s.a.v.) mescid'de sadaka olarak ok dağıtmakta olan bir adam'a, onların (uçlarındaki keskin) demirlerinden tutmadan mescide girmemesini emretti","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (2614)"}],"reference":{"book":15,"hadith":110}}]}