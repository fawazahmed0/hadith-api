{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"Cenazeler Kitabı"}}},"hadiths":[{"hadithnumber":3204,"arabicnumber":3204,"text":"Ebû Hureyre'den (rivayet olunduğuna göre); Rasûlullah (s.a.v.) Necaşi(nin ölümü)nü o gün halka haber verdi. Sonra cemaati musallaya çıkarıp, onları saf düzenine soktu. Dört tekbir al(arak cenaze namazını kildir)dı","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (1245) Sahih Muslim (951)"}],"reference":{"book":21,"hadith":116}}]}