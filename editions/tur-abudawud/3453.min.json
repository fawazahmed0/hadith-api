{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"Ücretler (Kitab Al-Ijarah)"}}},"hadiths":[{"hadithnumber":3453,"arabicnumber":3453,"text":"Yahya (el-Kattân)'dan, şöyle dediği rivayet edilmiştir: Süfyân; \"Bizden değildir\" sözünü, \"Bizim gibi değildir\" şeklinde tefsir etmeyi beğenmezdi","grades":[{"name":"Al-Albani","grade":"Sahih Isnaad Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":24,"hadith":38}}]}