{"metadata":{"name":"Sunan Abu Dawud","section":{"28":"Yiyecekler Bölümü"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854}}},"hadiths":[{"hadithnumber":3763,"arabicnumber":3763,"text":"Ebû Hureyre (r.a)'den şöyle dediği rivayet olunmuştur: Rasûlullah (s.a.v.) hiçbir zaman bir yemeği kötülememiştir. (Önüne gelen bir) yemekten hoşlanırsa onu yerdi, hoşlanmazsa yemezdi","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (5409) Sahih Muslim (2064)"}],"reference":{"book":28,"hadith":28}}]}