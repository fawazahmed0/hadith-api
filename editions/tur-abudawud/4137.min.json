{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"34":"Clothing (Kitab Al-Libas)"},"section_detail":{"34":{"hadithnumber_first":4020,"hadithnumber_last":4158,"arabicnumber_first":4020,"arabicnumber_last":4158,"name_native":"Giyim ve Elbise Kitabı"}}},"hadiths":[{"hadithnumber":4137,"arabicnumber":4137,"text":"Câbir'den rivayet edildiğine göre; Nebi (s.a.v.) şöyle buyurmuştur: \"Birinizin (pabucunun) tasması koptuğu zaman, tasmasını onartıncaya kadar tek pabuçla ile yürümesin. Tek mest ile de yürümesin ve sol el(iy)le yemesin","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (2099)"}],"reference":{"book":34,"hadith":118}}]}