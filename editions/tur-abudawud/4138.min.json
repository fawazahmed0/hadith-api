{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"34":"Clothing (Kitab Al-Libas)"},"section_detail":{"34":{"hadithnumber_first":4020,"hadithnumber_last":4158,"arabicnumber_first":4020,"arabicnumber_last":4158,"name_native":"Giyim ve Elbise Kitabı"}}},"hadiths":[{"hadithnumber":4138,"arabicnumber":4138,"text":"İbn Abbas (r.a)'dan şöyle elediği rivayet olunmuştur: Kişi otur(mak iste) diği zaman, ayakkabılarını çıkarıp (sol) yanına koyması sünnettendir","grades":[{"name":"Al-Albani","grade":"Daif Isnaad"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":34,"hadith":119}}]}