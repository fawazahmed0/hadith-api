{"metadata":{"name":"Sunan Abu Dawud","section":{"35":"Saçı Tarayıp Düzeltmek"},"section_detail":{"35":{"hadithnumber_first":4159,"hadithnumber_last":4213,"arabicnumber_first":4159,"arabicnumber_last":4213}}},"hadiths":[{"hadithnumber":4162,"arabicnumber":4162,"text":"Enes b. Mâlik (r.a); demiştir ki : Resûlullah (s.a.v.)'iri sûkkesi (güzel bir esans)'ı vardı, ondan sürünürdü. Sûkke: Değerli bir esans çeşididir","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":35,"hadith":4}}]}