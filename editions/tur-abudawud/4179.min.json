{"metadata":{"name":"Sunan Abu Dawud","section":{"35":"Saçı Tarayıp Düzeltmek"},"section_detail":{"35":{"hadithnumber_first":4159,"hadithnumber_last":4213,"arabicnumber_first":4159,"arabicnumber_last":4213}}},"hadiths":[{"hadithnumber":4179,"arabicnumber":4179,"text":"Enes (r.a) demiştir ki: \"Resûlullah (s.a.v.), erkekleri zaferan sürünmekten nehyetti.\" Müsedded; ismail'den \"Erkeğin zâferan kullanmasını\" diye rivayet etti","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (2101)"}],"reference":{"book":35,"hadith":21}}]}