{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"40":"Prescribed Punishments (Kitab Al-Hudud)"},"section_detail":{"40":{"hadithnumber_first":4351,"hadithnumber_last":4493,"arabicnumber_first":4351,"arabicnumber_last":4493,"name_native":"Hadler (Cezalar) Kitabı"}}},"hadiths":[{"hadithnumber":4389,"arabicnumber":4389,"text":"Muhammed b, Ubeyd, Hammad'dan (o), Yahya'dan (o), Muhammed b. Yahya b. Habban'dan bu (4388.) hadisi rivayet etti. Ravi şöyle dedi: \"Mervan o köleye birkaç sopa vurdu ve serbest bıraktı","grades":[{"name":"Al-Albani","grade":"Shadh"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Shadh"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":40,"hadith":39}}]}