{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"40":"Prescribed Punishments (Kitab Al-Hudud)"},"section_detail":{"40":{"hadithnumber_first":4351,"hadithnumber_last":4493,"arabicnumber_first":4351,"arabicnumber_last":4493,"name_native":"Hadler (Cezalar) Kitabı"}}},"hadiths":[{"hadithnumber":4433,"arabicnumber":4433,"text":"İbn Büreyde, babasından şöyle rivayet etmiştir: Rasulullah (s.a.v.)'Mâiz'in ağzını kokladı. Diğer Tahric edenler: Müslim, hudud. Rasulullah Mâiz'in sarhoş olup olmadığını anlamak için ağzını koklamıştır. Kalan İzah 4434 te","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1695)"}],"reference":{"book":40,"hadith":83}}]}