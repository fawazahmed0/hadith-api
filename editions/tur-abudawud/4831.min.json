{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"Genel Davranış (Kitab Al-Adab)"}}},"hadiths":[{"hadithnumber":4831,"arabicnumber":4831,"text":"Enes İbn Malik'den (rivayet edildiğine göre): Nebi (s.a.v.) (şöyle) buyurmuştur: \"İyi Arkadaşın benzeri...\" deyip.(Hadisin bundan sonraki kısmında Hz. Enes 4829 no'lu hadisin) bir benzerini rivayet etmiştir","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Lighairihi"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":43,"hadith":59}}]}