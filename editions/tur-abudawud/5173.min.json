{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"Genel Davranış (Kitab Al-Adab)"}}},"hadiths":[{"hadithnumber":5173,"arabicnumber":5173,"text":"Ebu Hureyre r.a.'den (rivayet edildiğine göre) Nebi (s.a.v.) şöyle buyurmuştur: \"(Kişi evin içine baktı da) Bakış (eve) girdi mi, artık (eve girmek için) izin (almaya lüzum) yoktur","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"}],"reference":{"book":43,"hadith":401}}]}