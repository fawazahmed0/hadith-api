{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"Temizlik Kitabı (Taharet)"}}},"hadiths":[{"hadithnumber":57,"arabicnumber":57,"text":"Aişe (r.anha)'dan, şöyle demiştir: \"Nebiyy-i Ekrem (sallallahu aleyhi ve sellem) gece veya gündüz her uykudan kalkışında mutlaka abdestten önce ağzını misvaklardı","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":1,"hadith":57}}]}