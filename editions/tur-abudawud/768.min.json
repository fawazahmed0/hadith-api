{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"Namaz Kitabı"}}},"hadiths":[{"hadithnumber":768,"arabicnumber":768,"text":"Şu (bir önceki (767.)) hadisin manasını bir de ikrime aynı senetle ve \"Bize haber verdi\" diyerek nakletti. Nebi (gece) kalktığında tekbir getirir ve (önceki hadiste geçen duayı) okurdu","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":2,"hadith":378}}]}