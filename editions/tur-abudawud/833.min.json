{"metadata":{"name":"Sunan Abu Dawud","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"Namaz Kitabı"}}},"hadiths":[{"hadithnumber":833,"arabicnumber":833,"text":"Cabir b. Abdillah'dan; demiştir ki: Biz (Nebi (Sallallahu aleyhi ve Sellem)'in sağlığında) ayakta ve otururken dua ederek rüku ve secdede iken de, tesbih ederek nafile namaz kılardık","grades":[{"name":"Al-Albani","grade":"Daif Muquf"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Muquf"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":2,"hadith":443}}]}