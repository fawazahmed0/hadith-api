{"metadata":{"name":"Sunan Abu Dawud","name_native":"Sünen-i Ebu Davud","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"Temizlik Kitabı (Taharet)"}}},"hadiths":[{"hadithnumber":87,"arabicnumber":87,"text":"Ebu Halde dedi ki: Ebu Aliye'ye: \"Cünub olup da yanında nebiz'den başka su bulunmayan kimse nebizle ğusledilebilir mi?\" diye sordum. \"Hayır\" cevabını verdi. Geniş bilgi için 84 nolu hadisin açıklamasına bak","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":1,"hadith":87}}]}