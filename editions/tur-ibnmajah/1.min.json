{"metadata":{"name":"Sunan Ibn Majah","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"Sünnet Kitabı"}}},"hadiths":[{"hadithnumber":1,"arabicnumber":1,"text":"Ebu Hureyre (Radiyallahu anh)’den: Resulullah (Sallallahu Aleyhi ve Sellem)’in şöyle buyurduğu rivayet edilmiştir; ”Size ne emrettimse onu alınız ve sizi neden nehiy ettimse ondan vazgeçiniz.”","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":0,"hadith":1}}]}