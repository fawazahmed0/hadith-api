{"metadata":{"name":"Sunan Ibn Majah","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"Oruç Kitabı (Savm)"}}},"hadiths":[{"hadithnumber":1743,"arabicnumber":1743,"text":"İbn-i Abbas (r.a.)'dan; Şöyle demiştir: Nebi (Sallallahu Aleyhi ve Sellem) Recep (ayı) orucundan nehiy buyurmuştur. Not: Bunun senedihdeki Davud bin Ata'nın zayıflığı' üzerinde ittifak vardır","grades":[{"name":"Al-Albani","grade":"Very Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":7,"hadith":106}}]}