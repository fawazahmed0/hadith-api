{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sünen-i İbn Mace","section":{"28":"Chapters on Hunting"},"section_detail":{"28":{"hadithnumber_first":3200,"hadithnumber_last":3250,"arabicnumber_first":3200,"arabicnumber_last":3250,"name_native":"Av ve Avcılık Kitabı"}}},"hadiths":[{"hadithnumber":3248,"arabicnumber":3248,"text":"İbn-i Ömer (r.a.)'dan; Şöyle demiştir: Resulullah (Sallallahu Aleyhi ve Sellem), Karga'ya fâsık adını taktığı halde kim etini yer? Allah'a and olsun ki, karga temiz (yiyecek) lerden değildir","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":28,"hadith":49}}]}