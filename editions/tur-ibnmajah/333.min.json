{"metadata":{"name":"Sunan Ibn Majah","section":{"1":"Taharet ve Sünnet (Hadis)lerinin Beyanı Kitabı"},"section_detail":{"1":{"hadithnumber_first":267,"hadithnumber_last":666,"arabicnumber_first":267,"arabicnumber_last":666}}},"hadiths":[{"hadithnumber":333,"arabicnumber":333,"text":"Yala bin Mürre r.a.’den şöyle dediği rivayet edilmiştir: Nebi Sallallahu Aleyhi ve Sellem abdest bozmaya gittiği zaman (zatını veya ihdiyacını halkın gözünden) uzaklaştırırdı","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":1,"hadith":67}}]}