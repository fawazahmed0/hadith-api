{"metadata":{"name":"Sunan Ibn Majah","name_native":"Sünen-i İbn Mace","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":"Yemekle İlgili Bölümler"}}},"hadiths":[{"hadithnumber":3347,"arabicnumber":3347,"text":"İbn-i Abbas (r.a.)'dan; Şöyle demiştir: Resulullah (Sallallahu Aleyhi ve Sellem) ve aile ferdleri üst üste bir kaç gece aç olarak gecelerdi, akşam yemeği bulamazlardı. Genellikle yedikleri ekmek de arpa ekmeğiydi","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":29,"hadith":97}}]}