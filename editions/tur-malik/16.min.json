{"metadata":{"name":"Muwatta Malik","name_native":"Muvatta Malik","section":{"1":"The Times of Prayer"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":31,"arabicnumber_first":1,"arabicnumber_last":31,"name_native":"Namaz Kitabı"}}},"hadiths":[{"hadithnumber":16,"arabicnumber":16,"text":"Abdullah b. Ömer şöyle derdi: (İmamla) rukua yetişemezsen, secdeye de (dolayısıyle o rekat'a) yetişememiş olursun. Bu Hadis Sadece Muvatta da var","grades":[{"name":"Salim al-Hilali","grade":"Mauquf Sahih"}],"reference":{"book":1,"hadith":16}}]}