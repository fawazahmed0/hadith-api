{"metadata":{"name":"Muwatta Malik","name_native":"Muvatta Malik","section":{"3":"Prayer"},"section_detail":{"3":{"hadithnumber_first":146,"hadithnumber_last":221,"arabicnumber_first":146,"arabicnumber_last":221,"name_native":"Namaz Kitabı"}}},"hadiths":[{"hadithnumber":184,"arabicnumber":184,"text":"Nâfi anlatıyor: Abdullah b. Ömer, Mina'da iken imama uyduğu zaman namazları dört rekât, tek başına kıldığı zaman ise iki rekât olarak kılardı. Şeybanî","grades":[{"name":"Salim al-Hilali","grade":"Mauquf Sahih"}],"reference":{"book":3,"hadith":17}}]}