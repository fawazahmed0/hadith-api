{"metadata":{"name":"Sunan an Nasai","name_native":"Sünen-i Nesai","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"Temizlik Kitabı (Taharet)"}}},"hadiths":[{"hadithnumber":50,"arabicnumber":50,"text":"Ebû Hüreyre (radıyallahü anh)’den rivâyete göre: (sallallahü aleyhi ve sellem), abdest alacaktı da taharetlenmeden sonra elini toprakla ovuşturdu.) (Ebû Dâvûd, Tahara: 24; İbn Mâce, Tahara:)","grades":[{"name":"Abu Ghuddah","grade":"Hasan"},{"name":"Al-Albani","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":1,"hadith":50}}]}