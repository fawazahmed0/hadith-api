{"metadata":{"name":"Jami At Tirmidhi","name_native":"Sünen-i Tirmizi","section":{"2":"The Book on Salat (Prayer)"},"section_detail":{"2":{"hadithnumber_first":149,"hadithnumber_last":451,"arabicnumber_first":149,"arabicnumber_last":451,"name_native":"Namaz Kitabı"}}},"hadiths":[{"hadithnumber":181,"arabicnumber":181,"text":"Abdullah bin Mes’ud (r.a.)’den rivayete göre, Rasulullah (Sallallahu aleyhi ve Sellem) şöyle buyurmuştur: “Orta namaz ikindi namazıdır” Diğer tahric: Nesai, Mevakit; İbn Mace, Salat Tirmîzî: Bu hadis hasen sahihtir","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":2,"hadith":33}}]}