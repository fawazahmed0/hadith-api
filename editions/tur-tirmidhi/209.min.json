{"metadata":{"name":"Jami At Tirmidhi","section":{"2":"Namaz Bölümleri"},"section_detail":{"2":{"hadithnumber_first":149,"hadithnumber_last":451,"arabicnumber_first":149,"arabicnumber_last":451}}},"hadiths":[{"hadithnumber":209,"arabicnumber":209,"text":"Osman b. ebî’l Âs (r.a.)’den rivâyete göre, şöyle demiştir: Rasûlullah (s.a.v.)’in bana son sözü: “Ezan okuduğu için ücret almayan bir müezzin tut sözü oldu.”","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":2,"hadith":61}}]}