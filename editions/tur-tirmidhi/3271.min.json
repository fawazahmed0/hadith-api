{"metadata":{"name":"Jami At Tirmidhi","name_native":"Sünen-i Tirmizi","section":{"47":"Chapters on Tafsir"},"section_detail":{"47":{"hadithnumber_first":2950,"hadithnumber_last":3723,"arabicnumber_first":2950,"arabicnumber_last":3723,"name_native":"Tefsir ile ilgili bölümler"}}},"hadiths":[{"hadithnumber":3271,"arabicnumber":3271,"text":"Semure (r.a.)’den rivâyete göre, Rasûlullah (s.a.v.) şöyle buyurmuştur: “Haseb” = mal demektir. “Kerem” ise takva sorumluluk bilinci demektir","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":47,"hadith":323}}]}