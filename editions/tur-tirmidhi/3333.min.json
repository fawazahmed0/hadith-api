{"metadata":{"name":"Jami At Tirmidhi","name_native":"Sünen-i Tirmizi","section":{"47":"Chapters on Tafsir"},"section_detail":{"47":{"hadithnumber_first":2950,"hadithnumber_last":3723,"arabicnumber_first":2950,"arabicnumber_last":3723,"name_native":"Tefsir ile ilgili bölümler"}}},"hadiths":[{"hadithnumber":3333,"arabicnumber":3333,"text":"İbn Ömer (r.a.)’den rivâyete göre, Rasûlullah (s.a.v.) şöyle buyurmuştur: “Gözüyle görmüş gibi kıyamet manzaralarını görmek kimi sevindirirse “Tekvir, İnfitar ve İnşikak” sûrelerini okusun.”","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":47,"hadith":385}}]}