{"metadata":{"name":"Jami At Tirmidhi","section":{"48":"Duâ Bölümleri"},"section_detail":{"48":{"hadithnumber_first":3370,"hadithnumber_last":3604.1,"arabicnumber_first":3370,"arabicnumber_last":3604.1}}},"hadiths":[{"hadithnumber":3572,"arabicnumber":3572,"text":"Zeyd b. Erkâm (r.a.)’dan rivâyete göre, şöyle demiştir: Rasûlullah (s.a.v.) şöyle duâ ederdi: “Allah’ım tembellikten acizlikten ve cimrilikten sana sığınırım.”","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":48,"hadith":203}}]}