{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":1001,"arabicnumber":1001,"text":"سیدنا سمرہ بن جندب ؓ بیان کرتے ہیں کہ نبی کریم ﷺ نے ہمیں حکم فرمایا کہ امام کو (اس کے سلام کا) جواب دیں، اور یہ کہ آپس میں محبت رکھیں اور ایک دوسرے کو سلام کیا کریں۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":2,"hadith":612}}]}