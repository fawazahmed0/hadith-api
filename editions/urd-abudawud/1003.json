	"hadiths": [
		{
			"hadithnumber": 1003,
			"arabicnumber": 1003,
			"text": "عبداللہ بن عباس رضی اللہ عنہما سے روایت ہے کہ ذکر کے لیے آواز اس وقت بلند کی جاتی تھی جب لوگ فرض نماز سے سلام پھیر کر پلٹتے تھے، رسول اللہ صلی اللہ علیہ وسلم کے عہد میں یہی دستور تھا، ابن عباس کہتے ہیں: جب لوگ نماز سے پلٹتے تو مجھے اسی سے اس کا علم ہوتا اور میں اسے سنتا تھا۔",
