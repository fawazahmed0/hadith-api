	"hadiths": [
		{
			"hadithnumber": 1105,
			"arabicnumber": 1105,
			"text": "سہل بن سعد رضی اللہ عنہ کہتے ہیں کہ میں نے کبھی بھی رسول اللہ صلی اللہ علیہ وسلم کو دونوں ہاتھ اٹھا کر اپنے منبر پر دعا مانگتے ہوئے نہیں دیکھا اور نہ غیر منبر پر، بلکہ میں نے آپ کو اس طرح کرتے دیکھا اور انہوں نے شہادت کی انگلی سے اشارہ کیا اور بیچ کی انگلی کا انگوٹھے سے حلقہ بنایا۔",
