{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"5":"Prayer (Kitab Al-Salat): Voluntary Prayers"},"section_detail":{"5":{"hadithnumber_first":1250,"hadithnumber_last":1370,"arabicnumber_first":1250,"arabicnumber_last":1370,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":1319,"arabicnumber":1319,"text":"حذیفہ رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم کو جب کوئی معاملہ پیش آتا تو آپ نماز پڑھتے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":5,"hadith":70}}]}