{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"5":"Prayer (Kitab Al-Salat): Voluntary Prayers"},"section_detail":{"5":{"hadithnumber_first":1250,"hadithnumber_last":1370,"arabicnumber_first":1250,"arabicnumber_last":1370,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":1344,"arabicnumber":1344,"text":"اس سند سے بھی سعید نے یہی حدیث بیان کی ہے اس میں ہے: آپ اپنا سلام ہمیں سناتے جیسا کہ یحییٰ بن سعید نے کہا ہے۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":5,"hadith":95}}]}