{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"9":"Zakat (Kitab Al-Zakat)"},"section_detail":{"9":{"hadithnumber_first":1556,"hadithnumber_last":1700,"arabicnumber_first":1556,"arabicnumber_last":1700,"name_native":"کتاب الزکوٰۃ"}}},"hadiths":[{"hadithnumber":1560,"arabicnumber":1560,"text":"ابراہیم کہتے ہیں ایک وسق ساٹھ صاع کا ہوتا ہے، جس پر حجاجی مہر لگی ہوتی ہے۔","grades":[{"name":"Al-Albani","grade":"Sahih Maqtu"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Maqtu"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":9,"hadith":5}}]}