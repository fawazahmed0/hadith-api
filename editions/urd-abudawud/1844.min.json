{"metadata":{"name":"Sunan Abu Dawud","section":{"11":"The Rites of Hajj (Kitab Al-Manasik Wa'l-Hajj)"},"section_detail":{"11":{"hadithnumber_first":1721,"hadithnumber_last":2045,"arabicnumber_first":1721,"arabicnumber_last":2045,"name_native":"مناسک حج (کتاب المناسک والحج)"}}},"hadiths":[{"hadithnumber":1844,"arabicnumber":1844,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے ام المؤمنین میمونہ رضی اللہ عنہا سے حالت احرام میں نکاح کیا۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (4258)"}],"reference":{"book":11,"hadith":124}}]}