	"hadiths": [
		{
			"hadithnumber": 191,
			"arabicnumber": 191,
			"text": "جابر بن عبداللہ رضی اللہ عنہما کہتے ہیں کہ میں نے نبی اکرم صلی اللہ علیہ وسلم کو روٹی اور گوشت پیش کیا، تو آپ نے کھایا، پھر وضو کے لیے پانی منگایا، اور اس سے وضو کیا، پھر ظہر کی نماز ادا کی، پھر اپنا بچا ہوا کھانا منگایا اور کھایا، پھر نماز کے لیے کھڑے ہوئے اور ( دوبارہ ) وضو نہیں کیا۔",
