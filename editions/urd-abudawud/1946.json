	"hadiths": [
		{
			"hadithnumber": 1946,
			"arabicnumber": 1946,
			"text": "ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ مجھے ابوبکر رضی اللہ عنہ نے یوم النحر کو منیٰ ان لوگوں میں بھیجا جو پکار رہے تھے کہ اس سال کے بعد کوئی مشرک حج نہیں کرے گا اور نہ ہی کوئی ننگا بیت اللہ کا طواف کرے گا، اور حج ا کبر کا دن یوم النحر ہے اور حج اکبر سے مراد حج ہے۔",
