{"metadata":{"name":"Sunan Abu Dawud","section":{"11":"The Rites of Hajj (Kitab Al-Manasik Wa'l-Hajj)"},"section_detail":{"11":{"hadithnumber_first":1721,"hadithnumber_last":2045,"arabicnumber_first":1721,"arabicnumber_last":2045,"name_native":"مناسک حج (کتاب المناسک والحج)"}}},"hadiths":[{"hadithnumber":1980,"arabicnumber":1980,"text":"عبداللہ بن عمر رضی اللہ عنہما سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے حجۃ الوداع میں اپنا سر منڈوایا۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (4410) Sahih Muslim (1304)"}],"reference":{"book":11,"hadith":260}}]}