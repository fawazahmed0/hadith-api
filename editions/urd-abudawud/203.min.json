{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":203,"arabicnumber":203,"text":"علی بن ابی طالب رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: سرین کا بندھن دونوں آنکھیں ( بیداری ) ہیں، پس جو سو جائے وہ وضو کرے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":1,"hadith":203}}]}