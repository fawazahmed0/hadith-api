{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":2053,"arabicnumber":2053,"text":"ابوموسیٰ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جو شخص اپنی لونڈی کو آزاد کر کے اس سے شادی کر لے تو اس کے لیے دوہرا ثواب ہے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (2544) Sahih Muslim (154 After  1427)"}],"reference":{"book":12,"hadith":8}}]}