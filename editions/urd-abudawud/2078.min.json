{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":2078,"arabicnumber":2078,"text":"جابر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جو غلام اپنے مالک کی اجازت کے بغیر نکاح کر لے وہ زانی ہے ۔","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":12,"hadith":33}}]}