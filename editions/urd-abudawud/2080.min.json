{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":2080,"arabicnumber":2080,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: آدمی اپنے بھائی کے پیغام پر پیغام نہ بھیجے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (2140) Sahih Muslim (1413)"}],"reference":{"book":12,"hadith":35}}]}