{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":2084,"arabicnumber":2084,"text":"اس سند سے بھی ام المؤمنین عائشہ رضی اللہ عنہا سے اسی مفہوم کی حدیث مرفوعاً مروی ہے۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":12,"hadith":39}}]}