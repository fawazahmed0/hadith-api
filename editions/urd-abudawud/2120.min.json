{"metadata":{"name":"Sunan Abu Dawud","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":2120,"arabicnumber":2120,"text":"بنی سلیم کے ایک شخص کہتے ہیں میں نے امامہ بنت عبدالمطلب سے نکاح کے لیے نبی اکرم صلی اللہ علیہ وسلم کے پاس پیغام بھیجا تو آپ نے بغیر خطبہ پڑھے ان سے میرا نکاح کر دیا۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":12,"hadith":75}}]}