{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":2150,"arabicnumber":2150,"text":"عبداللہ بن مسعود رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: عورت عورت سے بدن نہ چپکائے وہ اپنے شوہر سے اس کے بارے میں اس طرح بیان کرے گویا اس کا شوہر اسے دیکھ رہا ہے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (5241)"}],"reference":{"book":12,"hadith":105}}]}