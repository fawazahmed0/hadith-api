{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"12":"Marriage (Kitab Al-Nikah)"},"section_detail":{"12":{"hadithnumber_first":2046,"hadithnumber_last":2174,"arabicnumber_first":2046,"arabicnumber_last":2174,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":2169,"arabicnumber":2169,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ اگر دوران خون صحبت کی تو ایک دینار، اور خون بند ہو جانے پر صحبت کی تو آدھا دینار ( کفارہ ) ہے۔","grades":[{"name":"Al-Albani","grade":"Sahih Muquf"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih Muquf"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":12,"hadith":124}}]}