{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"کتاب الطلاق"}}},"hadiths":[{"hadithnumber":2175,"arabicnumber":2175,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول صلی اللہ علیہ وسلم نے فرمایا: جو شخص کسی عورت کو اس کے شوہر سے یا غلام کو مالک سے برگشتہ کرے وہ ہم میں سے نہیں ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":13,"hadith":1}}]}