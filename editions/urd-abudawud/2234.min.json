{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"کتاب الطلاق"}}},"hadiths":[{"hadithnumber":2234,"arabicnumber":2234,"text":"ام المؤمنین عائشہ رضی اللہ عنہا سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے بریرہ کو اختیار دیا اس کا شوہر غلام تھا۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1504)"}],"reference":{"book":13,"hadith":60}}]}