{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"13":"Divorce (Kitab Al-Talaq)"},"section_detail":{"13":{"hadithnumber_first":2175,"hadithnumber_last":2312,"arabicnumber_first":2175,"arabicnumber_last":2312,"name_native":"کتاب الطلاق"}}},"hadiths":[{"hadithnumber":2294,"arabicnumber":2294,"text":"سلیمان بن یسار سے بھی فاطمہ رضی اللہ عنہا کے گھر سے نکلنے کا قصہ مروی ہے وہ کہتے ہیں: یہ بد خلقی کی بنا پر ہوا تھا۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":13,"hadith":120}}]}