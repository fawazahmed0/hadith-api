{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":24,"arabicnumber":24,"text":"امیمہ بنت رقیقہ رضی اللہ عنہا کہتی ہیں کہ کہ نبی اکرم صلی اللہ علیہ وسلم کے لیے آپ کے تخت کے نیچے لکڑی کا ایک پیالہ ( رہتا ) تھا، جس میں آپ صلی اللہ علیہ وسلم رات کو پیشاب کرتے تھے۔","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":1,"hadith":24}}]}