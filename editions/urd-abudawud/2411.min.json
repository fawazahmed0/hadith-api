{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"14":"Fasting (Kitab Al-Siyam)"},"section_detail":{"14":{"hadithnumber_first":2313,"hadithnumber_last":2476,"arabicnumber_first":2313,"arabicnumber_last":2476,"name_native":"کتاب الصوم (روزہ)"}}},"hadiths":[{"hadithnumber":2411,"arabicnumber":2411,"text":"سلمہ بن محبق رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: حالت سفر میں رمضان جسے پا لے … ، پھر راوی نے اسی مفہوم کی حدیث ذکر کی۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":14,"hadith":99}}]}