{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"کتاب الجہاد"}}},"hadiths":[{"hadithnumber":2576,"arabicnumber":2576,"text":"عبداللہ بن عمر رضی اللہ عنہما سے روایت ہے کہ اللہ کے نبی اکرم صلی اللہ علیہ وسلم گھوڑ دوڑ کے لیے گھوڑوں ( کو چھریرا ) پھرتیلا بناتے تھے۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (1870)"}],"reference":{"book":15,"hadith":100}}]}