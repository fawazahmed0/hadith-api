{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"کتاب الجہاد"}}},"hadiths":[{"hadithnumber":2589,"arabicnumber":2589,"text":"سمرہ بن جندب رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے چمڑے کو دو انگلیوں کے درمیان رکھ کر کاٹنے سے منع فرمایا۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":15,"hadith":113}}]}