{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"کتاب الجہاد"}}},"hadiths":[{"hadithnumber":2621,"arabicnumber":2621,"text":"ابوبشر رضی اللہ عنہ کہتے ہیں کہ میں نے عباد بن شرحبیل سے جو ہمیں میں سے قبیلہ بنو غبر کے ایک فرد تھے اسی مفہوم کی حدیث سنی۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":15,"hadith":145}}]}