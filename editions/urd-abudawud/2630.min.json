{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"کتاب الجہاد"}}},"hadiths":[{"hadithnumber":2630,"arabicnumber":2630,"text":"معاذ بن انس رضی اللہ عنہ کہتے ہیں کہ ہم نے اللہ کے نبی کریم صلی اللہ علیہ وسلم کے ساتھ غزوہ کیا، پھر راوی نے اسی مفہوم کی حدیث بیان کی۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":15,"hadith":154}}]}