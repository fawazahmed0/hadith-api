{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"15":"Jihad (Kitab Al-Jihad)"},"section_detail":{"15":{"hadithnumber_first":2477,"hadithnumber_last":2787,"arabicnumber_first":2477,"arabicnumber_last":2787,"name_native":"کتاب الجہاد"}}},"hadiths":[{"hadithnumber":2739,"arabicnumber":2739,"text":"اس سند بھی سے داود سے یہی حدیث اسی طریق سے مروی ہے اس میں ہے: رسول اللہ صلی اللہ علیہ وسلم نے اسے برابر برابر تقسیم کیا ، اور خالد کی حدیث ( نمبر ۲۷۳۷ ) کامل ہے۔","grades":[{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":15,"hadith":263}}]}