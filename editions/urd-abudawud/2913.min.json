{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"19":"Shares of Inheritance (Kitab Al-Fara'id)"},"section_detail":{"19":{"hadithnumber_first":2885,"hadithnumber_last":2927,"arabicnumber_first":2885,"arabicnumber_last":2927,"name_native":"کتاب الفرائض (وراثت)"}}},"hadiths":[{"hadithnumber":2913,"arabicnumber":2913,"text":"ابوالاسود دیلی سے روایت ہے کہ معاذ رضی اللہ عنہ کے پاس ایک یہودی کا ترکہ لایا گیا جس کا وارث ایک مسلمان تھا، اور اسی مفہوم کی حدیث انہوں نے نبی اکرم صلی اللہ علیہ وسلم سے روایت کی۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"}],"reference":{"book":19,"hadith":29}}]}