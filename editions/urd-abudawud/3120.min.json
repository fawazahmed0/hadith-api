{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"کتاب الجنائز"}}},"hadiths":[{"hadithnumber":3120,"arabicnumber":3120,"text":"ام المؤمنین عائشہ رضی اللہ عنہا فرماتی ہیں کہ نبی اکرم صلی اللہ علیہ وسلم کو ( وفات کے بعد ) یمنی کپڑے سے ڈھانپ دیا گیا۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (5814) Sahih Muslim (942)"}],"reference":{"book":21,"hadith":32}}]}