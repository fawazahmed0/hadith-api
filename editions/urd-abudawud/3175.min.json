{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"21":"Funerals (Kitab Al-Jana'iz)"},"section_detail":{"21":{"hadithnumber_first":3089,"hadithnumber_last":3241,"arabicnumber_first":3089,"arabicnumber_last":3241,"name_native":"کتاب الجنائز"}}},"hadiths":[{"hadithnumber":3175,"arabicnumber":3175,"text":"علی بن ابی طالب رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم پہلے جنازوں میں ( دیکھ کر ) کھڑے ہو جایا کرتے تھے پھر اس کے بعد بیٹھے رہنے لگے۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (962)"}],"reference":{"book":21,"hadith":87}}]}