{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"23":"Commercial Transactions (Kitab Al-Buyu)"},"section_detail":{"23":{"hadithnumber_first":3326,"hadithnumber_last":3415,"arabicnumber_first":3326,"arabicnumber_last":3415,"name_native":"تجارتی لین دین (کتاب البیو)"}}},"hadiths":[{"hadithnumber":3373,"arabicnumber":3373,"text":"جابر رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے میوہ کی پختگی ظاہر ہونے سے پہلے اسے بیچنے سے روکا ہے اور فرمایا ہے: پھل ( میوہ ) درہم و دینار ( روپیہ پیسہ ) ہی سے بیچا جائے سوائے عرایا کے ( عرایا میں پکا پھل کچے پھل سے بیچا جا سکتا ہے ) ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (2381) Sahih Muslim (1536 After 1543)"}],"reference":{"book":23,"hadith":48}}]}