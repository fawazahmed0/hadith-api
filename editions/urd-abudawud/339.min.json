{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":339,"arabicnumber":339,"text":"عطاء بن یسار سے روایت ہے کہ دو صحابی رسول صلی اللہ علیہ وسلم ( سفر میں تھے ) ، پھر انہوں نے اسی مفہوم کی حدیث ذکر کی۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":1,"hadith":339}}]}