{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"اجرت (کتاب الاجارہ)"}}},"hadiths":[{"hadithnumber":3425,"arabicnumber":3425,"text":"ابوحازم نے ابوہریرہ رضی اللہ عنہ کو کہتے سنا کہ رسول اللہ صلی اللہ علیہ وسلم نے لونڈیوں کی کمائی لینے سے منع فرمایا ہے۔","grades":[{"name":"Al-Albani","grade":"Sahih Hadith"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (2283)"}],"reference":{"book":24,"hadith":10}}]}