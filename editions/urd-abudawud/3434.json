	"hadiths": [
		{
			"hadithnumber": 3434,
			"arabicnumber": 3434,
			"text": "عمر رضی اللہ عنہ نے رسول اللہ صلی اللہ علیہ وسلم سے غلام کا واقعہ روایت کیا ہے، اور نافع نے ابن عمر رضی اللہ عنہما سے اور انہوں نے نبی اکرم صلی اللہ علیہ وسلم سے کھجور کے درخت کے واقعہ کی روایت کی ہے۔ ابوداؤد کہتے ہیں: زہری اور نافع نے چار حدیثوں میں اختلاف کیا ہے جن میں سے ایک یہ ہے۔",
