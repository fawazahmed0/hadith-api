{"metadata":{"name":"Sunan Abu Dawud","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"اجرت (کتاب الاجارہ)"}}},"hadiths":[{"hadithnumber":3506,"arabicnumber":3506,"text":"عقبہ بن عامر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ( بایع پر ) غلام و لونڈی کے عیب کی جواب دہی کی مدت تین دن ہے ۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":24,"hadith":91}}]}