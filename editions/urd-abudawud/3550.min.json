{"metadata":{"name":"Sunan Abu Dawud","section":{"24":"Wages (Kitab Al-Ijarah)"},"section_detail":{"24":{"hadithnumber_first":3416,"hadithnumber_last":3570,"arabicnumber_first":3416,"arabicnumber_last":3570,"name_native":"اجرت (کتاب الاجارہ)"}}},"hadiths":[{"hadithnumber":3550,"arabicnumber":3550,"text":"جابر رضی اللہ عنہ کہتے ہیں کہ اللہ کے نبی کریم صلی اللہ علیہ وسلم فرماتے تھے: زندگی بھر کے لیے دی ہوئی چیز کا وہی مالک ہے جس کو چیز دے دی گئی ہے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari (2625) Sahih Muslim (1625)"}],"reference":{"book":24,"hadith":135}}]}