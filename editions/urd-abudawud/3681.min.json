{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"27":"Drinks (Kitab Al-Ashribah)"},"section_detail":{"27":{"hadithnumber_first":3669,"hadithnumber_last":3735,"arabicnumber_first":3669,"arabicnumber_last":3735,"name_native":"کتاب الاشربہ"}}},"hadiths":[{"hadithnumber":3681,"arabicnumber":3681,"text":"جابر بن عبداللہ رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس چیز کی زیادہ مقدار نشہ آور ہو اس کی تھوڑی مقدار بھی حرام ہے ۔","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":27,"hadith":13}}]}