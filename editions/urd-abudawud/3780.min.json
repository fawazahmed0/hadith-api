{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"28":"Foods (Kitab Al-At'imah)"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854,"name_native":"کتاب الاطعمہ"}}},"hadiths":[{"hadithnumber":3780,"arabicnumber":3780,"text":"عبداللہ بن مسعود رضی اللہ عنہ کہتے ہیں رسول اللہ صلی اللہ علیہ وسلم کو «عراق» ( نلی ) ۱؎ میں سب سے زیادہ پسند بکری کی «عراق» ( نلی ) تھی۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":28,"hadith":45}}]}