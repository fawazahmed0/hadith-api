{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"28":"Foods (Kitab Al-At'imah)"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854,"name_native":"کتاب الاطعمہ"}}},"hadiths":[{"hadithnumber":3820,"arabicnumber":3820,"text":"جابر رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: سرکہ کیا ہی اچھا سالن ہے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":28,"hadith":85}}]}