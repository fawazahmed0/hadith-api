{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"28":"Foods (Kitab Al-At'imah)"},"section_detail":{"28":{"hadithnumber_first":3736,"hadithnumber_last":3854,"arabicnumber_first":3736,"arabicnumber_last":3854,"name_native":"کتاب الاطعمہ"}}},"hadiths":[{"hadithnumber":3830,"arabicnumber":3830,"text":"یوسف بن عبداللہ بن سلام کہتے ہیں میں نے نبی اکرم صلی اللہ علیہ وسلم کو دیکھا آپ نے جو کی روٹی کا ایک ٹکڑا لیا اور اس پر کھجور رکھا اور فرمایا: یہ اس کا سالن ہے ۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":28,"hadith":95}}]}