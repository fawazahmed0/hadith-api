{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"1":"Purification (Kitab Al-Taharah)"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":390,"arabicnumber_first":1,"arabicnumber_last":390,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":389,"arabicnumber":389,"text":"ابونضرہ (منذر بن مالک) رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے اپنے کپڑے میں تھوکا اور اسی میں مل لیا۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":1,"hadith":389}}]}