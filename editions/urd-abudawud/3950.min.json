{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"31":"The Book of Manumission of Slaves"},"section_detail":{"31":{"hadithnumber_first":3926,"hadithnumber_last":3968,"arabicnumber_first":3926,"arabicnumber_last":3968,"name_native":"غلاموں کی رہائی کی کتاب"}}},"hadiths":[{"hadithnumber":3950,"arabicnumber":3950,"text":"عمر بن خطاب رضی اللہ عنہ کہتے ہیں جو کسی قرابت دار محرم کا مالک ہو جائے تو وہ ( ملکیت میں آتے ہی ) آزاد ہو جائے گا۔","grades":[{"name":"Al-Albani","grade":"Daif Muquf"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Muquf"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":31,"hadith":25}}]}