{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"34":"Clothing (Kitab Al-Libas)"},"section_detail":{"34":{"hadithnumber_first":4020,"hadithnumber_last":4158,"arabicnumber_first":4020,"arabicnumber_last":4158,"name_native":"کتاب اللباس"}}},"hadiths":[{"hadithnumber":4051,"arabicnumber":4051,"text":"علی رضی اللہ عنہ کہتے ہیں رسول اللہ صلی اللہ علیہ وسلم نے مجھے سونے کی انگوٹھی سے اور قسی ۱؎ پہننے سے اور سرخ زین پوش سے منع فرمایا ہے۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":34,"hadith":32}}]}