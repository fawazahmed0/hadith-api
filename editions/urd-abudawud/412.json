	"hadiths": [
		{
			"hadithnumber": 412,
			"arabicnumber": 412,
			"text": "ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس شخص نے سورج ڈوبنے سے پہلے عصر کی ایک رکعت پالی تو اس نے نماز عصر پالی، اور جس شخص نے سورج نکلنے سے پہلے فجر کی ایک رکعت پالی تو اس نے نماز فجر پالی ۱؎۔",
