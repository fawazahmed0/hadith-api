{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"41":"Types of Blood-Wit (Kitab Al-Diyat)"},"section_detail":{"41":{"hadithnumber_first":4494,"hadithnumber_last":4595,"arabicnumber_first":4494,"arabicnumber_last":4595,"name_native":"کتاب الدیات"}}},"hadiths":[{"hadithnumber":4552,"arabicnumber":4552,"text":"عبداللہ بن مسعود رضی اللہ عنہ کہتے ہیں شبہ عمد کی دیت پچیس حقہ ، پچیس جزعہ ، پچیس بنت لبون ، اور پچیس بنت مخاض ہے ۔","grades":[{"name":"Al-Albani","grade":"Daif Isnaad"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif Isnaad"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":41,"hadith":59}}]}