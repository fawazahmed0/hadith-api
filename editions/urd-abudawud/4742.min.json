{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"42":"Model Behavior of the Prophet (Kitab Al-Sunnah)"},"section_detail":{"42":{"hadithnumber_first":4596,"hadithnumber_last":4772,"arabicnumber_first":4596,"arabicnumber_last":4772,"name_native":"کتاب السنہ"}}},"hadiths":[{"hadithnumber":4742,"arabicnumber":4742,"text":"عبداللہ بن عمرو رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: «صور» ایک سنکھ ہے، جس میں پھونک ماری جائے گی ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":42,"hadith":147}}]}