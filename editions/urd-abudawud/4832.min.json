{"metadata":{"name":"Sunan Abu Dawud","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"عمومی رویہ (کتاب الادب)"}}},"hadiths":[{"hadithnumber":4832,"arabicnumber":4832,"text":"ابوسعید رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: مومن کے سوا کسی کو ساتھی نہ بناؤ ۱؎، اور تمہارا کھانا سوائے پرہیزگار کے کوئی اور نہ کھائے ۔","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":43,"hadith":60}}]}