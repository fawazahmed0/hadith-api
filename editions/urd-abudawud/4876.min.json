{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"عمومی رویہ (کتاب الادب)"}}},"hadiths":[{"hadithnumber":4876,"arabicnumber":4876,"text":"سعید بن زید رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: سب سے بڑی زیادتی یہ ہے کہ آدمی ناحق کسی مسلمان کی بے عزتی کرے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":43,"hadith":104}}]}