{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"عمومی رویہ (کتاب الادب)"}}},"hadiths":[{"hadithnumber":4943,"arabicnumber":4943,"text":"عبداللہ بن عمرو رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: جو ہمارے چھوٹے پر رحم نہ کھائے اور ہمارے بڑے کا حق نہ پہنچانے ( اس کا ادب و احترام نہ کرے ) تو وہ ہم میں سے نہیں ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":43,"hadith":171}}]}