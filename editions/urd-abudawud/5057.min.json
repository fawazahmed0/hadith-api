{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"عمومی رویہ (کتاب الادب)"}}},"hadiths":[{"hadithnumber":5057,"arabicnumber":5057,"text":"عرباض بن ساریہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم سونے سے پہلے «المسبحات» ۱؎ پڑھتے تھے، اور فرماتے تھے: ان میں ایک آیت ایسی ہے جو ہزار آیتوں سے افضل ہے ۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":43,"hadith":285}}]}