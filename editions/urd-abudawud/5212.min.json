{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"عمومی رویہ (کتاب الادب)"}}},"hadiths":[{"hadithnumber":5212,"arabicnumber":5212,"text":"براء رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جب دو مسلمان آپس میں ملتے اور دونوں ایک دوسرے سے مصافحہ کرتے ہیں تو ان دونوں کے ایک دوسرے سے علیحدہ ہونے سے پہلے ہی ان کی مغفرت ہو جاتی ہے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":43,"hadith":440}}]}