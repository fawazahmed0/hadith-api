{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"43":"General Behavior (Kitab Al-Adab)"},"section_detail":{"43":{"hadithnumber_first":4773,"hadithnumber_last":5274,"arabicnumber_first":4773,"arabicnumber_last":5274,"name_native":"عمومی رویہ (کتاب الادب)"}}},"hadiths":[{"hadithnumber":5255,"arabicnumber":5255,"text":"اسامہ نے نافع سے یہی حدیث روایت کی ہے اس میں ہے نافع نے کہا: پھر اس کے بعد میں نے اسے ان کے گھر میں دیکھا۔","grades":[{"name":"Al-Albani","grade":"Hasan Isnaad"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Isnaad"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim (2233)"}],"reference":{"book":43,"hadith":483}}]}