{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":565,"arabicnumber":565,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اللہ کی باندیوں کو اللہ کی مسجدوں سے نہ روکو، البتہ انہیں چاہیئے کہ وہ بغیر خوشبو لگائے نکلیں ۔","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":2,"hadith":175}}]}