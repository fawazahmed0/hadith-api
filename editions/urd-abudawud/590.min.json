{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":590,"arabicnumber":590,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: تم میں سے وہ لوگ اذان دیں جو تم میں بہتر ہوں، اور تمہاری امامت وہ لوگ کریں جو تم میں عالم و قاری ہوں ۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":2,"hadith":200}}]}