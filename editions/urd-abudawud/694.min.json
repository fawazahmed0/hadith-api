{"metadata":{"name":"Sunan Abu Dawud","name_native":"سنن ابوداؤد","section":{"2":"Prayer (Kitab Al-Salat)"},"section_detail":{"2":{"hadithnumber_first":391,"hadithnumber_last":1160,"arabicnumber_first":391,"arabicnumber_last":1160,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":694,"arabicnumber":694,"text":"عبداللہ بن عباس رضی اللہ عنہما کا بیان ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: تم لوگ سوئے ہوئے شخص کے پیچھے نماز نہ پڑھو، اور نہ بات کرنے والے کے پیچھے ۔","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Muhyi Al-Din Abdul Hamid","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":2,"hadith":304}}]}