{"metadata":{"name":"Sunan Ibn Majah","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"کتاب السنہ"}}},"hadiths":[{"hadithnumber":103,"arabicnumber":103,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ جب عمر رضی اللہ عنہ نے اسلام قبول کیا تو جبرائیل علیہ السلام نازل ہوئے اور کہا: اے محمد! عمر کے قبول اسلام سے آسمان والے بہت ہی خوش ہوئے۔","grades":[{"name":"Al-Albani","grade":"Very Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"name":"Shuaib Al Arnaut","grade":"Very Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":0,"hadith":103}}]}