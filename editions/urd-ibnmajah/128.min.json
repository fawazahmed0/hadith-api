{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"کتاب السنہ"}}},"hadiths":[{"hadithnumber":128,"arabicnumber":128,"text":"قیس بن ابی حازم کہتے ہیں کہ میں نے طلحہ رضی اللہ عنہ کا وہ ہاتھ دیکھا جو شل ( بیکار ) ہو گیا تھا، جنگ احد میں انہوں نے اس کو ڈھال بنا کر رسول اللہ صلی اللہ علیہ وسلم کی حفاظت کی تھی۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":0,"hadith":128}}]}