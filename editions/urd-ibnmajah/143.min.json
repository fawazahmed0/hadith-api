{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"کتاب السنہ"}}},"hadiths":[{"hadithnumber":143,"arabicnumber":143,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس نے حسن و حسین سے محبت کی اس نے مجھ سے محبت کی، اور جس نے ان دونوں سے دشمنی کی اس نے مجھ سے دشمنی کی ۱؎۔","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":0,"hadith":143}}]}