{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"کتاب السنہ"}}},"hadiths":[{"hadithnumber":148,"arabicnumber":148,"text":"ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: عمار پر جب بھی دو کام پیش کئے گئے تو انہوں نے ان میں سے بہترین کام کا انتخاب کیا ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":0,"hadith":148}}]}