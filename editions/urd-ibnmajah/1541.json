	"hadiths": [
		{
			"hadithnumber": 1541,
			"arabicnumber": 1541,
			"text": "ابی بن کعب رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس نے نماز جنازہ پڑھی، اس کے لیے ایک قیراط ثواب ہے، اور جو اس کے دفن تک جنازہ میں حاضر رہا اس کے لیے دو قیراط ثواب ہے، اور قسم ہے اس ذات کی جس کے ہاتھ میں محمد کی جان ہے، قیراط اس احد پہاڑ سے بڑا ہے ۱؎ ۔",
