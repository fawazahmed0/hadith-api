{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"کتاب السنہ"}}},"hadiths":[{"hadithnumber":156,"arabicnumber":156,"text":"عبداللہ بن عمرو رضی اللہ عنہما کہتے ہیں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے سنا: زمین نے کسی ایسے شخص کو نہ اٹھایا، اور نہ آسمان اس پر سایہ فگن ہوا جو ابوذر سے بڑھ کر سچی بات کہنے والا ہو ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Lighairihi"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":0,"hadith":156}}]}