{"metadata":{"name":"Sunan Ibn Majah","section":{"6":"Chapters Regarding Funerals"},"section_detail":{"6":{"hadithnumber_first":1433,"hadithnumber_last":1637,"arabicnumber_first":1433,"arabicnumber_last":1637,"name_native":"کتاب الجنائز"}}},"hadiths":[{"hadithnumber":1560,"arabicnumber":1560,"text":"ہشام بن عامر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: قبر کو خوب کھودو، اسے کشادہ اور اچھی بناؤ ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":6,"hadith":128}}]}