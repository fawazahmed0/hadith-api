{"metadata":{"name":"Sunan Ibn Majah","section":{"6":"Chapters Regarding Funerals"},"section_detail":{"6":{"hadithnumber_first":1433,"hadithnumber_last":1637,"arabicnumber_first":1433,"arabicnumber_last":1637,"name_native":"کتاب الجنائز"}}},"hadiths":[{"hadithnumber":1585,"arabicnumber":1585,"text":"ابوامامہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے اس عورت پر لعنت کی جو اپنا ( نوحہ میں ) چہرہ نوچے، اپنا گریبان پھاڑے اور خرابی بربادی اور ہلاکت کے الفاظ پکارے۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":6,"hadith":153}}]}