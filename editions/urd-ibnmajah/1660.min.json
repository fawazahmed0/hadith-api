{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"کتاب الصوم (روزہ)"}}},"hadiths":[{"hadithnumber":1660,"arabicnumber":1660,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول صلی اللہ علیہ وسلم نے فرمایا: عید الفطر وہ دن ہے جس میں تم لوگ روزہ توڑ دیتے ہو، اور عید الاضحی وہ دن ہے جس میں تم لوگ قربانی کرتے ہو ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":7,"hadith":23}}]}