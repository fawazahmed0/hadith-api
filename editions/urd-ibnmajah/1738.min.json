{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"7":"Fasting"},"section_detail":{"7":{"hadithnumber_first":1638,"hadithnumber_last":1782,"arabicnumber_first":1638,"arabicnumber_last":1782,"name_native":"کتاب الصوم (روزہ)"}}},"hadiths":[{"hadithnumber":1738,"arabicnumber":1738,"text":"ابوقتادہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: عاشوراء کا روزہ میں سمجھتا ہوں کہ اس کے ذریعہ اللہ تعالیٰ پچھلے ایک سال کے گناہ معاف کر دے گا ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":7,"hadith":101}}]}