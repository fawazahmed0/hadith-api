	"hadiths": [
		{
			"hadithnumber": 1794,
			"arabicnumber": 1794,
			"text": "جابر بن عبداللہ رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: پانچ اونٹ سے کم میں زکاۃ نہیں ہے، اور پانچ اوقیہ سے کم چاندی میں زکاۃ نہیں ہے، اور پانچ وسق سے کم اناج یا میوہ میں زکاۃ نہیں ہے ۔",
