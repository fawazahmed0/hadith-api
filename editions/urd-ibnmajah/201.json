	"hadiths": [
		{
			"hadithnumber": 201,
			"arabicnumber": 201,
			"text": "جابر بن عبداللہ رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم حج کے دنوں میں اپنے آپ کو لوگوں کے سامنے پیش کرتے اور فرماتے: کیا کوئی ایسا شخص نہیں ہے جو مجھے اپنی قوم میں لے جائے؟ اس لیے کہ قریش نے مجھے اپنے رب کے کلام کی تبلیغ سے روک دیا ہے ۱؎۔",
