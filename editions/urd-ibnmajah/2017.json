	"hadiths": [
		{
			"hadithnumber": 2017,
			"arabicnumber": 2017,
			"text": "ابوموسیٰ اشعری رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ان لوگوں کا کیا حال ہے جو اللہ کے حدود سے کھیل کرتے ہیں، ان میں سے ایک اپنی بیوی سے کہتا ہے: میں نے تجھے طلاق دے دی پھر تجھ سے رجعت کر لی، پھر تجھے طلاق دے دی ۔",
