{"metadata":{"name":"Sunan Ibn Majah","section":{"10":"The Chapters on Divorce"},"section_detail":{"10":{"hadithnumber_first":2016,"hadithnumber_last":2477,"arabicnumber_first":2016,"arabicnumber_last":2477,"name_native":"کتاب الطلاق"}}},"hadiths":[{"hadithnumber":2047,"arabicnumber":2047,"text":"عبداللہ بن عمرو بن العاص رضی اللہ عنہما سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: آدمی جس عورت کا بطور نکاح مالک نہیں اس کی طلاق کا کوئی اعتبار نہیں ہے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":10,"hadith":32}}]}