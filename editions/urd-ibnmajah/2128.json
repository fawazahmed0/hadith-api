	"hadiths": [
		{
			"hadithnumber": 2128,
			"arabicnumber": 2128,
			"text": "عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: جس نے نذر مانی اور اس کی تعیین نہ کی، تو اس کا کفارہ قسم کا کفارہ ہے، اور جس نے ایسی نذر مانی جس کے پورا کرنے کی طاقت نہیں رکھتا تو اس کا کفارہ قسم کا کفارہ ہے، اور جس نے ایسی نذر مانی جس کے پورا کرنے کی طاقت ہو تو اس کو پورا کرے ۔",
