{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"13":"The Chapters on Rulings"},"section_detail":{"13":{"hadithnumber_first":2308,"hadithnumber_last":2374,"arabicnumber_first":2308,"arabicnumber_last":2374,"name_native":"احکام کے ابواب"}}},"hadiths":[{"hadithnumber":2367,"arabicnumber":2367,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ انہوں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے سنا: بدوی ( دیہات میں رہنے والے ) کی گواہی شہری ( بستی میں رہنے والے ) کے خلاف جائز نہیں ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":13,"hadith":60}}]}