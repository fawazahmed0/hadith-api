{"metadata":{"name":"Sunan Ibn Majah","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"کتاب السنہ"}}},"hadiths":[{"hadithnumber":243,"arabicnumber":243,"text":"ابوہریرہ رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: سب سے بہتر اور افضل صدقہ یہ ہے کہ کوئی مسلمان علم دین سیکھے، پھر اسے اپنے مسلمان بھائی کو سکھائے ۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":0,"hadith":243}}]}