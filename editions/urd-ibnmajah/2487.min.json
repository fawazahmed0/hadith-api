{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"16":"The Chapters on Pawning"},"section_detail":{"16":{"hadithnumber_first":2436,"hadithnumber_last":2491,"arabicnumber_first":2436,"arabicnumber_last":2491,"name_native":"پیاد کرنے کے ابواب"}}},"hadiths":[{"hadithnumber":2487,"arabicnumber":2487,"text":"ابو سعید خدری رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: کنویں کی چوحدی اس کی رسی کی لمبائی کے برابر ہو گی ۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":16,"hadith":52}}]}