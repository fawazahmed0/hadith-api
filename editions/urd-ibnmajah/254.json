	"hadiths": [
		{
			"hadithnumber": 254,
			"arabicnumber": 254,
			"text": "جابر بن عبداللہ رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: تم علم کو علماء پر فخر کرنے یا کم عقلوں سے بحث و تکرار کے لیے نہ سیکھو، اور علم دین کو مجالس میں اچھے مقام کے حصول کا ذریعہ نہ بناؤ، جس نے ایسا کیا تو اس کے لیے جہنم ہے، جہنم ۱؎۔",
