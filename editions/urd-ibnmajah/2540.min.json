{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"20":"The Chapters on Legal Punishments"},"section_detail":{"20":{"hadithnumber_first":2533,"hadithnumber_last":2614,"arabicnumber_first":2533,"arabicnumber_last":2614,"name_native":"کتاب الحدود"}}},"hadiths":[{"hadithnumber":2540,"arabicnumber":2540,"text":"عبادہ بن صامت رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: اللہ تعالیٰ کی حدود کو نافذ کرو، خواہ کوئی قریبی ہو یا دور کا، اور اللہ تعالیٰ کے معاملے میں کسی ملامت کرنے والے کی ملامت کی پروا نہ کرو ۔","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":20,"hadith":8}}]}