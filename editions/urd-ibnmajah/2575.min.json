{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"20":"The Chapters on Legal Punishments"},"section_detail":{"20":{"hadithnumber_first":2533,"hadithnumber_last":2614,"arabicnumber_first":2533,"arabicnumber_last":2614,"name_native":"کتاب الحدود"}}},"hadiths":[{"hadithnumber":2575,"arabicnumber":2575,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: جو ہم مسلمانوں پر ہتھیار اٹھائے وہ ہم میں سے نہیں ہے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":20,"hadith":43}}]}