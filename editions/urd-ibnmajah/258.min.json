{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"کتاب السنہ"}}},"hadiths":[{"hadithnumber":258,"arabicnumber":258,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: جس شخص نے غیر اللہ کے لیے علم طلب کیا، یا اللہ کے علاوہ کی ( رضا مندی ) چاہی، تو وہ اپنا ٹھکانا جہنم کو بنا لے ۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":0,"hadith":258}}]}