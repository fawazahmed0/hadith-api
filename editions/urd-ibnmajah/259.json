	"hadiths": [
		{
			"hadithnumber": 259,
			"arabicnumber": 259,
			"text": "حذیفہ رضی اللہ عنہ کہتے ہیں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے ہوئے سنا: تم علم کو علماء پر فخر کرنے یا کم عقلوں سے بحث و تکرار کرنے یا لوگوں کو اپنی جانب متوجہ کرنے کے لیے نہ سیکھو، جس نے ایسا کیا اس کا ٹھکانا جہنم میں ہو گا ۔",
