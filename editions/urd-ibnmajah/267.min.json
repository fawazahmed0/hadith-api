{"metadata":{"name":"Sunan Ibn Majah","section":{"1":"The Book of Purification and its Sunnah"},"section_detail":{"1":{"hadithnumber_first":267,"hadithnumber_last":666,"arabicnumber_first":267,"arabicnumber_last":666,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":267,"arabicnumber":267,"text":"سفینہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم ایک مد پانی سے وضو فرماتے تھے، اور ایک صاع پانی سے غسل ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":1,"hadith":1}}]}