{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"کتاب السنہ"}}},"hadiths":[{"hadithnumber":27,"arabicnumber":27,"text":"طاؤس کہتے ہیں کہ میں نے عبداللہ بن عباس رضی اللہ عنہما کو کہتے سنا: ہم تو بس حدیثیں یاد کرتے تھے اور حدیث رسول تو یاد کی ہی جاتی ہے، لیکن جب تم مشکل اور آسان راستوں پر چلنے لگے تو ہم نے دوری اختیار کر لی ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":0,"hadith":27}}]}