{"metadata":{"name":"Sunan Ibn Majah","section":{"24":"The Chapters on Jihad"},"section_detail":{"24":{"hadithnumber_first":2753,"hadithnumber_last":2881,"arabicnumber_first":2753,"arabicnumber_last":2881,"name_native":"کتاب الجہاد"}}},"hadiths":[{"hadithnumber":2774,"arabicnumber":2774,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: اللہ کی راہ کا غبار، اور جہنم کا دھواں، دونوں کسی مسلمان کے پیٹ میں اکٹھا نہ ہوں گے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":24,"hadith":22}}]}