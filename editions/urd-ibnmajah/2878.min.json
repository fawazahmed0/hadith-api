{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"24":"The Chapters on Jihad"},"section_detail":{"24":{"hadithnumber_first":2753,"hadithnumber_last":2881,"arabicnumber_first":2753,"arabicnumber_last":2881,"name_native":"کتاب الجہاد"}}},"hadiths":[{"hadithnumber":2878,"arabicnumber":2878,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: مسابقت ( آگے بڑھنے ) کی شرط گھوڑے اور اونٹ کے علاوہ کسی میں جائز نہیں ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":24,"hadith":126}}]}