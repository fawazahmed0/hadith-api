	"hadiths": [
		{
			"hadithnumber": 2904,
			"arabicnumber": 2904,
			"text": "عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ ایک شخص نبی اکرم صلی اللہ علیہ وسلم کے پاس آیا اور بولا: کیا میں اپنے والد کی طرف سے حج کر لوں؟ آپ صلی اللہ علیہ وسلم نے فرمایا: ہاں، اپنے والد کی طرف سے حج کرو، اگر تم ان کی نیکی نہ بڑھا سکے تو ان کی برائی میں اضافہ مت کرو ۱؎۔",
