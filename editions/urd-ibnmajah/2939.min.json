{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"25":"Chapters on Hajj Rituals"},"section_detail":{"25":{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119,"name_native":"مناسک حج کے ابواب"}}},"hadiths":[{"hadithnumber":2939,"arabicnumber":2939,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ انبیاء کرام ( علیہ السلام ) حرم میں پیدل اور ننگے پاؤں داخل ہوتے تھے، اور بیت اللہ کا طواف کرتے تھے، اور حج کے سارے ارکان ننگے پاؤں اور پیدل چل کر ادا کرتے تھے۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":25,"hadith":58}}]}