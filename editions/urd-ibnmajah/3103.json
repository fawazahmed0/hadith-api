	"hadiths": [
		{
			"hadithnumber": 3103,
			"arabicnumber": 3103,
			"text": "ابوہریرہ رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے ایک شخص کو دیکھا کہ وہ ہدی کا اونٹ ہانک کر لے جا رہا ہے، آپ صلی اللہ علیہ وسلم نے فرمایا: اس پر سوار ہو جاؤ ، اس نے کہا: یہ ہدی کا اونٹ ہے، آپ صلی اللہ علیہوسلم نے فرمایا: سوار ہو جاؤ، تمہارا برا ہو ۱؎۔",
