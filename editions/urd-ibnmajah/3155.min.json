{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"26":"Chapters on Sacrifices"},"section_detail":{"26":{"hadithnumber_first":3120,"hadithnumber_last":3161,"arabicnumber_first":3120,"arabicnumber_last":3161,"name_native":"کتاب الاضاحی (قربانی)"}}},"hadiths":[{"hadithnumber":3155,"arabicnumber":3155,"text":"انس بن مالک رضی اللہ عنہ کہتے ہیں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو اپنی قربانی اپنے ہاتھ سے ذبح کرتے ہوئے دیکھا آپ اپنا پاؤں اس کے پٹھے پر رکھے ہوئے تھے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":26,"hadith":36}}]}