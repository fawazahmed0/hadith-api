{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"27":"Chapters on Slaughtering"},"section_detail":{"27":{"hadithnumber_first":3162,"hadithnumber_last":3199,"arabicnumber_first":3162,"arabicnumber_last":3199,"name_native":"ذبح کرنے سے متعلق ابواب"}}},"hadiths":[{"hadithnumber":3172,"arabicnumber":3172,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے چھری کو تیز کرنے، اور اسے جانوروں سے چھپانے کا حکم دیا، اور فرمایا: جب تم میں سے کوئی ذبح کرے تو اچھی طرح ذبح کرے تاکہ اس کی جان جلد نکل جائے۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":27,"hadith":11}}]}