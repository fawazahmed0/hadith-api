{"metadata":{"name":"Sunan Ibn Majah","section":{"28":"Chapters on Hunting"},"section_detail":{"28":{"hadithnumber_first":3200,"hadithnumber_last":3250,"arabicnumber_first":3200,"arabicnumber_last":3250,"name_native":"کتاب الصید"}}},"hadiths":[{"hadithnumber":3202,"arabicnumber":3202,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے کہ رسول اللہ صلی اللہ علیہ وسلم نے کتوں کو قتل کر دینے کا حکم دیا ہے۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":28,"hadith":3}}]}