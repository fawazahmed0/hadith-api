{"metadata":{"name":"Sunan Ibn Majah","section":{"28":"Chapters on Hunting"},"section_detail":{"28":{"hadithnumber_first":3200,"hadithnumber_last":3250,"arabicnumber_first":3200,"arabicnumber_last":3250,"name_native":"کتاب الصید"}}},"hadiths":[{"hadithnumber":3248,"arabicnumber":3248,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ کوّا کون کھائے گا؟ جب کہ رسول اللہ صلی اللہ علیہ وسلم نے اس کو فاسق کہا، اللہ کی قسم وہ پاک چیزوں میں سے نہیں ہے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":28,"hadith":49}}]}