{"metadata":{"name":"Sunan Ibn Majah","section":{"1":"The Book of Purification and its Sunnah"},"section_detail":{"1":{"hadithnumber_first":267,"hadithnumber_last":666,"arabicnumber_first":267,"arabicnumber_last":666,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":334,"arabicnumber":334,"text":"عبدالرحمٰن بن ابوقراد رضی اللہ عنہ کہتے ہیں کہ میں نے نبی اکرم صلی اللہ علیہ وسلم کے ساتھ حج کیا، آپ قضائے حاجت کے لیے دور نکل گئے۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":1,"hadith":68}}]}