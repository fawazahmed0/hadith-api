{"metadata":{"name":"Sunan Ibn Majah","section":{"29":" Chapters on Food"},"section_detail":{"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370,"name_native":"خوراک پر ابواب"}}},"hadiths":[{"hadithnumber":3355,"arabicnumber":3355,"text":"جابر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: شام کا کھانا مت ترک کرو اگرچہ اس کی مقدار ایک مشت کھجور ہو، اس لیے کہ شام کا کھانا نہ کھانے سے بڑھاپا آتا ہے ۔","grades":[{"name":"Al-Albani","grade":"Very Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"name":"Shuaib Al Arnaut","grade":"Sanad Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":29,"hadith":105}}]}