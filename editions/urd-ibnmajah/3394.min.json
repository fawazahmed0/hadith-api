{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"30":"Chapters on Drinks"},"section_detail":{"30":{"hadithnumber_first":3371,"hadithnumber_last":3435,"arabicnumber_first":3371,"arabicnumber_last":3435,"name_native":"کتاب الاشربہ"}}},"hadiths":[{"hadithnumber":3394,"arabicnumber":3394,"text":"عبداللہ بن عمرو بن العاص رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس کی زیادہ مقدار نشہ لانے والی ہو، اس کا تھوڑا بھی حرام ہے ۔","grades":[{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":30,"hadith":24}}]}