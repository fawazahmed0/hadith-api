{"metadata":{"name":"Sunan Ibn Majah","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"کتاب الطب"}}},"hadiths":[{"hadithnumber":3447,"arabicnumber":3447,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ انہوں نے رسول اللہ صلی اللہ علیہ وسلم کو فرماتے سنا: کلونجی میں ہر مرض کا علاج ہے، سوائے «سام» کے، اور «سام»موت ہے، اور کالا دانہ «شونیز» یعنی کلونجی ہے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":31,"hadith":12}}]}