{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"31":"Chapters on Medicine"},"section_detail":{"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549,"name_native":"کتاب الطب"}}},"hadiths":[{"hadithnumber":3479,"arabicnumber":3479,"text":"انس بن مالک رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس رات معراج ہوئی میرا گزر فرشتوں کی جس جماعت پر ہوا اس نے کہا: محمد ( صلی اللہ علیہ وسلم ) ! اپنی امت کو پچھنا لگانے کا حکم دیں ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":31,"hadith":44}}]}