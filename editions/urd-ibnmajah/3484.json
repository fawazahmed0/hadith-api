	"hadiths": [
		{
			"hadithnumber": 3484,
			"arabicnumber": 3484,
			"text": "ابوکبشہ انماری رضی اللہ عنہ بیان کرتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم اپنے سر پر اور دونوں کندھوں کے درمیان پچھنا لگواتے اور فرماتے تھے: جو ان مقامات سے خون بہا دے، تو اگر وہ کسی بیماری کا کسی چیز سے علاج نہ کرے تو اس کے لیے نقصان دہ نہیں ہو سکتا ۔",
