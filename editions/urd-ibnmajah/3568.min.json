{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"32":"Chapters on Dress"},"section_detail":{"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656,"name_native":"کتاب اللباس"}}},"hadiths":[{"hadithnumber":3568,"arabicnumber":3568,"text":"ابوالدرداء رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: سب سے بہتر لباس جس کو پہن کر تم اپنی قبروں اور مسجدوں میں اللہ کی زیارت کرتے ہو، سفید لباس ہے ۔","grades":[{"name":"Al-Albani","grade":"Mawdu"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Mawdu"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":32,"hadith":19}}]}