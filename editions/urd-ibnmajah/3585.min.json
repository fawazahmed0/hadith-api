{"metadata":{"name":"Sunan Ibn Majah","section":{"32":"Chapters on Dress"},"section_detail":{"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656,"name_native":"کتاب اللباس"}}},"hadiths":[{"hadithnumber":3585,"arabicnumber":3585,"text":"جابر رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم جب مکہ میں ( فتح کے دن ) داخل ہوئے، تو آپ کے سر پر کالی پگڑی تھی۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"}],"reference":{"book":32,"hadith":36}}]}