{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"33":"Etiquette"},"section_detail":{"33":{"hadithnumber_first":3657,"hadithnumber_last":3826,"arabicnumber_first":3657,"arabicnumber_last":3826,"name_native":"کتاب الادب"}}},"hadiths":[{"hadithnumber":3662,"arabicnumber":3662,"text":"ابوامامہ رضی اللہ عنہ سے روایت ہے کہ ایک شخص نے عرض کیا: اللہ کے رسول! والدین کا حق ان کی اولاد پر کیا ہے؟ آپ صلی اللہ علیہ وسلم نے فرمایا: وہی دونوں تیری جنت اور جہنم ہیں ۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":33,"hadith":6}}]}