	"hadiths": [
		{
			"hadithnumber": 3683,
			"arabicnumber": 3683,
			"text": "ابوذر رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: میری امت کے اچھے اور برے اعمال میرے سامنے پیش کیے گئے، تو میں نے ان میں سب سے بہتر عمل راستے سے تکلیف دہ چیز کے ہٹانے، اور سب سے برا عمل مسجد میں تھوکنے، اور اس پر مٹی نہ ڈالنے کو پایا ۔",
