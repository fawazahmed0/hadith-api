{"metadata":{"name":"Sunan Ibn Majah","section":{"33":"Etiquette"},"section_detail":{"33":{"hadithnumber_first":3657,"hadithnumber_last":3826,"arabicnumber_first":3657,"arabicnumber_last":3826,"name_native":"کتاب الادب"}}},"hadiths":[{"hadithnumber":3746,"arabicnumber":3746,"text":"ابومسعود رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس سے مشورہ لیا جائے وہ امانت دار ہے ( لہٰذا وہ دیانتداری سے مشورہ دے ) ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":33,"hadith":90}}]}