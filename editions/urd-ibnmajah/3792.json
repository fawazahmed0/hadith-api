	"hadiths": [
		{
			"hadithnumber": 3792,
			"arabicnumber": 3792,
			"text": "ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: اللہ تعالیٰ ارشاد فرماتا ہے کہ میں اپنے بندے کے ساتھ ہوتا ہوں، جب وہ میرا ذکر کرتا ہے، اور اس کے ہونٹ میرے ذکر کی وجہ سے حرکت میں ہوتے ہیں ۔",
