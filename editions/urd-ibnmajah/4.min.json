{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"0":"The Book of the Sunnah"},"section_detail":{"0":{"hadithnumber_first":1,"hadithnumber_last":266,"arabicnumber_first":1,"arabicnumber_last":266,"name_native":"کتاب السنہ"}}},"hadiths":[{"hadithnumber":4,"arabicnumber":4,"text":"ابو جعفر کہتے ہیں کہ عبداللہ بن عمر رضی اللہ عنہما جب رسول اللہ صلی اللہ علیہ وسلم سے کوئی حدیث سنتے تو نہ اس میں کچھ بڑھاتے، اور نہ ہی کچھ گھٹاتے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":0,"hadith":4}}]}