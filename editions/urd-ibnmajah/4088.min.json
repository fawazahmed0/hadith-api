{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"36":"Tribulations"},"section_detail":{"36":{"hadithnumber_first":3927,"hadithnumber_last":4099,"arabicnumber_first":3927,"arabicnumber_last":4099,"name_native":"فتنوں"}}},"hadiths":[{"hadithnumber":4088,"arabicnumber":4088,"text":"عبداللہ بن حارث بن جزء زبیدی رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: کچھ لوگ مشرق ( پورب ) کی جانب سے نکلیں گے جو مہدی کی حکومت کے لیے راستہ ہموار کریں گے ۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Daif"},{"name":"Shuaib Al Arnaut","grade":"Very Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":36,"hadith":163}}]}