{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"37":"Zuhd"},"section_detail":{"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341,"name_native":"زہد"}}},"hadiths":[{"hadithnumber":4123,"arabicnumber":4123,"text":"ابو سعید خدری رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: فقیر مہاجرین، مالدار مہاجرین سے پانچ سو سال پہلے جنت میں داخل ہوں گے ۔","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":37,"hadith":24}}]}