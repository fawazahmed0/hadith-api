{"metadata":{"name":"Sunan Ibn Majah","section":{"37":"Zuhd"},"section_detail":{"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341,"name_native":"زہد"}}},"hadiths":[{"hadithnumber":4140,"arabicnumber":4140,"text":"انس رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: قیامت کے دن کوئی مالدار یا فقیر ایسا نہ ہو گا جو یہ تمنا نہ کرے کہ اس کو دنیا میں بہ قدر ضرورت روزی ملی ہوتی ۔","grades":[{"name":"Al-Albani","grade":"Very Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"name":"Shuaib Al Arnaut","grade":"Very Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":37,"hadith":41}}]}