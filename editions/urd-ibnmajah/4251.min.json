{"metadata":{"name":"Sunan Ibn Majah","section":{"37":"Zuhd"},"section_detail":{"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341,"name_native":"زہد"}}},"hadiths":[{"hadithnumber":4251,"arabicnumber":4251,"text":"انس رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: سارے بنی آدم ( انسان ) گناہ گار ہیں اور بہترین گناہ گار وہ ہیں جو توبہ کرنے والے ہیں ۔","grades":[{"name":"Al-Albani","grade":"Hasan"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan"},{"name":"Shuaib Al Arnaut","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":37,"hadith":152}}]}