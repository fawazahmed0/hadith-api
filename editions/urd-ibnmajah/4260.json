	"hadiths": [
		{
			"hadithnumber": 4260,
			"arabicnumber": 4260,
			"text": "ابو یعلیٰ شداد بن اوس رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: عقلمند وہ ہے جو اپنے نفس کا محاسبہ کرے، اور موت کے بعد کی زندگی کے لیے عمل کرے، اور عاجز وہ ہے جو اپنے نفس کو خواہشوں پر لگا دے، پھر اللہ تعالیٰ سے تمنائیں کرے۔",
