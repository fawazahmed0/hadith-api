{"metadata":{"name":"Sunan Ibn Majah","section":{"37":"Zuhd"},"section_detail":{"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341,"name_native":"زہد"}}},"hadiths":[{"hadithnumber":4271,"arabicnumber":4271,"text":"کعب رضی اللہ عنہ کہتے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: مومن کی روح ایک پرندے کی شکل میں جنت کے درخت میں لٹکتی رہے گی، یہاں تک کہ وہ قیامت کے دن اپنے اصلی بدن میں لوٹ جائے گی ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":37,"hadith":172}}]}