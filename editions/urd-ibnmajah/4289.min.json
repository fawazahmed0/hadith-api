{"metadata":{"name":"Sunan Ibn Majah","section":{"37":"Zuhd"},"section_detail":{"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341,"name_native":"زہد"}}},"hadiths":[{"hadithnumber":4289,"arabicnumber":4289,"text":"بریدہ رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: جنت والوں کی ایک سو بیس صفیں ہوں گی، ان میں سے اسی صفیں اس امت کے لوگوں کی ہوں گی، اور چالیس صفیں اور امتوں میں سے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":37,"hadith":190}}]}