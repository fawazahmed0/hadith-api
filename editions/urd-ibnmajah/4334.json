	"hadiths": [
		{
			"hadithnumber": 4334,
			"arabicnumber": 4334,
			"text": "عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: کوثر جنت میں ایک نہر ہے، اس کے دونوں کنارے سونے کے ہیں، اور اس کی پانی بہنے کی نالی یا قوت و موتی پر ہو گی، اس کی مٹی مشک سے زیادہ خوشبودار ہے، اور اس کا پانی شہد سے زیادہ میٹھا اور برف سے زیادہ سفید ہے۔",
