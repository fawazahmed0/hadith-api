	"hadiths": [
		{
			"hadithnumber": 6,
			"arabicnumber": 6,
			"text": "قرہ بن ایاس رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: میری امت میں سے ایک گروہ کو ہمیشہ قیامت تک اللہ تعالیٰ کی مدد حاصل رہے گی ۱؎، اور جو اس کی تائید و مدد نہ کرے گا اسے کوئی نقصان نہیں پہنچا سکے گا ۔",
