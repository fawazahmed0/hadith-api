	"hadiths": [
		{
			"hadithnumber": 66,
			"arabicnumber": 66,
			"text": "انس بن مالک رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: کوئی شخص مومن نہیں ہو سکتا جب تک کہ وہ اپنے بھائی ( یا اپنے پڑوسی ) کے لیے وہی چیز پسند نہ کرے جو وہ اپنے لیے پسند کرتا ہے ۱؎۔",
