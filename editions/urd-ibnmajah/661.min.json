{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"1":"The Book of Purification and its Sunnah"},"section_detail":{"1":{"hadithnumber_first":267,"hadithnumber_last":666,"arabicnumber_first":267,"arabicnumber_last":666,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":661,"arabicnumber":661,"text":"ابو سعید خدری رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: عورت عورت کے اور مرد مرد کے ستر کو نہ دیکھے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":1,"hadith":395}}]}