{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"4":"The Book On The Mosques And The Congregations"},"section_detail":{"4":{"hadithnumber_first":735,"hadithnumber_last":802,"arabicnumber_first":735,"arabicnumber_last":802,"name_native":"مساجد اور اجتماعات پر کتاب"}}},"hadiths":[{"hadithnumber":782,"arabicnumber":782,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: مسجد میں جو جتنا ہی دور سے آتا ہے، اس کو اتنا ہی زیادہ اجر ملتا ہے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":4,"hadith":48}}]}