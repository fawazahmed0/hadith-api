{"metadata":{"name":"Sunan Ibn Majah","name_native":"سنن ابن ماجہ","section":{"4":"The Book On The Mosques And The Congregations"},"section_detail":{"4":{"hadithnumber_first":735,"hadithnumber_last":802,"arabicnumber_first":735,"arabicnumber_last":802,"name_native":"مساجد اور اجتماعات پر کتاب"}}},"hadiths":[{"hadithnumber":787,"arabicnumber":787,"text":"ابوہریرہ رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جماعت کی فضیلت تم میں سے کسی کے اکیلے نماز پڑھنے سے پچیس درجہ زیادہ ہے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Bukhari And Muslim"}],"reference":{"book":4,"hadith":53}}]}