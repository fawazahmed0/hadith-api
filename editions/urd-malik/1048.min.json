{"metadata":{"name":"Muwatta Malik","name_native":"موطا امام مالک","section":{"24":"Slaughtering Animals"},"section_detail":{"24":{"hadithnumber_first":1042,"hadithnumber_last":1051,"arabicnumber_first":1042,"arabicnumber_last":1051,"name_native":"جانوروں کو ذبح کرنا"}}},"hadiths":[{"hadithnumber":1048,"arabicnumber":1048,"text":"سعید بن مسیب کہتے تھے جس چیز سے ذبح کیا جائے جب وہ کاٹ دے کچھ حرج نہیں کھانے میں اس کے جب ضرورت ہو ۔","grades":[{"name":"Salim al-Hilali","grade":"Maqtu Sahih"}],"reference":{"book":24,"hadith":7}}]}