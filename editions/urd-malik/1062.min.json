{"metadata":{"name":"Muwatta Malik","name_native":"موطا امام مالک","section":{"25":"Game"},"section_detail":{"25":{"hadithnumber_first":1052,"hadithnumber_last":1066,"arabicnumber_first":1052,"arabicnumber_last":1066,"name_native":"کتاب الصید"}}},"hadiths":[{"hadithnumber":1062,"arabicnumber":1062,"text":"ابو ثعلبہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا ہر درندے دانت والے کا کھانا حرام ہے ۔","grades":[{"name":"Salim al-Hilali","grade":"Shadh"}],"reference":{"book":25,"hadith":11}}]}