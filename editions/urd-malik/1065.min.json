{"metadata":{"name":"Muwatta Malik","name_native":"موطا امام مالک","section":{"25":"Game"},"section_detail":{"25":{"hadithnumber_first":1052,"hadithnumber_last":1066,"arabicnumber_first":1052,"arabicnumber_last":1066,"name_native":"کتاب الصید"}}},"hadiths":[{"hadithnumber":1065,"arabicnumber":1065,"text":"عبداللہ بن عباس رضی اللہ تعالیٰ عنہما سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا جو کھال دباغت کی جائے پاک ہو جائے گی ۔","grades":[{"name":"Salim al-Hilali","grade":"Sahih"}],"reference":{"book":25,"hadith":14}}]}