{"metadata":{"name":"Muwatta Malik","name_native":"موطا امام مالک","section":{"2":"Purity"},"section_detail":{"2":{"hadithnumber_first":32,"hadithnumber_last":145,"arabicnumber_first":32,"arabicnumber_last":145,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":118,"arabicnumber":118,"text":"عبداللہ بن عمر کو پسینہ آتا کپڑے میں اور وہ جنبی ہوتے تھے پھر اسی کپڑے سے نماز پڑھتے تھے ۔","grades":[{"name":"Salim al-Hilali","grade":"Mauquf Sahih"}],"reference":{"book":2,"hadith":87}}]}