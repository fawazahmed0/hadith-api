{"metadata":{"name":"Muwatta Malik","section":{"54":"General Subjects"},"section_detail":{"54":{"hadithnumber_first":1763,"hadithnumber_last":1807,"arabicnumber_first":1763,"arabicnumber_last":1807,"name_native":"عمومی مضامین"}}},"hadiths":[{"hadithnumber":1784,"arabicnumber":1784,"text":"عبداللہ بن عمر رضی اللہ تعالیٰ عنہ سے روایت ہے فرمایا رسول اللہ صلی اللہ علیہ وسلم نے کہ نحوست گھر، عورت، اور گھوڑے میں ہوتی ہے","grades":[{"name":"Salim al-Hilali","grade":"Shadh"}],"reference":{"book":54,"hadith":22}}]}