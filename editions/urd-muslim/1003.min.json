{"metadata":{"name":"Sahih Muslim","name_native":"صحیح مسلم","section":{"4":"The Book of Prayers "},"section_detail":{"4":{"hadithnumber_first":837,"hadithnumber_last":1160,"arabicnumber_first":377,"arabicnumber_last":519.02,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":1003,"arabicnumber":"447.02","text":"حماد بن زید ، ابو اسامہ ، وکیع اور ابو معاویہ نے اپنی اپنی سند کے ساتھ ہشام سے اسی سابقہ سند کے ساتھ یہی حدیث روایت کی ہے ۔","grades":[],"reference":{"book":4,"hadith":165}}]}