{"metadata":{"name":"Sunan an Nasai","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":110,"arabicnumber":110,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ ابوالقاسم صلی اللہ علیہ وسلم نے فرمایا: ( وضو میں ) ایڑی دھونے میں کوتاہی کرنے والوں کے لیے جہنم کی تباہی ہے ۱؎۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":1,"hadith":110}}]}