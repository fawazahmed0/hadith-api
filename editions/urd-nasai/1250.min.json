{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"13":"The Book of Forgetfulness (In Prayer)"},"section_detail":{"13":{"hadithnumber_first":1179,"hadithnumber_last":1366,"arabicnumber_first":1179,"arabicnumber_last":1366,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":1250,"arabicnumber":1250,"text":"عبداللہ بن جعفر رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: جو اپنی نماز میں شک کرے تو وہ سلام پھیرنے کے بعد دو سجدے کرے ۔","grades":[{"name":"Abu Ghuddah","grade":"Daif"},{"name":"Al-Albani","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":13,"hadith":72}}]}