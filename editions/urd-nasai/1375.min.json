{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"14":"The Book of Jumu'ah (Friday Prayer)"},"section_detail":{"14":{"hadithnumber_first":1367,"hadithnumber_last":1432,"arabicnumber_first":1367,"arabicnumber_last":1432,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":1375,"arabicnumber":1375,"text":"ابو سعید خدری رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جمعہ کے دن ہر بالغ شخص پر غسل کرنا واجب ہے، مسواک کرنا بھی، اور خوشبو جس پروہ قادر ہو لگانا بھی ۱؎ ۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":14,"hadith":12}}]}