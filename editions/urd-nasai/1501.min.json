{"metadata":{"name":"Sunan an Nasai","section":{"16":"The Book of Eclipses"},"section_detail":{"16":{"hadithnumber_first":1459,"hadithnumber_last":1503,"arabicnumber_first":1459,"arabicnumber_last":1503,"name_native":"چاند گرہن کی کتاب"}}},"hadiths":[{"hadithnumber":1501,"arabicnumber":1501,"text":"سمرہ رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے جس وقت سورج گرہن لگا خطبہ دیا تو آپ نے ( حمد و ثنا کے بعد ) «أما بعد» کہا۔","grades":[{"name":"Abu Ghuddah","grade":"Daif"},{"name":"Al-Albani","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":16,"hadith":43}}]}