{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"18":"The Book of the Fear Prayer"},"section_detail":{"18":{"hadithnumber_first":1529,"hadithnumber_last":1555,"arabicnumber_first":1529,"arabicnumber_last":1555,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":1531,"arabicnumber":1531,"text":"زید بن ثابت رضی اللہ عنہ نے نبی اکرم صلی اللہ علیہ وسلم سے حذیفہ رضی اللہ عنہ کی نماز کے مثل روایت کی ہے۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih Lighairihi"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":18,"hadith":3}}]}