{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":178,"arabicnumber":178,"text":"ابوطلحہ رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: آگ کی پکی چیز ( کھانے ) سے وضو کرو ۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":1,"hadith":179}}]}