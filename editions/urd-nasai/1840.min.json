{"metadata":{"name":"Sunan an Nasai","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"کتاب الجنائز"}}},"hadiths":[{"hadithnumber":1840,"arabicnumber":1840,"text":"عبداللہ بن عباس اور عائشہ رضی الله عنہم سے روایت ہے کہ ابوبکر رضی اللہ عنہ نے نبی اکرم صلی اللہ علیہ وسلم کا بوسہ لیا، اور آپ انتقال فرما چکے تھے۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":21,"hadith":23}}]}