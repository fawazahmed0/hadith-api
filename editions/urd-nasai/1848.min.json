{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"کتاب الجنائز"}}},"hadiths":[{"hadithnumber":1848,"arabicnumber":1848,"text":"عمر رضی الله عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: میت کو اس کے گھر والوں کے رونے کی وجہ سے عذاب دیا جاتا ہے ۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":21,"hadith":31}}]}