{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"کتاب الجنائز"}}},"hadiths":[{"hadithnumber":1849,"arabicnumber":1849,"text":"محمد بن سیرین کہتے ہیں کہ عمران بن حصین رضی اللہ عنہما کے پاس ذکر کیا گیا کہ میت کو زندوں کے رونے کی وجہ سے عذاب دیا جاتا ہے، تو انہوں نے کہا: اسے رسول اللہ صلی اللہ علیہ وسلم نے فرمایا ہے۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":21,"hadith":32}}]}