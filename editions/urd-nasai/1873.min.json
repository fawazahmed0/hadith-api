{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"کتاب الجنائز"}}},"hadiths":[{"hadithnumber":1873,"arabicnumber":1873,"text":"انس رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس مسلمان کے بھی تین نابالغ بچے مر جائیں، تو اللہ تعالیٰ اسے ان پر اپنی رحمت کے فضل سے جنت میں داخل کرے گا ۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":21,"hadith":56}}]}