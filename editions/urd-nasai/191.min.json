{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":191,"arabicnumber":191,"text":"ابوہریرہ رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جب مرد، اس ( عورت ) کے چاروں شاخوں کے درمیان بیٹھے، پھر کوشش کرے تو غسل واجب ہو جاتا ہے ۱؎۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":1,"hadith":192}}]}