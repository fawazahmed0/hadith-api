{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"کتاب الجنائز"}}},"hadiths":[{"hadithnumber":1913,"arabicnumber":1913,"text":"ابوبکرہ رضی الله عنہ کہتے ہیں کہ میں نے ( صحابہ کرام ) کو رسول اللہ صلی اللہ علیہ وسلم کے ساتھ اپنے آپ کو دیکھا ہم جنازے کے ساتھ تقریباً دوڑتے ہوئے چلتے۔ یہ الفاظ ہشیم کی روایت کے ہیں۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":21,"hadith":96}}]}