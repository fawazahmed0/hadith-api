{"metadata":{"name":"Sunan an Nasai","section":{"21":"The Book of Funerals"},"section_detail":{"21":{"hadithnumber_first":1818,"hadithnumber_last":2089,"arabicnumber_first":1818,"arabicnumber_last":2089,"name_native":"کتاب الجنائز"}}},"hadiths":[{"hadithnumber":2061,"arabicnumber":2061,"text":"ابوہریرہ رضی الله عنہ کہتے ہیں کہ میں نے رسول اللہ صلی اللہ علیہ وسلم کو اس کے بعد عذاب قبر سے پناہ مانگتے سنا۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":21,"hadith":244}}]}