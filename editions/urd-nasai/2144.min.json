{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"کتاب الصوم (روزہ)"}}},"hadiths":[{"hadithnumber":2144,"arabicnumber":2144,"text":"عبداللہ بن مسعود رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”سحری کھاؤ، کیونکہ سحری میں برکت ہے“۔ عبیداللہ بن سعید نے اسے موقوفاً روایت کیا ہے۔","grades":[{"name":"Abu Ghuddah","grade":"Hasan Sahih"},{"name":"Al-Albani","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":22,"hadith":55}}]}