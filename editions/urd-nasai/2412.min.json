{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"22":"The Book of Fasting"},"section_detail":{"22":{"hadithnumber_first":2090,"hadithnumber_last":2434,"arabicnumber_first":2090,"arabicnumber_last":2434,"name_native":"کتاب الصوم (روزہ)"}}},"hadiths":[{"hadithnumber":2412,"arabicnumber":2412,"text":"اس سند سے سعید بن ابی ہند نے روایت کی ہے کہ عثمان بن ابی العاص رضی اللہ عنہ نے اسی طرح کہا ہے، اور یہ مرسل ہے۔","grades":[{"name":"Al-Albani","grade":"Daif"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":22,"hadith":323}}]}