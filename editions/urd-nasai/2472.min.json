{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"23":"The Book of Zakah"},"section_detail":{"23":{"hadithnumber_first":2435,"hadithnumber_last":2618,"arabicnumber_first":2435,"arabicnumber_last":2618,"name_native":"زکوٰۃ کی کتاب"}}},"hadiths":[{"hadithnumber":2472,"arabicnumber":2472,"text":"ابوہریرہ رضی الله عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: ”مسلمان پر اس کے غلام میں زکاۃ نہیں ہے اور نہ ہی اس کے گھوڑے میں“۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":23,"hadith":38}}]}