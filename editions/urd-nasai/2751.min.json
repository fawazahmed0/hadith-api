{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"حج کی کتاب"}}},"hadiths":[{"hadithnumber":2751,"arabicnumber":2751,"text":"عبداللہ بن مسعود رضی الله عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم کا تلبیہ یوں تھا: «لبيك اللہم لبيك لبيك لا شريك لك لبيك إن الحمد والنعمة لك» ۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih Lighairihi"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":24,"hadith":133}}]}