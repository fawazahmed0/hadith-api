{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":276,"arabicnumber":276,"text":"ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ رسول اللہ صلی اللہ علیہ وسلم اعتکاف کی حالت میں اپنا سر مسجد سے میری طرف نکالتے، تو میں اسے دھوتی تھی اور میں حائضہ ہوتی تھی۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":1,"hadith":277}}]}