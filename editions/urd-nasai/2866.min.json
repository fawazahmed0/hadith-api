{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"حج کی کتاب"}}},"hadiths":[{"hadithnumber":2866,"arabicnumber":2866,"text":"جابر رضی الله عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم مکہ میں ( یعنی فتح مکہ کے دن ) سفید جھنڈا لیے ہوئے داخل ہوئے۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":24,"hadith":249}}]}