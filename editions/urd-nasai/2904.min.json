{"metadata":{"name":"Sunan an Nasai","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"حج کی کتاب"}}},"hadiths":[{"hadithnumber":2904,"arabicnumber":2904,"text":"ابوہریرہ رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: خانہ کعبہ کو دو چھوٹی پنڈلیوں والے حبشی ویران کریں گے ۱؎۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":24,"hadith":287}}]}