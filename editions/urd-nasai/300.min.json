{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":300,"arabicnumber":300,"text":"ام المؤمنین عائشہ رضی اللہ عنہا کہتی ہیں کہ میں نے اپنے آپ کو دیکھا کہ میں رسول اللہ صلی اللہ علیہ وسلم کے کپڑے سے جنابت ( منی کے اثر کو ) مل رہی ہوں۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":1,"hadith":301}}]}