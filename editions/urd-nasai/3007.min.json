{"metadata":{"name":"Sunan an Nasai","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"حج کی کتاب"}}},"hadiths":[{"hadithnumber":3007,"arabicnumber":3007,"text":"نبیط رضی الله عنہ کہتے ہیں کہ میں نے عرفہ کے دن رسول اللہ صلی اللہ علیہ وسلم کو نماز سے پہلے ایک سرخ اونٹ پر سوار ہو کر خطبہ دیتے دیکھا۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":24,"hadith":390}}]}