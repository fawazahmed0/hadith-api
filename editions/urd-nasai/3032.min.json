{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"24":"The Book of Hajj"},"section_detail":{"24":{"hadithnumber_first":2619,"hadithnumber_last":3084,"arabicnumber_first":2619,"arabicnumber_last":3084,"name_native":"حج کی کتاب"}}},"hadiths":[{"hadithnumber":3032,"arabicnumber":3032,"text":"عبداللہ بن عباس رضی الله عنہما کہتے ہیں کہ میں ان لوگوں میں سے ہوں جن کو نبی اکرم صلی اللہ علیہ وسلم نے مزدلفہ کی رات مجھے اپنے گھر والوں کے کمزور لوگوں ساتھ پہلے ہی ( منیٰ ) بھیج دیا تھا۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":24,"hadith":415}}]}