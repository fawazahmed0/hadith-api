{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"25":"The Book of Jihad"},"section_detail":{"25":{"hadithnumber_first":3085,"hadithnumber_last":3195,"arabicnumber_first":3085,"arabicnumber_last":3195,"name_native":"کتاب الجہاد"}}},"hadiths":[{"hadithnumber":3192,"arabicnumber":3192,"text":"انس رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”جہاد کرو اپنے ہاتھوں سے، اپنی زبانوں سے، اور اپنے مالوں کے ذریعہ“ ۱؎۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":25,"hadith":108}}]}