{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"26":"The Book of Marriage"},"section_detail":{"26":{"hadithnumber_first":3196,"hadithnumber_last":3388,"arabicnumber_first":3196,"arabicnumber_last":3388,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":3289,"arabicnumber":3289,"text":"ابوہریرہ رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے منع فرمایا کہ ( کسی کی زوجیت میں ) عورت اور اس کی پھوپھی کو، عورت اور اس کی خالہ کو اکٹھا کیا جائے ۱؎۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":26,"hadith":94}}]}