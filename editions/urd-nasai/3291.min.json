{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"26":"The Book of Marriage"},"section_detail":{"26":{"hadithnumber_first":3196,"hadithnumber_last":3388,"arabicnumber_first":3196,"arabicnumber_last":3388,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":3291,"arabicnumber":3291,"text":"ابوہریرہ رضی الله عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے چار عورتوں کو نکاح میں جمع کرنے سے منع فرمایا ہے، عورت اور اس کی پھوپھی کو، عورت اور اس کی خالہ کو ۱؎۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":26,"hadith":96}}]}