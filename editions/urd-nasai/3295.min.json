{"metadata":{"name":"Sunan an Nasai","section":{"26":"The Book of Marriage"},"section_detail":{"26":{"hadithnumber_first":3196,"hadithnumber_last":3388,"arabicnumber_first":3196,"arabicnumber_last":3388,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":3295,"arabicnumber":3295,"text":"ابوہریرہ رضی الله عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: ”کسی عورت سے اس کی پھوپھی کی موجودگی میں اور اسی طرح اس کی خالہ کی موجودگی میں شادی نہ کی جائے“۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":26,"hadith":100}}]}