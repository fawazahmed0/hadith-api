{"metadata":{"name":"Sunan an Nasai","section":{"26":"The Book of Marriage"},"section_detail":{"26":{"hadithnumber_first":3196,"hadithnumber_last":3388,"arabicnumber_first":3196,"arabicnumber_last":3388,"name_native":"کتاب النکاح"}}},"hadiths":[{"hadithnumber":3299,"arabicnumber":3299,"text":"جابر رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے منع فرمایا کہ کسی عورت سے اس کی پھوپھی یا اس کی خالہ کی موجودگی میں شادی کی جائے۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":26,"hadith":104}}]}