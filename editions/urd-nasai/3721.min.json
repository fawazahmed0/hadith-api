{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"34":"The Book of 'Umra"},"section_detail":{"34":{"hadithnumber_first":3720,"hadithnumber_last":3760,"arabicnumber_first":3720,"arabicnumber_last":3760,"name_native":"عمرہ کی کتاب"}}},"hadiths":[{"hadithnumber":3721,"arabicnumber":3721,"text":"زید بن ثابت رضی الله عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ وارث کا حق ہے“۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih Isnaad"},{"name":"Al-Albani","grade":"Sahih Isnaad"},{"name":"Zubair Ali Zai","grade":"Hasan"}],"reference":{"book":34,"hadith":2}}]}