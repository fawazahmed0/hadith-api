{"metadata":{"name":"Sunan an Nasai","section":{"35":"The Book of Agriculture"},"section_detail":{"35":{"hadithnumber_first":3761,"hadithnumber_last":3856,"arabicnumber_first":3761,"arabicnumber_last":3856,"name_native":"زراعت کی کتاب"}}},"hadiths":[{"hadithnumber":3855,"arabicnumber":3855,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جو شخص کسی بات کی قسم کھائے، پھر وہ ان شاءاللہ کہے تو اس نے استثناء کر لیا ۱؎۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":35,"hadith":95}}]}