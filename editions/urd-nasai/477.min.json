{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"5":"The Book of Salah"},"section_detail":{"5":{"hadithnumber_first":448,"hadithnumber_last":493,"arabicnumber_first":448,"arabicnumber_last":493,"name_native":"صلاۃ کی کتاب"}}},"hadiths":[{"hadithnumber":477,"arabicnumber":477,"text":"انس بن مالک رضی اللہ عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے مدینہ میں ظہر کی نماز چار رکعت، اور ذوالحلیفہ میں نماز عصر دو رکعت پڑھی۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":5,"hadith":30}}]}