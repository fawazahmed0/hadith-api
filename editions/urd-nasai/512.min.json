{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"6":"The Book of the Times (of Prayer)"},"section_detail":{"6":{"hadithnumber_first":494,"hadithnumber_last":625,"arabicnumber_first":494,"arabicnumber_last":625,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":512,"arabicnumber":512,"text":"عبداللہ بن عمر رضی اللہ عنہم کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس شخص کی عصر فوت گئی گویا اس کا گھربار لٹ گیا ۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":6,"hadith":19}}]}