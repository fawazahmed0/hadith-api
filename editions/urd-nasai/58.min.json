{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"1":"The Book of Purification"},"section_detail":{"1":{"hadithnumber_first":1,"hadithnumber_last":324,"arabicnumber_first":1,"arabicnumber_last":324,"name_native":"کتاب الطہارت"}}},"hadiths":[{"hadithnumber":58,"arabicnumber":58,"text":"ابوہریرہ رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: تم میں سے کوئی شخص ہرگز ٹھہرے ہوئے پانی میں پیشاب نہ کرے، پھر اسی سے غسل کرے ۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":1,"hadith":58}}]}