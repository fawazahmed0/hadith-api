{"metadata":{"name":"Sunan an Nasai","name_native":"سنن نسائی","section":{"8":"The Book of the Masjids"},"section_detail":{"8":{"hadithnumber_first":688,"hadithnumber_last":741,"arabicnumber_first":688,"arabicnumber_last":741,"name_native":"مسجدوں کی کتاب"}}},"hadiths":[{"hadithnumber":723,"arabicnumber":723,"text":"انس رضی اللہ عنہ کہتے ہیں کہ رسول اکرم صلی اللہ علیہ وسلم نے فرمایا: مسجد میں تھوکنا گناہ ہے، اور اس کا کفارہ اسے مٹی ڈال کر دبا دینا ہے ۱؎۔","grades":[{"name":"Abu Ghuddah","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":8,"hadith":36}}]}