{"metadata":{"name":"Jami At Tirmidhi","name_native":"جامع ترمذی","section":{"2":"The Book on Salat (Prayer)"},"section_detail":{"2":{"hadithnumber_first":149,"hadithnumber_last":451,"arabicnumber_first":149,"arabicnumber_last":451,"name_native":"کتاب الصلاۃ (نماز)"}}},"hadiths":[{"hadithnumber":181,"arabicnumber":181,"text":"عبداللہ بن مسعود رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی الله علیہ وسلم نے فرمایا: ” «صلاة وسطیٰ» عصر کی صلاۃ ہے“ ۱؎۔ امام ترمذی کہتے ہیں: یہ حدیث حسن صحیح ہے۔","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":2,"hadith":33}}]}