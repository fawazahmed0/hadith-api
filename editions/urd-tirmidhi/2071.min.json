{"metadata":{"name":"Jami At Tirmidhi","section":{"28":"Chapters on Medicine"},"section_detail":{"28":{"hadithnumber_first":2036,"hadithnumber_last":2089,"arabicnumber_first":2036,"arabicnumber_last":2089,"name_native":"کتاب الطب"}}},"hadiths":[{"hadithnumber":2071,"arabicnumber":2071,"text":"ابومسعود انصاری رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے کتے کی قیمت، زانیہ عورت کی کمائی اور کاہن کے نذرانے لینے سے منع فرمایا ۱؎۔ امام ترمذی کہتے ہیں: یہ حدیث حسن صحیح ہے۔","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih - Agreed Upon"}],"reference":{"book":28,"hadith":36}}]}