{"metadata":{"name":"Jami At Tirmidhi","section":{"36":"Chapters On Zuhd"},"section_detail":{"36":{"hadithnumber_first":2304,"hadithnumber_last":2414,"arabicnumber_first":2304,"arabicnumber_last":2414,"name_native":"ابواب زہد"}}},"hadiths":[{"hadithnumber":2304,"arabicnumber":2304,"text":"عبداللہ بن عباس رضی الله عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے ارشاد فرمایا: ”دو نعمتیں ایسی ہیں جن میں اکثر لوگ اپنا نقصان کرتے ہیں“ ۔ ایک تندرستی اور دوسری فراغت","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":36,"hadith":1}}]}