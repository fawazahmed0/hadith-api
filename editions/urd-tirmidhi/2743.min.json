{"metadata":{"name":"Jami At Tirmidhi","section":{"43":"Chapters on Manners"},"section_detail":{"43":{"hadithnumber_first":2736,"hadithnumber_last":2858,"arabicnumber_first":2736,"arabicnumber_last":2858,"name_native":"کتاب الادب"}}},"hadiths":[{"hadithnumber":2743,"arabicnumber":2743,"text":"سلمہ رضی الله عنہ کہتے ہیں کہ میری موجودگی میں رسول اللہ صلی اللہ علیہ وسلم کے پاس ایک شخص کو چھینک آئی تو آپ صلی اللہ علیہ وسلم نے فرمایا: «يرحمك الله» ( اللہ تم پر رحم فرمائے ) پھر اسے دوبارہ چھینک آئی تو آپ نے فرمایا: ”اسے تو زکام ہو گیا ہے“ ۱؎۔ امام ترمذی کہتے ہیں: یہ حدیث حسن صحیح ہے۔","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":43,"hadith":10}},{"hadithnumber":2743.2,"arabicnumber":2743.2,"text":"","grades":[],"reference":{"book":43,"hadith":11}},{"hadithnumber":2743.3,"arabicnumber":2743.3,"text":"","grades":[],"reference":{"book":43,"hadith":12}},{"hadithnumber":2743.4,"arabicnumber":2743.4,"text":"","grades":[],"reference":{"book":43,"hadith":13}}]}