{"metadata":{"name":"Jami At Tirmidhi","name_native":"جامع ترمذی","section":{"48":"Chapters on Supplication"},"section_detail":{"48":{"hadithnumber_first":3370,"hadithnumber_last":3604.1,"arabicnumber_first":3370,"arabicnumber_last":3604.1,"name_native":"دعا کے ابواب"}}},"hadiths":[{"hadithnumber":3472,"arabicnumber":3472,"text":"زہری کہتے ہیں کہ رمضان میں ایک بار سبحان اللہ کہنا غیر رمضان میں ہزار بار سبحان اللہ کہنے سے زیادہ بہتر ہے۔","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Daif Isnaad Maqtu"},{"name":"Al-Albani","grade":"Daif Isnaad Maqtu"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":48,"hadith":103}}]}