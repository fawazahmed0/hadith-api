{"metadata":{"name":"Jami At Tirmidhi","name_native":"جامع ترمذی","section":{"49":"Chapters on Virtues"},"section_detail":{"49":{"hadithnumber_first":3605,"hadithnumber_last":3956,"arabicnumber_first":3605,"arabicnumber_last":3956,"name_native":"فضائل کے باب"}}},"hadiths":[{"hadithnumber":3646,"arabicnumber":3646,"text":"جابر بن سمرہ رضی الله عنہ کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم کا منہ مبارک کشادہ تھا، آپ کی آنکھ کے ڈورے سرخ تھے اور ایڑیاں کم گوشت والی تھیں۔ امام ترمذی کہتے ہیں: یہ حدیث حسن صحیح ہے۔","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Muslim"}],"reference":{"book":49,"hadith":42}}]}