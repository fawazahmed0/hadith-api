{"metadata":{"name":"Jami At Tirmidhi","name_native":"جامع ترمذی","section":{"49":"Chapters on Virtues"},"section_detail":{"49":{"hadithnumber_first":3605,"hadithnumber_last":3956,"arabicnumber_first":3605,"arabicnumber_last":3956,"name_native":"فضائل کے باب"}}},"hadiths":[{"hadithnumber":3768,"arabicnumber":3768,"text":"ابو سعید خدری رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”حسن اور حسین اہل جنت کے جوانوں کے سردار ہیں“ ۱؎۔","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":49,"hadith":167}}]}