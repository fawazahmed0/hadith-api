{"metadata":{"name":"Jami At Tirmidhi","name_native":"جامع ترمذی","section":{"9":"The Book on Hajj"},"section_detail":{"9":{"hadithnumber_first":809,"hadithnumber_last":964,"arabicnumber_first":809,"arabicnumber_last":964,"name_native":"حج پر کتاب"}}},"hadiths":[{"hadithnumber":942,"arabicnumber":942,"text":"عبداللہ بن عمر رضی الله عنہما سے روایت ہے کہ وہ حج میں شرط لگانے سے انکار کرتے تھے اور کہتے تھے: کیا تمہارے لیے تمہارے نبی اکرم صلی اللہ علیہ وسلم کا طریقہ کافی نہیں ہے ۱؎۔ امام ترمذی کہتے ہیں: یہ حدیث حسن صحیح ہے۔","grades":[{"name":"Ahmad Muhammad Shakir","grade":"Sahih"},{"name":"Al-Albani","grade":"Sahih"},{"name":"Bashar Awad Maarouf","grade":"Hasan Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":9,"hadith":135}}]}