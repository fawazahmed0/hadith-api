{
    "1": "வஹீ (இறைச்செய்தி) அதிகாரம்",
    "2": "ஈமான் (நம்பிக்கை) அதிகாரம்",
    "3": "கல்வி (இல்ம்) அதிகாரம்",
    "14": "தொழுகை (ஸலாத்) அதிகாரம்",
    "15": "மழைக்காக அல்லாஹ்வை அழைப்பது (இஸ்திஸ்கா)",
    "16": "கிரகணங்கள்",
    "17": "குர்ஆன் ஓதும்போது ஸஜ்தா",
    "18": "தொழுகை (ஸலாத்) அதிகாரம்",
    "19": "தொழுகை (ஸலாத்) அதிகாரம்",
    "20": "தொழுகை (ஸலாத்) அதிகாரம்",
    "21": "பிரார்த்தனை செய்யும் போது செயல்கள்",
    "22": "தொழுகை (ஸலாத்) அதிகாரம்",
    "23": "ஜனாஸா (இறுதிச் சடங்கு) அதிகாரம்",
    "4": "உளூ அதிகாரம்",
    "24": "ஜகாத் அதிகாரம்",
    "25": "ஹஜ் அதிகாரம்",
    "26": "ஹஜ் அதிகாரம்",
    "27": "ஹஜ் அதிகாரம்",
    "28": "ஹஜ் அதிகாரம்",
    "29": "மதீனாவின் நற்குணங்கள்",
    "30": "நோன்பு (ஸியாம்) அதிகாரம்",
    "31": "ரமலானில் (தராவீஹ்) இரவில் தொழுகை",
    "32": "கத்ர் இரவின் சிறப்புகள்",
    "33": "அல்லாஹ்வின் நினைவிற்காக ஒரு மசூதிக்கு ஓய்வு பெறுதல் (இஃதிகாஃப்)",
    "34": "விற்பனை மற்றும் வர்த்தகம்",
    "35": "பின்னர் டெலிவரி செய்யப்படும் பொருட்களுக்கு விலை கொடுக்கப்படும் விற்பனை (அஸ்-சலாம்)",
    "36": "ஷுஃபா",
    "37": "பணியமர்த்தல்",
    "38": "ஒருவரிடமிருந்து இன்னொருவருக்கு கடனை மாற்றுதல் (அல்-ஹவாலா)",
    "39": "கஃபாலா",
    "40": "ப்ராக்ஸி மூலம் பிரதிநிதித்துவம், அங்கீகாரம், வணிகம்",
    "41": "விவசாயம்",
    "42": "நீர் விநியோகம்",
    "43": "கடன்கள், கடன்கள் செலுத்துதல், சொத்து முடக்கம், திவால்",
    "44": "குசூமாத்",
    "45": "யாரோ ஒருவர் எடுத்த தொலைந்த விஷயங்கள் (லுகாதா)",
    "46": "அடக்குமுறைகள்",
    "5": "குஸ்ல் (குளிப்பு) அதிகாரம்",
    "47": "கூட்டு",
    "48": "அடமானம் வைத்தல்",
    "49": "அடிமைகளின் மனுமிஷன்",
    "50": "மகாதீப்",
    "51": "பரிசுகள்",
    "52": "சாட்சிகள்",
    "53": "சமாதானம்",
    "54": "நிபந்தனைகள்",
    "55": "மரண சாசனம் (வஸாயா) அதிகாரம்",
    "56": "அல்லாஹ்வுக்காகப் போராடுவது (ஜிஹாத்)",
    "6": "மாதவிடாய் (ஹைள்) அதிகாரம்",
    "57": "செல்வத்தில் ஐந்தில் ஒரு பங்கு அல்லாஹ்வுக்காக (குமுஸ்)",
    "58": "ஜிஸ்யா மற்றும் மவாதா",
    "59": "படைப்பின் ஆரம்பம்",
    "60": "தீர்க்கதரிசிகள்",
    "7": "தயம்மும் அதிகாரம்",
    "61": "நபிகள் நாயகம் (ஸல்) அவர்களின் தோழர்களின் நற்பண்புகள் மற்றும் சிறப்புகள்",
    "8": "தொழுகை (ஸலாத்) அதிகாரம்",
    "62": "நபித் தோழர்கள்",
    "63": "மதீனாவில் உதவி செய்பவர்களின் சிறப்புகள் (அன்சார்)",
    "64": "நபிகள் நாயகம் (ஸல்) அவர்கள் (அல்-மகாஜி) தலைமையிலான இராணுவப் பயணங்கள்",
    "65": "குர்ஆன் பற்றிய நபிமொழி விளக்கம் (நபி (ஸல்) அவர்களின் தஃப்ஸீர்)",
    "66": "குர்ஆனின் சிறப்புகள்",
    "67": "நிக்காஹ் (திருமணம்) அதிகாரம்",
    "9": "தொழுகை (ஸலாத்) அதிகாரம்",
    "68": "தலாக் (விவாகரத்து) அதிகாரம்",
    "69": "குடும்பத்தை ஆதரித்தல்",
    "70": "உணவு, உணவு",
    "71": "உள்ஹிய்யா (குர்பானி) அதிகாரம்",
    "72": "வேட்டை அதிகாரம்",
    "73": "உள்ஹிய்யா (குர்பானி) அதிகாரம்",
    "74": "பானங்கள் அதிகாரம்",
    "75": "நோயாளிகள்",
    "76": "மருத்துவம் அதிகாரம்",
    "77": "ஆடை அதிகாரம்",
    "78": "நற்பண்புகள் (அகிலாக்) அதிகாரம்",
    "10": "தொழுகை (ஸலாத்) அதிகாரம்",
    "79": "அனுமதி கேட்பது",
    "80": "அழைப்புகள்",
    "81": "இதயத்தை மென்மையாக்க (அர்-ரிகாக்)",
    "82": "தெய்வீக விருப்பம் (அல்-கதர்)",
    "83": "சத்தியங்களும் நேர்ச்சைகளும் அதிகாரம்",
    "84": "சத்தியங்களும் நேர்ச்சைகளும் அதிகாரம்",
    "85": "வாரிசுரிமை (ஃபராயிள்) அதிகாரம்",
    "86": "ஹுதூத் (குற்றவியல் தண்டனைகள்) அதிகாரம்",
    "87": "தியத் (இழப்பீடு) அதிகாரம்",
    "88": "விசுவாச துரோகிகள்",
    "89": "(கீழ் செய்யப்பட்ட அறிக்கைகள்) வற்புறுத்தல்",
    "90": "தந்திரங்கள்",
    "91": "கனவுகளின் விளக்கம்",
    "92": "துன்பங்கள் மற்றும் உலகின் முடிவு",
    "93": "தீர்ப்புகள் (அஹ்காம்)",
    "94": "வாழ்த்துகள்",
    "95": "ஒரு உண்மையுள்ள நபர் கொடுத்த தகவலை ஏற்றுக்கொள்வது",
    "96": "சுன்னாஹ் அதிகாரம்",
    "97": "ஒருமை, அல்லாஹ்வின் தனித்துவம் (தவ்ஹீத்)",
    "11": "தொழுகை (ஸலாத்) அதிகாரம்",
    "12": "தொழுகை (ஸலாத்) அதிகாரம்",
    "13": "இரண்டு பண்டிகைகள் (ஈத்ஸ்)"
}